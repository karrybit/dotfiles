#!/bin/bash
set -euo pipefail

profile="$(chezmoi execute-template '{{ .profile }}')"
claude_config_dir="${CLAUDE_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/claude}"
base_pkl="$claude_config_dir/settings.base.pkl"
profile_pkl="$claude_config_dir/settings.${profile}.pkl"
settings_json="$claude_config_dir/settings.json"

mkdir -p "$claude_config_dir"

if [ ! -f "$base_pkl" ]; then
  echo "missing Claude Code base settings: $base_pkl" >&2
  exit 1
fi

source_pkl="$base_pkl"
if [ -f "$profile_pkl" ]; then
  source_pkl="$profile_pkl"
fi

tmp_dir="$(mktemp -d)"
trap 'rm -rf "$tmp_dir"' EXIT

tmp_json="$tmp_dir/settings.json"

pkl eval -f json -p claudeConfigDir="$claude_config_dir" "$source_pkl" > "$tmp_json"
mv "$tmp_json" "$settings_json"

# herdr owns its SessionStart entry and matches it by exact command string, so
# it is the authority on what that string is. Installing over the generated
# file is a no-op while the declaration in the pkl sources still matches; when
# it stops matching, herdr rewrites the entry and the declaration needs the
# same update. `herdr integration status` reports the hook script's version
# only, so it cannot stand in for this check.
if command -v herdr >/dev/null 2>&1; then
  hook_commands='[.hooks.SessionStart[]?.hooks[]?.command | select(test("herdr-agent-state"))]'
  declared="$(jq -c "$hook_commands" "$settings_json")"
  herdr integration install claude >/dev/null 2>&1 || true
  added="$(jq -r --argjson declared "$declared" "$hook_commands - \$declared | .[]" "$settings_json")"

  if [ -n "$added" ]; then
    echo "herdr rewrote its SessionStart hook entry; update settings.base.pkl to:" >&2
    printf '%s\n' "$added" >&2
  fi
fi
