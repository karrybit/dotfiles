#!/bin/bash
# Prints a random id of lowercase letters and digits: the length given with
# -n, or 8 characters when -n is absent or not a positive integer.
# LC_ALL=C keeps macOS tr from failing on bytes that are not valid UTF-8.
# No pipefail: tr exits on SIGPIPE once head has its bytes.

usage() {
  echo "usage: shortid [-n length]" >&2
  exit 1
}

length=8
while getopts :n: opt; do
  case $opt in
    n) length=$OPTARG ;;
    *) usage ;;
  esac
done
shift $((OPTIND - 1))
[ $# -eq 0 ] || usage
case $length in
  '' | *[!0-9]*) length=8 ;;
esac
[ "$length" -gt 0 ] || length=8

LC_ALL=C tr -dc 'a-z0-9' </dev/urandom | head -c "$length"
echo
