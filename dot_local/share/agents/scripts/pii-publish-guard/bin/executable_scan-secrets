#!/bin/bash
# Prints the lines of standard input that carry a high-confidence secret
# pattern, as "<line number>:<line>" for a fixed-prefix token and
# "<line number>:<match>" for a keyword assignment. Prints nothing when no
# line matches. Line numbers count the lines left after skipping the ones
# marked with gitleaks' `gitleaks:allow` or detect-secrets'
# `pragma: allowlist secret`, so a suppression written for either
# established scanner also silences this one.
# check-publish-surface feeds it the added lines of outgoing commits; any
# other text, such as a PR body or a message, can be piped in the same way.
set -u

# These prefixes are fixed-case by definition, so they are matched
# case-sensitively. Under -i, "AKIA[0-9A-Z]{16}" and "AIza[0-9A-Za-z_-]{35}"
# hit any base64 blob that happens to contain "akia" or "aiza" followed by
# alphanumerics. Lock file integrity hashes trip that on almost every update,
# and a guard that cries wolf gets waved through.
cased='AKIA[0-9A-Z]{16}'
cased="$cased|BEGIN (RSA |OPENSSH |EC |DSA )?PRIVATE KEY"
cased="$cased|ghp_[A-Za-z0-9]{36}|github_pat_[A-Za-z0-9_]{22,}"
cased="$cased|xox[baprs]-[A-Za-z0-9-]{10,}"
cased="$cased|sk-ant-[A-Za-z0-9_-]{20,}|AIza[0-9A-Za-z_-]{35}"

# Only the keyword-assignment shape has to ignore case: the key name is
# whatever the author typed.
loose="(api[_-]?key|secret|token|password)['\"]?[[:space:]]*[:=][[:space:]]*['\"][^'\"]{8,}"
# A double-quoted value that is exactly one shell expansion, such as
# "${token}", "$GH_TOKEN", or "$(gh auth token)", names a secret without
# containing one. Single quotes do not expand, so they stay flagged. The bare
# "$NAME" form is exempt only for upper-case names: in a non-shell file,
# "$x9Kq..." is a literal that merely starts with `$`.
expansion='[:=][[:space:]]*"(\$\{[A-Za-z_][A-Za-z0-9_]*\}|\$[A-Z_][A-Z0-9_]*|\$\([^)]*\))$'

kept=$(grep -vE 'gitleaks:allow|pragma: allowlist secret')
printf '%s\n' "$kept" | grep -nE "$cased"
printf '%s\n' "$kept" | grep -noiE "$loose" | grep -vE "$expansion"
exit 0
