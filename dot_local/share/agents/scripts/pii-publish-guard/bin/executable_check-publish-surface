#!/bin/bash
# Claude Code PreToolUse hook (matcher: Bash).
# Blocks publish commands (git push, gh pr create, gh release create) when
# outgoing commits contain high-confidence secret patterns. Broader PII
# judgment (home paths, org names, personal data) is an agent rule in
# CLAUDE.md, not this hook: those need context this scan cannot have.
# Escape hatch: PII_GUARD_SKIP=1 in the hook environment skips the check.
set -u

[ "${PII_GUARD_SKIP:-}" = "1" ] && exit 0
command -v jq >/dev/null 2>&1 || exit 0

input=$(cat)
cmd=$(printf '%s' "$input" | jq -r '.tool_input.command // empty' 2>/dev/null)
[ -n "$cmd" ] || exit 0

case "$cmd" in
*"git push"* | *"gh pr create"* | *"gh release create"*) ;;
*) exit 0 ;;
esac

cwd=$(printf '%s' "$input" | jq -r '.cwd // empty' 2>/dev/null)
[ -n "$cwd" ] && [ -d "$cwd" ] && cd "$cwd"
git rev-parse --is-inside-work-tree >/dev/null 2>&1 || exit 0

range="-1 HEAD"
if upstream=$(git rev-parse --abbrev-ref '@{upstream}' 2>/dev/null); then
    range="$upstream..HEAD"
fi

# These prefixes are fixed-case by definition, so they are matched
# case-sensitively. Under -i, "AKIA[0-9A-Z]{16}" and "AIza[0-9A-Za-z_-]{35}"
# hit any base64 blob that happens to contain "akia" or "aiza" followed by
# alphanumerics. Lock file integrity hashes trip that on almost every update,
# and a guard that cries wolf gets waved through.
cased='AKIA[0-9A-Z]{16}'
cased="$cased|BEGIN (RSA |OPENSSH |EC |DSA )?PRIVATE KEY"
cased="$cased|ghp_[A-Za-z0-9]{36}|github_pat_[A-Za-z0-9_]{22,}"
cased="$cased|xox[baprs]-[A-Za-z0-9-]{10,}"
cased="$cased|sk-ant-[A-Za-z0-9_-]{20,}|AIza[0-9A-Za-z_-]{35}"

# Only the keyword-assignment shape has to ignore case: the key name is
# whatever the author typed.
loose="(api[_-]?key|secret|token|password)['\"]?[[:space:]]*[:=][[:space:]]*['\"][^'\"]{8,}"

# shellcheck disable=SC2086
added=$(git log -p --no-color $range 2>/dev/null | grep -E "^\+")
findings=$(($(printf '%s\n' "$added" | grep -cE "$cased") +
    $(printf '%s\n' "$added" | grep -ciE "$loose")))

if [ "${findings:-0}" -gt 0 ]; then
    {
        echo "pii-publish-guard: $findings added line(s) in the outgoing range ($range) match secret patterns."
        {
            printf '%s\n' "$added" | grep -nE "$cased"
            printf '%s\n' "$added" | grep -inE "$loose"
        } | head -5
        echo "Inspect with: git log -p $range"
        echo "Redact or amend before publishing. If every match is a confirmed false positive, ask the user to approve publishing anyway."
    } >&2
    exit 2
fi
exit 0
