# Targets that must not exist. Removed on every `chezmoi apply`.
#
# Deleting a file from the chezmoi source does not remove its target, so a
# retired tool leaves its live files behind on every machine. List them here
# instead of cleaning each machine by hand.

# mise was replaced by aqua. Its shell hook would keep pointing
# MISE_CONFIG_FILE at a config that no longer exists.
.config/mise
.config/zsh/zshenv.d/20_tool_mise.zsh
.config/zsh/functions/__update_mise

# Nix package management was retired.
.config/zsh/functions/__update_nix

# yazi was replaced by the fb zsh function. Its plugins under
# .config/yazi/plugins were installed outside chezmoi.
.config/yazi

# Plannotator was retired. The work profile's local registry existed only
# for that package.
.config/zsh/zshenv.d/20_tool_plannotator.zsh
.config/aquaproj-aqua/work/registry.yaml
