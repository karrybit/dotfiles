.config/claude/skills/karrybit/evals/docs-information-design/trigger-evals.json
.config/claude/skills/karrybit/evals/docs-information-design/fixtures/02-over-split-docs
.config/claude/skills/karrybit/evals/docs-information-design/fixtures/03-mixed-responsibility
.config/claude/skills/karrybit/evals/docs-information-design/fixtures/06-architecture-compress
