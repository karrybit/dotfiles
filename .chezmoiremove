# Targets that must not exist. Removed on every `chezmoi apply`.
#
# Deleting a file from the chezmoi source does not remove its target, so a
# retired tool leaves its live files behind on every machine. List them here
# instead of cleaning each machine by hand.

# mise was replaced by aqua. Its shell hook would keep pointing
# MISE_CONFIG_FILE at a config that no longer exists.
.config/mise
.config/zsh/zshenv.d/20_tool_mise.zsh
.config/zsh/functions/__update_mise

# Nix package management was retired.
.config/zsh/functions/__update_nix

# yazi was replaced by the fb zsh function. Its plugins under
# .config/yazi/plugins were installed outside chezmoi.
.config/yazi

# Plannotator was retired.
.config/zsh/zshenv.d/20_tool_plannotator.zsh

# granted's assume picks an AWS profile and logs in to SSO.
.config/zsh/functions/aws-login

# The command that opens the karo workspace is karo.
.local/bin/cos

# The karo plugin's folders default to ~/karo and the XDG base directories,
# so no shell file exports KARO_*.
.config/zsh/zshenv.d/20_tool_karo.zsh

# The karo plugin is installed from the karrybit plugin marketplace.
.config/claude/skills/karo

# The kstack plugin from the karrybit plugin marketplace holds these skills
# and the eval-auditor subagent.
.config/claude/skills/karrybit
.config/claude/agents/eval-auditor.md

# The karo launcher is installed by the Homebrew formula karo-core.
.local/bin/karo
