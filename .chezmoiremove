# Targets that must not exist. Removed on every `chezmoi apply`.
#
# Deleting a file from the chezmoi source does not remove its target, so a
# retired tool leaves its live files behind on every machine. List them here
# instead of cleaning each machine by hand.

# mise was replaced by aqua. Its shell hook would keep pointing
# MISE_CONFIG_FILE at a config that no longer exists.
.config/mise
.config/zsh/zshenv.d/20_tool_mise.zsh
.config/zsh/functions/__update_mise

# Nix package management was retired.
.config/zsh/functions/__update_nix

# yazi was replaced by the fb zsh function. Its plugins under
# .config/yazi/plugins were installed outside chezmoi.
.config/yazi

# Plannotator was retired.
.config/zsh/zshenv.d/20_tool_plannotator.zsh

# karo keeps no PROVENANCE.md. Its plugin folder and skill folders are not
# exact_, so these files stay on a machine after leaving the source.
.config/claude/skills/karo/PROVENANCE.md
.config/claude/skills/karo/skills/checkin/PROVENANCE.md
.config/claude/skills/karo/skills/checkout/PROVENANCE.md
.config/claude/skills/karo/skills/delegate/PROVENANCE.md
.config/claude/skills/karo/skills/explain/PROVENANCE.md
.config/claude/skills/karo/skills/insights/PROVENANCE.md
.config/claude/skills/karo/skills/land/PROVENANCE.md
.config/claude/skills/karo/skills/review/PROVENANCE.md
.config/claude/skills/karo/skills/setup/PROVENANCE.md

# The karo plugin has no subagents. The source has no agents folder, so
# nothing makes chezmoi remove a deployed one otherwise.
.config/claude/skills/karo/agents

# The command that opens the karo workspace is karo.
.local/bin/cos

# The karo plugin's folders default to ~/karo and the XDG base directories,
# so no shell file exports KARO_*.
.config/zsh/zshenv.d/20_tool_karo.zsh

# The karo:record skill holds its steps in SKILL.md alone. Its skill folder is
# not exact_, so the removed examples.md stays on a machine otherwise.
.config/claude/skills/karo/skills/record/examples.md

# The crit eval's branch case has no port-from-target grader. The evals folder
# is not exact_, so the removed grader stays on a machine otherwise.
.config/claude/skills/karrybit/evals/crit/plugin-eval/branch/graders/port-from-target.md

# okf-lint is a script of the karo plugin with no eval suite: okf-lint-test
# checks the script. The evals folders are not exact_, so the removed suites
# stay on a machine otherwise.
.config/claude/skills/karrybit/evals/okf-lint
.config/claude/skills/karo/evals/okf-lint

# The docs-information-design suite tests the description with its
