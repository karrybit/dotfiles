#!/bin/bash
# run_onchange_: aquaproj-aqua/{profile}/ が変わった時だけ再実行される
# hash: {{ include (printf "dot_config/aquaproj-aqua/literal_%s/aqua.yaml" .profile) | sha256sum }}
# hash: {{ include (printf "dot_config/aquaproj-aqua/literal_%s/aqua-checksums.json" .profile) | sha256sum }}
set -e

# On a new Linux machine, aqua-installer's target is not on PATH yet.
PATH="${AQUA_ROOT_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/aquaproj-aqua}/bin:$PATH"

if ! command -v aqua >/dev/null 2>&1; then
  exit 0
fi

aqua -c "${XDG_CONFIG_HOME:-$HOME/.config}/aquaproj-aqua/{{ .profile }}/aqua.yaml" install
