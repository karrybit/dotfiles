tap "aquaproj/aqua", trusted: true
tap "microsoft/apm", trusted: true
tap "olets/tap", trusted: true
# Declarative CLI Version manager
brew "aqua"
# Manage your dotfiles across multiple diverse machines, securely
brew "chezmoi"
# Distributed revision control system
brew "git"
# GNU implementation of the famous stream editor
brew "gnu-sed"
# Display directories as trees (with optional color/HTML output)
brew "tree"
# Internet file retriever
brew "wget"
# Agent Package Manager (APM): The NPM for AI-Native Development
brew "microsoft/apm/apm"
# Auto-expanding abbreviations manager for zsh, inspired by fish
brew "olets/tap/zsh-abbr", trusted: true
# Password manager that keeps all passwords secure behind one password
cask "1password"
# Screen capturing tool
cask "cleanshot"
# Terminal emulator that uses platform-native UI and GPU acceleration
cask "ghostty"
# Web browser
cask "google-chrome"
# Japanese input software
cask "google-japanese-ime"
# Menu bar calendar
cask "itsycal"
# Keyboard customiser
cask "karabiner-elements"
# Knowledge base that works on top of a local folder of plain text Markdown files
cask "obsidian"
