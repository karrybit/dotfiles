// Claude Code settings shared by all local profiles.
// Keep company-specific providers, plugin marketplaces, and credentials in
// $XDG_CONFIG_HOME/claude/settings.work.pkl instead.

settings: Dynamic = new Dynamic {
  env {
    ["ANTHROPIC_MODEL"] = "claude-sonnet-5"
    ["ANTHROPIC_DEFAULT_OPUS_MODEL"] = "claude-opus-5"
    ["ANTHROPIC_DEFAULT_SONNET_MODEL"] = "claude-sonnet-5"
    ["ANTHROPIC_DEFAULT_HAIKU_MODEL"] = "claude-haiku-4-5"
    ["CLAUDE_CODE_SESSIONEND_HOOKS_TIMEOUT_MS"] = "60000"
    ["CLAUDE_CODE_ENABLE_AUTO_MODE"] = "1"
  }
  permissions {
    defaultMode = "default"
    allow {
      "Read(~/.local/share/go/*)"
      "Read(~/.cache/go/*)"
      "Read(~/work/*)"
      "Read(~/.config/claude/plans/**)"
      // Ported from the retired Codex default.rules. Deliberately absent:
      // git push (publishing stays a per-call decision), git commit and
      // git rebase (both can rewrite history).
      "Bash(chezmoi update *)"
      "Bash(chezmoi apply *)"
      "Bash(chezmoi add *)"
      "Bash(git add *)"
      "Bash(git fetch *)"
      "Bash(uv run *)"
    }
    deny {
      "Read(./.env)"
      "Read(./.env.*)"
      "Read(./secrets/**)"
      "Read(./config/credentials.json)"
      "Read(~/.ssh/**)"
      "Read(~/.aws/**)"
      "Read(~/.config/gcloud/**)"
      "Read(~/.kube/**)"
    }
    disableBypassPermissionsMode = "disable"
  }
  sandbox {
    enabled = true
    autoAllowBashIfSandboxed = false
    // gh/gcloud/terraform 等の Go 製 CLI が sandbox 内で trustd 経由の
    // TLS 証明書検証に失敗するため許可。セキュリティ的にはトレードオフ
    // (trustd 経由の潜在的なデータ持ち出し経路が開く)。
    enableWeakerNetworkIsolation = true
    excludedCommands {
      "docker *"
    }
    filesystem {
      // The chezmoi source repository, so editing source and running git inside
      // it do not each need the sandbox lifted. Deployment stays gated on
      // purpose: `chezmoi apply` writes targets across $HOME, which this does
      // not grant, and Claude Code's own config paths are protected separately.
      allowWrite {
        "~/.local/share/chezmoi"
        // Go toolchain caches/config (exported in zshenv.d/20_tool_go.zsh).
        // `go build` / `go mod download` / `go env -w` write here directly.
        "~/.cache/go/mod"
        "~/.cache/go-build"
        "~/.config/go/env"
      }
    }
    network {
      allowedDomains {
        "github.com"
        "api.github.com"
        "raw.githubusercontent.com"
        "objects.githubusercontent.com"
        "*.githubusercontent.com"
        "registry.npmjs.org"
        "*.npmjs.org"
        "registry.yarnpkg.com"
        "pypi.org"
        "files.pythonhosted.org"
        "crates.io"
        "static.crates.io"
        "index.crates.io"
      }
    }
  }
  plansDir = "~/.config/claude/plans"
  worktree {
    baseRef = "head"
  }
  statusLine {
    type = "command"
    command = "~/.config/claude/statusline.sh"
    refreshInterval = 5
  }
  enabledPlugins {
    ["usage-collector@awesome-claude-marketplace"] = true
    ["claude-md-management@claude-plugins-official"] = true
    ["code-review@claude-plugins-official"] = true
    ["commit-commands@claude-plugins-official"] = true
    ["frontend-design@claude-plugins-official"] = true
    ["mattpocock-skills@claude-plugins-official"] = true
    ["skill-creator@claude-plugins-official"] = true
    ["security-guidance@claude-plugins-official"] = true
    ["slack@claude-plugins-official"] = true
  }
  alwaysThinkingEnabled = true
  effortLevel = "xhigh"
  autoUpdatesChannel = "stable"
  hooks {
    ["PreToolUse"] = new Listing {
      new Dynamic {
        matcher = "Bash"
        hooks = new Listing {
          new Dynamic {
            type = "command"
            command = "\"$HOME\"/.local/share/agents/scripts/pii-publish-guard/bin/check-publish-surface"
          }
        }
      }
    }
    ["PostToolUse"] = new Listing {
      new Dynamic {
        // Bash is matched too because shell-driven edits (python, sed -i,
        // perl -pi) reach files without going through Edit or Write.
        matcher = "Edit|Write|MultiEdit|Bash"
        hooks = new Listing {
          new Dynamic {
            type = "command"
            command = "git rev-parse --git-dir >/dev/null 2>&1 || exit 0; git diff --check"
          }
        }
      }
      new Dynamic {
        matcher = "Bash"
        hooks = new Listing {
          new Dynamic {
            type = "command"
            command = "\"$HOME\"/.local/share/agents/scripts/env-deny-hint/bin/remind-env-deny"
          }
        }
      }
    }
    ["Stop"] = new Listing {
      new Dynamic {
        hooks = new Listing {
          new Dynamic {
            type = "command"
            command = #"osascript -e 'display notification "Claude Code finished" with title "Claude"' 2>/dev/null; afplay /System/Library/Sounds/Glass.aiff 2>/dev/null; true"#
          }
        }
      }
    }
    ["PreCompact"] = new Listing {
      new Dynamic {
        hooks = new Listing {
          new Dynamic {
            type = "command"
            command = "true"
          }
        }
      }
    }
  }
}

output {
  value = settings
  renderer = new JsonRenderer {}
}
