#!/usr/bin/env bash
# Show that crit-open hands terminal-browser only "open http://localhost:<port> --split right", with
# telemetry off, for a port made of digits and refuses any other argument, against a terminal-browser
# on PATH that logs what it is given. Given a Claude Code settings.json, also show that it allows
# crit-open and runs it outside the sandbox in the ~/ form the skill calls it by (rules match the
# command text, so an absolute-path rule misses that call), and has no rule or exclusion for
# terminal-browser or open itself.
# usage: crit-open-test [<settings.json>]   (tests the crit-open beside this script; its files go
#        to a temporary directory that is removed)
set -uo pipefail
exec </dev/null
bin=$(cd "$(dirname "$0")" && pwd)
co=$bin/crit-open
settings=${1:-}
tmp=$(mktemp -d "${TMPDIR:-/tmp}/crit-open-test.XXXXXX") || exit 2
trap 'rm -rf "$tmp"' EXIT
failed=0
fail() { printf 'FAIL\t%s\n' "$1"; failed=$((failed+1)); }
pass() { printf 'ok\t%s\n' "$1"; }

mkdir -p "$tmp/fake"
cat > "$tmp/fake/terminal-browser" <<'EOF'
#!/bin/sh
printf '%s DO_NOT_TRACK=%s TERMINAL_BROWSER_NO_TELEMETRY=%s\n' "$*" "${DO_NOT_TRACK:-}" "${TERMINAL_BROWSER_NO_TELEMETRY:-}" >> "$FAKE_LOG"
EOF
chmod +x "$tmp/fake/terminal-browser"

export FAKE_LOG=$tmp/log
run() {
  : > "$FAKE_LOG"
  out=$(env PATH="$tmp/fake:$PATH" "$co" "$@" 2>&1); code=$?
}

run 49809
if [[ $code -eq 0 && $(cat "$FAKE_LOG") == "open http://localhost:49809 --split right DO_NOT_TRACK=1 TERMINAL_BROWSER_NO_TELEMETRY=1" ]]; then
  pass "a port opens http://localhost:<port> in a right split with telemetry off"
else
  fail "a port: exit $code: $out: $(paste -sd '|' "$FAKE_LOG")"
fi

refused() {
  run "$@"
  if [[ $code -eq 2 && ! -s $FAKE_LOG ]]; then pass "\"crit-open $1\" is refused"; else fail "\"crit-open $1\": exit $code: $out: $(paste -sd '|' "$FAKE_LOG")"; fi
}
run
if [[ $code -eq 2 && ! -s $FAKE_LOG ]]; then pass "no argument is refused"; else fail "no argument: exit $code: $out"; fi
for arg in "" "4980a" "-a" "49809/x" "49809@example.com" "1 2" "49809;x" "\$x" "４９８０９"; do
  refused "$arg"
done
run 49809 ~/x.command
if [[ $code -eq 2 && ! -s $FAKE_LOG ]]; then pass "a second argument is refused"; else fail "a second argument: exit $code: $out"; fi

if [[ -n $settings ]]; then
  if ! jq -e . "$settings" >/dev/null; then fail "$settings is not valid JSON"; else
    if jq -e '.permissions.allow // [] | any(test("^Bash\\(~/.*/crit-open \\*\\)$"))' "$settings" >/dev/null; then
      pass "crit-open is allowed in the ~/ form"
    else
      fail "crit-open is not in permissions.allow in the ~/ form"
    fi
    if jq -e '.sandbox.excludedCommands // [] | any(test("^~/.*/crit-open \\*$"))' "$settings" >/dev/null; then
      pass "crit-open runs outside the sandbox, where terminal-browser starts, in the ~/ form"
    else
      fail "crit-open is not in sandbox.excludedCommands in the ~/ form"
    fi
    if jq -e '[(.permissions.allow // [])[], (.sandbox.excludedCommands // [])[]] | any(test("^(Bash\\()?(open|terminal-browser)( |\\)|$)"))' "$settings" >/dev/null; then
      fail "$settings allows or excludes terminal-browser or open itself"
    else
      pass "terminal-browser and open themselves are neither allowed nor excluded"
    fi
  fi
fi

if [[ $failed -gt 0 ]]; then echo "$failed failed"; exit 1; fi
echo "all passed"
