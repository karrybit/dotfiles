    fail "herdr-worktree foreground: exit $code: $out: $(cat "$FAKE_LOG")"
  fi
fi

pr_repo pr-ignored
if pr_start pr-ignored ac0205-test; then
  g -C "$wt" push -q origin feat/pr-ignored
  printf 'secret\n' > "$wt/.env.local"
  mkdir "$wt/cache.local" "$wt/sub" "$wt/メモ" && touch "$wt/cache.local/a" "$wt/cache.local/b" "$wt/sub/a.local" "$wt/sub/b.local" "$wt/メモ/x.local"
  pr_close ac0205-test
  if [[ $code -eq 1 && $out == *"has ignored files that removing it would delete: .env.local cache.local/ sub/ メモ/" && -f $wt/.env.local && ! -s $FAKE_LOG ]]; then
    pass "herdr-worktree: ignored files stop it and are all listed, an ignored or all-ignored folder once, a Japanese name unquoted"
