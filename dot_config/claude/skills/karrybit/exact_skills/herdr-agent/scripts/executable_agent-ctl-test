# A failure after the worktree is removed is one line, exit 1, saying what was already done.
pr_repo pr-fail
if pr_start pr-fail ac0207-test; then
  g -C "$wt" push -q origin feat/pr-fail
  state '.fail = "workspace close"'
  pr_close ac0207-test
  state 'del(.fail)'
  lines=$(printf '%s\n' "$out" | wc -l | tr -d ' ')
  if [[ $code -eq 1 && $lines -eq 1 && $out == "agent-ctl close ac0207-test: herdr workspace close failed: "*"(already done: removed the worktree $wt and closed $ws)" ]]; then
    pass "herdr-worktree: a failure partway says what was done"
  else
    fail "herdr-worktree failure partway: exit $code, $lines line(s): $out"
  fi
fi

