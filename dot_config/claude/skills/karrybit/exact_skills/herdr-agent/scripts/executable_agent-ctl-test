out=$(env "${pr_env[@]}" HERDR_AGENT_TEST_LEDGER="$tmp/nested/ledger" "$ac" close ac0209-test 2>&1); code=$?
if [[ $code -eq 1 && $out == *"HERDR_AGENT_TEST_LEDGER must be directly in a folder agent-ctl-test made"* && ! -s $FAKE_LOG ]]; then
  pass "HERDR_AGENT_TEST_LEDGER below the test folder stops it"
else
