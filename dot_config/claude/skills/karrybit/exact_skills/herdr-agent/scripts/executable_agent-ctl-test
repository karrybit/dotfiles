  if [[ $code -eq 0 ]] && printf '%s' "$out" | jq -e --arg p "$p" '.parent == null and (.parent_kept | contains($p + ": " + $p + ":p1 runs node"))' >/dev/null &&
    ! closed "$p"; then
    pass "herdr-worktree: a parent running something other than a shell stays open"
