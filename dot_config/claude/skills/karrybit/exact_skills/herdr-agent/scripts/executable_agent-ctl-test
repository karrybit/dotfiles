  fail "HERDR_AGENT_TEST_LEDGER home: exit $code: $out"
fi

# rule_matches <rule> <command>: a Bash rule's pattern matches the whole command, "*" standing in for
# any text, and a trailing " *" also matching the bare command.
rule_matches() {
  jq -nr --arg rule "$1" --arg cmd "$2" '
    ($rule | capture("^Bash\\((?<p>.*)\\)$").p) as $p
    | ($p | gsub("(?<c>[.+?^${}()|\\[\\]\\\\])"; "\\\(.c)") | gsub("\\*"; ".*")) as $re
    | ($cmd | test("^" + $re + "$")) or (($p | endswith(" *")) and $cmd == ($p | rtrimstr(" *")))' | rg -qx true
}
# decision <command>: what the settings decide for a command with no prompt from the mode, reading
# the rules as the permissions docs describe them: deny, then ask, then allow, the first match winning.
decision() {
  local list rule
  for list in deny ask allow; do
    while IFS= read -r rule; do
      if rule_matches "$rule" "$1"; then echo "$list"; return; fi
    done < <(jq -r --arg l "$list" '(.permissions[$l] // [])[] | select(startswith("Bash("))' "$settings")
  done
  echo none
}
# has <jq path to a list> <entry>: the list in the settings holds the entry.
has() {
  if jq -e --arg v "$2" "($1 // []) | index(\$v)" "$settings" >/dev/null; then pass "$1 has $2"; else fail "$1 lacks $2"; fi
}

if [[ -n $settings ]]; then
  if ! jq -e . "$settings" >/dev/null; then fail "$settings is not valid JSON"; else
    pass "$settings is valid JSON"
    if rule_matches 'Bash(herdr agent send-keys * Enter)' 'herdr agent send-keys a1 C-c Enter'; then
      pass 'a "*" in the middle of a rule also matches other keys before Enter'
    else
      fail 'the rule reading does not let "*" match spaces'
    fi
    form='~/.config/claude/skills/karrybit/skills/herdr-agent/scripts'
    for s in agent-ctl agent-report safe-key; do
      has .permissions.allow "Bash($form/$s *)"
      has .sandbox.excludedCommands "$form/$s *"
    done
    if jq -e --arg c "$form/herdr-call-check" '[.hooks.PreToolUse[]? | select(.matcher == "Bash") | .hooks[]?.command] | any(contains($c))' "$settings" >/dev/null; then
      pass "hooks.PreToolUse runs $form/herdr-call-check before Bash"
    else
      fail "hooks.PreToolUse lacks a Bash hook that runs $form/herdr-call-check"
    fi
    if jq -e '.env.HERDR_AGENT_NAME_PATTERN // "" | length > 0' "$settings" >/dev/null; then
      pass "env sets HERDR_AGENT_NAME_PATTERN"
    else
      fail "env lacks HERDR_AGENT_NAME_PATTERN"
    fi
    for c in 'herdr workspace close w1' 'herdr tab close w1:t2' 'herdr worktree remove --workspace w1' \
      'herdr agent prompt a1 /clear' 'herdr agent send-keys a1 Enter' 'herdr pane send-keys w1:p2 q' 'herdr pane send-text w1:p2 yes'; do
      got=$(decision "$c")
      if [[ $got != allow ]]; then pass "not allowed ($got): $c"; else fail "permissions.allow lets through: $c"; fi
    done
  fi
fi

echo "agent-ctl-test: $failed failure(s)" >&2
[[ $failed -eq 0 ]]
