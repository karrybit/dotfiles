#!/usr/bin/env bash
# Usage: skill-wrap SKILL_DIR REF OUT_DIR [SIBLING...]
# Builds a plugin directory at OUT_DIR (which must not exist yet) holding the
# skill in SKILL_DIR as committed at git REF, and the suites and fixtures from
# the skill's eval directory in the working tree, so one suite can be run
# against several skill versions. SKILL_DIR is a plugin's skills/<name> or
# skills/<category>/<name>, and its eval directory is evals/<name> at that
# plugin's root, the nearest folder above SKILL_DIR that holds it. Each
# plugin-eval* directory there becomes evals* in OUT_DIR. Each SIBLING names
# another skill directory beside SKILL_DIR, added at the same REF for a skill
# that reads its siblings' files.
# A failed step, such as a REF that does not exist or a SKILL_DIR that held no
# files at REF, exits non-zero and removes the OUT_DIR this run created. For a
# REF from before the skill moved, pass SKILL_DIR from a checkout of REF made
# with git worktree add.
set -euo pipefail
skill=$(cd "$1" && pwd)
ref=$2
out=$3
shift 3
name=$(basename "$skill")
root=$(dirname "$skill")
until [ -d "$root/evals/$name" ]; do
  [ "$root" != / ] || { echo "skill-wrap: no evals/$name above $skill" >&2; exit 1; }
  root=$(dirname "$root")
done
evals=$root/evals/$name

mkdir "$out"
trap 'rm -rf "$out"' EXIT
mkdir -p "$out/.claude-plugin"
for each in "$name" "$@"; do
  mkdir -p "$out/skills/$each"
  git -C "$skill/../$each" archive "$ref" . \
    | tar -x -C "$out/skills/$each" --exclude=PROVENANCE.md
done
# A chezmoi source file executable_<name> deploys as an executable <name>.
find "$out/skills" -type f -name 'executable_*' | while IFS= read -r file; do
  base=$(basename "$file")
  to=$(dirname "$file")/${base#executable_}
  mv "$file" "$to"
  chmod +x "$to"
done
commit=$(git -C "$skill" rev-parse --short "$ref")
printf '{"name":"kit","version":"0.0.0+%s","description":"Tools"}\n' "$commit" \
  > "$out/.claude-plugin/plugin.json"
for suite in "$evals"/plugin-eval*; do
  base=$(basename "$suite")
  cp -R "$suite" "$out/evals${base#plugin-eval}"
done
if [ -d "$evals/fixtures" ]; then
  cp -R "$evals/fixtures" "$out/fixtures"
fi
trap - EXIT
echo "$out <- $name${*:+ $*}@$commit"
