#!/bin/bash
# Usage: wt-list
# Prints the name and current branch of each worktree that wt-new created; "-" when the branch cannot be read.
set -eu
. "$(dirname "$0")/wt-lib"
ledger=$(ledger_path)
[ -f "$ledger" ] || exit 0
while IFS=$'\t' read -r name path _; do
  branch=$(git -C "$path" branch --show-current 2>/dev/null || true)
  printf '%s\t%s\n' "$name" "${branch:--}"
done < "$ledger"
