#!/bin/bash
# Runs every check in a throwaway repository under tests/work and prints "<n> failure(s)".
set -u
tests="$(cd "$(dirname "$0")" && pwd)"
bin="$tests/../bin"
rm -rf "$tests/work"
trap 'rm -rf "$tests/work"' EXIT
git init -q "$tests/work"
cd "$tests/work"
git -c user.name=t -c user.email=t@example.invalid commit -q --allow-empty -m init
failures=0
check() {
  if eval "$2"; then echo "ok   $1"; else echo "FAIL $1"; failures=$((failures + 1)); fi
}

"$bin/wt-new" a
check "wt-new creates the worktree" '[ -d .worktrees/a ]'
check "wt-list shows the name and branch" '[ "$("$bin/wt-list")" = "$(printf "a\twt/a")" ]'
git -C .worktrees/a switch -q -c other
check "wt-list shows the branch after a switch" '[ "$("$bin/wt-list")" = "$(printf "a\tother")" ]'
"$bin/wt-close" a
check "wt-close removes a worktree wt-new created" '[ ! -d .worktrees/a ]'

git worktree add -q -b human .worktrees/human
check "wt-close leaves a worktree a person created" '! "$bin/wt-close" human 2>/dev/null && [ -d .worktrees/human ]'

git worktree add -q -b wt/old .worktrees/old
printf 'old\t%s\twt/old\n' "$PWD/.worktrees/old" >> state/ledger.tsv
check "wt-list reads a three-column row" '[ "$("$bin/wt-list")" = "$(printf "old\twt/old")" ]'
"$bin/wt-close" old
check "wt-close removes a three-column row's worktree" '[ ! -d .worktrees/old ] && ! grep -q "^old" state/ledger.tsv'

echo "$failures failure(s)"
[ "$failures" -eq 0 ]
