#!/bin/bash
# Usage: wt-close <name>
# Removes the worktree only when the ledger records that wt-new created it.
set -eu
. "$(dirname "$0")/wt-lib"
name=$1
ledger=$(ledger_path)
row=$(awk -F'\t' -v n="$name" '$1 == n' "$ledger" 2>/dev/null || true)
if [ -z "$row" ]; then
  echo "wt-close: $name was not created by wt-new; leaving it" >&2
  exit 1
fi
path=$(printf '%s\n' "$row" | cut -f2)
git -C "$top" worktree remove "$path"
awk -F'\t' -v n="$name" '$1 != n' "$ledger" > "$ledger.tmp"
mv "$ledger.tmp" "$ledger"
