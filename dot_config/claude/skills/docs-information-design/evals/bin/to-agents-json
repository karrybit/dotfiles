#!/bin/sh
# Usage: to-agents-json AGENT.md > agents.json   (the --agents format of claude -p)
set -eu
fm=$(awk 'NR==1&&/^---$/{f=1;next} f&&/^---$/{exit} f' "$1")
body=$(awk 'c>=2{print} /^---$/{c++}' "$1")
printf '%s\n' "$fm" | yq -o=json '.' | jq --arg p "$body" '{(.name): {description, prompt: $p, tools: (.tools | split(", ")), model}}'
