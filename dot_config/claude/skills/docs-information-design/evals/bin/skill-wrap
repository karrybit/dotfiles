#!/bin/sh
# Usage: skill-wrap REF OUT_DIR
# Builds a plugin directory at OUT_DIR (which must not exist yet) holding the
# skill as committed at git REF, and the Plugin Evals suites and fixtures from
# this working tree, so one suite can be run against several skill versions.
set -eu
ref=$1
out=$2
evals=$(cd "$(dirname "$0")/.." && pwd)
skill=$(dirname "$evals")
name=$(basename "$skill")

mkdir "$out"
mkdir -p "$out/.claude-plugin" "$out/skills/$name"
git -C "$skill" archive "$ref" . \
  | tar -x -C "$out/skills/$name" --exclude=evals --exclude=PROVENANCE.md
commit=$(git -C "$skill" rev-parse --short "$ref")
printf '{"name":"docs-kit","version":"0.0.0+%s","description":"Documentation tools"}\n' "$commit" \
  > "$out/.claude-plugin/plugin.json"
cp -R "$evals/plugin-eval" "$out/evals"
cp -R "$evals/plugin-eval-holdout" "$out/evals-holdout"
cp -R "$evals/plugin-eval-activation" "$out/evals-activation"
cp -R "$evals/fixtures" "$out/fixtures"
echo "$out <- $name@$commit"
