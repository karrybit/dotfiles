#!/bin/sh
# Prints the last assistant message of the Claude session running as a Herdr
# agent. Reading the transcript instead of the screen returns the report
# alone, without the rest of the terminal output. As in agent-ctl, the name
# names the Herdr agent with each character herdr does not take in a name
# turned into "-".
#
# --wait waits until the agent stops: it is idle or done. When its last
# message holds a "## 変更の要約" line, the first heading of a
# karrybit:completion-report report, it prints "status: <state>" and the
# report. A stop without that line may be a pause between turns, so --wait
# waits one minute for the agent to work again; when it does not, --wait
# reads the last message once more and, still without the heading, prints
# "status: no-report" and that message (a question, a part-way report, or a
# pause on its own background work).
#
# An agent that stops idle or done with a tool call waiting for an answer
# (an AskUserQuestion, or an approval dialog), which herdr does not always
# see as blocked, makes --wait print "status: awaiting-answer" and the
# waiting calls at once.
#
# A stop --wait has printed is not printed again: --wait notes the stop's
# session, herdr's completion_seq, and the waiting calls' tool_use IDs, and a
# later --wait on the same stop waits for the next one; agent-ctl close
# removes the note with the agent. Run again after a pause, it hands over
# the agent's next stop, even one that ended before it started. The notes are
# in $HERDR_AGENT_STATE_HOME/stops, which lib/karo-env sets; agent-report
# runs outside the sandbox, so the value comes only from Claude Code's env
# and settings at start, and a call that sets it before the name runs in the
# sandbox.
#
# A blocked or unknown agent (one whose pane is gone) prints the state alone;
# an agent whose pane someone is watching ends idle, not done. When herdr
# agent get fails or the transcript cannot be read it prints "status: error"
# and exits 1; a wait that fails returns at once and shows the state as it is
# (working). Run in the background after the agent is seen working, it hands
# the caller the outcome in the one completion notice.
set -eu

usage() {
  echo "usage: karo-agent-report [--wait] <agent-name>" >&2
  exit 2
}
wait=
if [ "${1:-}" = --wait ]; then
  wait=1
  shift
fi
[ $# -eq 1 ] || usage
name=$(printf '%s' "$1" | tr -c 'a-z0-9_-' -)

transcript() {
  session=$(printf '%s' "$agent" | jq -r .result.agent.agent_session.value)
  # The session ID names the transcript file, so it may hold no path.
  case $session in
    '' | *[!A-Za-z0-9-]*) echo "agent-report: not a session ID: $session" >&2; return 1 ;;
  esac
  cwd=$(printf '%s' "$agent" | jq -r .result.agent.cwd)
  # Claude Code names a project directory after its cwd with every
  # non-alphanumeric character replaced by "-".
  project=$(printf '%s' "$cwd" | tr -c 'A-Za-z0-9' '-')
  printf '%s\n' "${CLAUDE_CONFIG_DIR:-$HOME/.claude}/projects/$project/$session.jsonl"
}
report() {
  file=$(transcript) || return 1
  jq -rs '[.[] | select(.type == "assistant") | .message.content[]? | select(.type == "text") | .text] | last // ""' "$file"
}
# pending: print the tool calls after the agent's last text that have no
# tool_result: first their tool_use IDs on one line, then each call, an
# AskUserQuestion as its questions with their options and the others as the
# tool's name and input. Claude Code writes a tool call to the transcript
# before the tool runs, so a call waiting for an answer is there without a
# result. Every call after the last text counts, since calls made at once
# get their results in any order; a text written later means the agent went
# on, so an older call left without a result does not count.
pending() {
  file=$(transcript) || return 1
  jq -rs '[.[] | select(.type == "user") | .message.content | arrays | .[] | select(.type == "tool_result") | .tool_use_id] as $answered
    | [.[] | select(.type == "assistant") | .message.content[]? | select(.type == "text" or .type == "tool_use")]
    | (map(.type) | indices("text") | last) as $text
    | [.[(if $text == null then 0 else $text + 1 end):][] | select(.id | IN($answered[]) | not)]
    | select(length > 0)
    | (map(.id) | join(" ")),
      (.[] | if .name == "AskUserQuestion" then
          "AskUserQuestion",
          (.input.questions[]? | "[\(.header)] \(.question) (multiSelect: \(.multiSelect // false))",
            (.options[]? | "- \(.label): \(.description)"))
        else "\(.name): \(.input | tojson | .[0:500])" end)' "$file"
}

if [ -z "$wait" ]; then
  agent=$(herdr agent get "$name")
  report
  exit 0
fi
. "${0%/*}/../lib/karo-env"
seen=$HERDR_AGENT_STATE_HOME/stops/$name
# hand_over <status>: note the stop and print it with the message.
hand_over() {
  mkdir -p "${seen%/*}"
  printf '%s\n' "$stop" > "$seen"
  printf 'status: %s\n%s\n' "$1" "$text"
  exit 0
}
stalled=
while :; do
  herdr agent wait "$name" --until idle --until 'done' --until blocked --until unknown >/dev/null || true
  if ! agent=$(herdr agent get "$name"); then
    echo "status: error"
    exit 1
  fi
  status=$(printf '%s' "$agent" | jq -r .result.agent.agent_status)
  case $status in
    idle | done) ;;
    *) echo "status: $status"; exit 0 ;;
  esac
  seq=$(printf '%s' "$agent" | jq -r .result.agent.completion_seq)
  # A missing transcript is an error line, not a report.
  if ! calls=$(pending 2>&1); then
    echo "status: error"
    printf '%s\n' "$calls"
    exit 1
  fi
  # The waiting calls' tool_use IDs are part of the stop, so a call made after
  # a stop already handed over, under the same completion_seq, is new.
  ids=$(printf '%s\n' "$calls" | head -n 1)
  stop="$(printf '%s' "$agent" | jq -r .result.agent.agent_session.value) $seq${ids:+ $ids}"
  if [ "$seq" != null ] && [ "$stop" = "$(cat "$seen" 2>/dev/null)" ]; then
    # The agent's next turn may begin and end before this wait starts, so
    # the wait is short and the loop looks at the stop again.
    herdr agent wait "$name" --until working --until blocked --until unknown --timeout 60000 >/dev/null || true
    continue
  fi
  if [ -n "$calls" ]; then
    text=$(printf '%s\n' "$calls" | tail -n +2)
    hand_over awaiting-answer
  fi
  if ! text=$(report 2>&1); then
    echo "status: error"
    printf '%s\n' "$text"
    exit 1
  fi
  if printf '%s\n' "$text" | grep -qxF '## 変更の要約'; then
    hand_over "$status"
  fi
  if [ -n "$stalled" ]; then
    hand_over no-report
  fi
  # A resume that ends before this wait starts is never seen as working, so
  # a failed wait leads to one more read rather than straight to no-report.
  herdr agent wait "$name" --until working --until blocked --until unknown --timeout 60000 >/dev/null || stalled=1
done
