#!/bin/sh
# Prints the open tasks of the Beads at KARO_HOME (default ~/karo) as Markdown, one heading and table
# per state in the order 作業中 (in_progress), 着手できる (open with no open blocker), 待ち (open with an
# open blocker, or blocked), 後回し (deferred), leaving out a state with no task. A table has the columns
# Parent, ID, Depends On and Title. Its tasks are grouped by parent, and Parent names the parent's ID on
# a group's first row only; a task with no parent has Parent `-`. One read-only `bd list` gives every
# task that is not closed, so a blocker that is not in the list is closed and is left out of Depends On.
# Titles are printed in full with `|` escaped. The arguments go on to `bd list`, so
# `--label project:<名前>` narrows it. A bd that fails exits with its status.
# usage: karo-open-tasks [<bd list option>...]
. "${0%/*}/../lib/karo-env"
tasks=$(bd -C "$KARO_HOME" --readonly list --status open,in_progress,blocked,deferred --limit 0 --json "$@") || exit
printf '%s\n' "$tasks" | jq -r '
  (map({key: .id, value: true}) | from_entries) as $open
  | map(. + {blockers: [.dependencies[]? | select(.type == "blocks") | .depends_on_id | select(. as $id | $open | has($id))]})
  | map(. + {state:
      if .status == "in_progress" then "作業中"
      elif .status == "deferred" then "後回し"
      elif .status == "open" and (.blockers | length) == 0 then "着手できる"
      else "待ち" end})
  | (if length == 0 then "開いているタスクはない" else empty end),
    (["作業中", "着手できる", "待ち", "後回し"][] as $state
     | map(select(.state == $state)) | select(length > 0)
     | sort_by(.parent == null, .parent)
     | "## \($state)\n\n| Parent | ID | Depends On | Title |\n| --- | --- | --- | --- |\n"
       + ([foreach .[] as $t ({}; {first: (.parent != $t.parent), parent: $t.parent, t: $t}; .)
           | .t as $t
           | (if $t.parent == null then "-" elif .first then $t.parent else "" end) as $parent
           | "| \($parent) | \($t.id) | \(if $t.blockers == [] then "-" else $t.blockers | join(", ") end) | \($t.title | gsub("\\|"; "\\|")) |"]
          | join("\n")) + "\n")'
