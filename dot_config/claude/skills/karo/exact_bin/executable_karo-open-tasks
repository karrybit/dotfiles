#!/bin/sh
# Prints the open tasks of the Beads at KARO_HOME (default ~/karo) as Markdown. A parent is a task with a
# child that is not closed. The parents come first under 親, in the order of their IDs, with the columns
# ID, Status, Depends On and Title, where Status is the state below. Every other task comes under one
# heading and table per state in the order 作業中 (in_progress), 着手できる (open with no open blocker),
# 待ち (open with an open blocker, or blocked), 後回し (deferred), with the columns Parent, ID, Depends On
# and Title. Its tasks are grouped by parent, and Parent names the parent's ID on a group's first row
# only; a task with no parent has Parent `-`. A section with no task is left out, so every task is
# printed once. One read-only `bd list` gives every task that is not closed, so a blocker that is not in
# the list is closed and is left out of Depends On. Titles are printed in full with `|` escaped. The
# arguments go on to `bd list`, so `--label project:<名前>` narrows it. A bd that fails exits with its
# status.
# usage: karo-open-tasks [<bd list option>...]
. "${0%/*}/../lib/karo-env"
tasks=$(bd -C "$KARO_HOME" --readonly list --status open,in_progress,blocked,deferred --limit 0 --json "$@") || exit
printf '%s\n' "$tasks" | jq -r '
  def deps: if .blockers == [] then "-" else .blockers | join(", ") end;
  def title: .title | gsub("\\|"; "\\|");
  (map({key: .id, value: true}) | from_entries) as $open
  | (map(select(.parent) | {key: .parent, value: true}) | from_entries) as $parents
  | map(. + {blockers: [.dependencies[]? | select(.type == "blocks") | .depends_on_id | select(. as $id | $open | has($id))]})
  | map(. + {parent_of_open: (.id as $id | $parents | has($id)), state:
      if .status == "in_progress" then "作業中"
      elif .status == "deferred" then "後回し"
      elif .status == "open" and (.blockers | length) == 0 then "着手できる"
      else "待ち" end})
  | (if length == 0 then "開いているタスクはない" else empty end),
    (map(select(.parent_of_open)) | select(length > 0) | sort_by(.id)
     | "## 親\n\n| ID | Status | Depends On | Title |\n| --- | --- | --- | --- |\n"
       + (map("| \(.id) | \(.state) | \(deps) | \(title) |") | join("\n")) + "\n"),
    (map(select(.parent_of_open | not)) as $leaves
     | ["作業中", "着手できる", "待ち", "後回し"][] as $state
     | $leaves | map(select(.state == $state)) | select(length > 0)
     | sort_by(.parent == null, .parent)
     | "## \($state)\n\n| Parent | ID | Depends On | Title |\n| --- | --- | --- | --- |\n"
       + ([foreach .[] as $t ({}; {first: (.parent != $t.parent), parent: $t.parent, t: $t}; .)
           | .t as $t
           | (if $t.parent == null then "-" elif .first then $t.parent else "" end) as $parent
           | "| \($parent) | \($t.id) | \($t | deps) | \($t | title) |"]
          | join("\n")) + "\n")'
