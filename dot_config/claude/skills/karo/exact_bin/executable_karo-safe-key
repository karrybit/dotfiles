#!/bin/sh
# Sends one of the two keys a caller may send without a permission prompt:
# Enter to an agent whose approval dialog is open (it picks the highlighted
# answer, Yes), or q to a pane whose foreground program is a pager. A "*" in a
# permission rule matches any run of words, so a rule cannot hold herdr
# send-keys to one target and one key; this script is the allowed form, and
# herdr send-keys itself still asks. Nothing is sent to the caller's own pane.
#
# enter sends only to an agent whose name matches HERDR_AGENT_NAME_PATTERN, an
# ERE the caller's settings set; when it is unset, enter sends nothing. As in
# agent-ctl, the name matches as given and names the Herdr agent with each
# character herdr does not take in a name turned into "-".
#
# An AskUserQuestion shows as blocked too, and Enter there would pick the
# highlighted option as the answer, so enter sends nothing while the agent's
# transcript holds an AskUserQuestion with no result after its last text, or
# cannot be read.
set -eu

usage() {
  echo "usage: karo-safe-key enter <agent> | karo-safe-key quit <pane>" >&2
  exit 2
}
[ $# -eq 2 ] || usage
self=${HERDR_PANE_ID:?}

case "$1" in
  enter)
    case $2 in
      *'
'*) usage ;;
    esac
    if [ -z "${HERDR_AGENT_NAME_PATTERN:-}" ]; then
      echo "safe-key: HERDR_AGENT_NAME_PATTERN is not set; not sending keys" >&2
      exit 1
    fi
    printf '%s\n' "$2" | grep -Eq -- "$HERDR_AGENT_NAME_PATTERN" || usage
    name=$(printf '%s' "$2" | tr -c 'a-z0-9_-' -)
    printf '%s\n' "$name" | grep -Eq '^[a-z][a-z0-9_-]{0,31}$' || usage
    agent=$(herdr agent get "$name" | jq -c '.result.agent')
    pane=$(printf '%s\n' "$agent" | jq -r '.pane_id')
    status=$(printf '%s\n' "$agent" | jq -r '.agent_status')
    if [ "$pane" = "$self" ]; then
      echo "safe-key: $2 is in this pane; not sending keys" >&2
      exit 1
    fi
    if [ "$status" != blocked ]; then
      echo "safe-key: $2 is $status, not blocked; not sending keys" >&2
      exit 1
    fi
    # The transcript is found as agent-report finds it.
    session=$(printf '%s\n' "$agent" | jq -r '.agent_session.value')
    case $session in
      '' | *[!A-Za-z0-9-]*) echo "safe-key: $2 has no session ID; not sending keys" >&2; exit 1 ;;
    esac
    project=$(printf '%s' "$(printf '%s\n' "$agent" | jq -r '.cwd')" | tr -c 'A-Za-z0-9' '-')
    file=${CLAUDE_CONFIG_DIR:-$HOME/.claude}/projects/$project/$session.jsonl
    if ! asking=$(jq -rs '[.[] | select(.type == "user") | .message.content | arrays | .[] | select(.type == "tool_result") | .tool_use_id] as $answered
      | [.[] | select(.type == "assistant") | .message.content[]? | select(.type == "text" or .type == "tool_use")]
      | (map(.type) | indices("text") | last) as $text
      | any(.[(if $text == null then 0 else $text + 1 end):][]; .name == "AskUserQuestion" and (.id | IN($answered[]) | not))' "$file" 2>/dev/null); then
      echo "safe-key: cannot read the transcript of $2; not sending keys" >&2
      exit 1
    fi
    if [ "$asking" != false ]; then
      echo "safe-key: $2 is waiting on an AskUserQuestion; not sending keys" >&2
      exit 1
    fi
    herdr agent send-keys "$name" Enter >/dev/null
    ;;
  quit)
    case "$2" in
      w*:p*) ;;
      *) usage ;;
    esac
    case "$2" in
      *[!A-Za-z0-9:]*) usage ;;
    esac
    if [ "$2" = "$self" ]; then
      echo "safe-key: $2 is this pane; not sending keys" >&2
      exit 1
    fi
    fg=$(herdr pane process-info --pane "$2" | jq -r '.result.process_info.foreground_processes[0].name')
    case "$fg" in
      less | glow) ;;
      *)
        echo "safe-key: $2 is running $fg; not sending keys" >&2
        exit 1
        ;;
    esac
    herdr pane send-keys "$2" q >/dev/null
    ;;
  *) usage ;;
esac
