#!/usr/bin/env bash
# Show that land changes nothing and exits non-zero on each unmet condition (a usage error, a dirty
# $KARO_HOME or worktree, $KARO_HOME off main, a call from another folder or under a Claude Code session
# started elsewhere or under none, a branch not named <semantics>/agent/<title>, a worktree
# outside the worktrees folder or not of $KARO_HOME, a .git link or a gitdir file in it, config that
# runs a command, a branch main cannot fast-forward to, a rebase that conflicts), and that a clean branch
# is rebased and fast-forwarded in the folders KARO_HOME and KARO_STATE_HOME name. settings-test checks
# that the settings run land outside the sandbox without a prompt.
# Every repository is a new one in a land-test.* folder made with mktemp in $TMPDIR, and every case
# gives land KARO_HOME and KARO_STATE_HOME in that folder, so the real record repository and state
# folder are never touched. land's look-up of the Claude Code process lists processes and cannot run in
# the sandbox, so each case runs a copy of land, with lib/karo-env beside it as in the plugin, in which
# that one line is replaced. The cases about variables land must not take as a place or as the callers
# run land itself.
# usage: land-test   (tests the land beside this script)
set -uo pipefail
exec </dev/null
[[ $# -eq 0 ]] || { echo "usage: land-test" >&2; exit 2; }
bin=$(cd "$(dirname "$0")" && pwd)
land=$bin/land
failed=0
fail() { printf 'FAIL\t%s\n' "$1"; failed=$((failed+1)); }
pass() { printf 'ok\t%s\n' "$1"; }

if [[ ! -x $land ]]; then
  echo "land-test: $land is not an executable file" >&2
  exit 1
fi

export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1
unset LAND_TEST_ROOT LAND_TEST_CLAUDE_CWD
tmp_root=$(cd "${TMPDIR:-/tmp}" && pwd -P)
lib=$bin/../../../lib/karo-env
if [[ $(grep -cxF 'callers=$(claude_cwds)' "$land") != 1 || ! -f $lib ]]; then
  echo "land-test: $land lacks the one callers line the copy replaces, or $lib is missing" >&2
  exit 1
fi

# fresh: a new root with karo on main (a.txt) and a worktree of the branch feat/agent/x adding b.txt in
# root/worktrees, the folder land takes with KARO_HOME=karo and KARO_STATE_HOME=root, and the copy of
# land in root/skills/land/scripts, with root/lib/karo-env, that reads the Claude Code folders from
# root/claude-cwds.
fresh() {
  root=$(mktemp -d "$tmp_root/land-test.XXXXXX") || exit 2
  karo=$root/karo wt=$root/worktrees/x branch=feat/agent/x
  copy=$root/skills/land/scripts/land
  mkdir -p "$root/worktrees" "$root/skills/land/scripts" "$root/lib" && cp "$lib" "$root/lib/" || exit 2
  awk -v r="$root" '
    $0 == "callers=$(claude_cwds)" { print "callers=$(cat '"'"'" r "/claude-cwds'"'"')"; next }
    { print }' "$land" >"$copy" && chmod +x "$copy" || exit 2
  git init -q -b main "$karo" &&
    git -C "$karo" config user.name test && git -C "$karo" config user.email test@example.invalid &&
    echo a >"$karo/a.txt" && git -C "$karo" add a.txt && git -C "$karo" commit -q -m init &&
    git -C "$karo" worktree add -q -b "$branch" "$wt" main &&
    echo b >"$wt/b.txt" && git -C "$wt" add b.txt && git -C "$wt" commit -q -m b || exit 2
}
# on_main: commit c.txt (or the given file and text) on main of karo, so the branch is behind.
on_main() {
  echo "${2:-c}" >"$karo/${1:-c.txt}" && git -C "$karo" add "${1:-c.txt}" && git -C "$karo" commit -q -m "${1:-c.txt}" || exit 2
}
# run [<folder>] -- <land arguments>: run the copy of land in the folder (default karo) with
# KARO_HOME=karo and KARO_STATE_HOME=root, keeping its stderr in err. The copy's look-up of the calling
# Claude Code process answers the folders in claude_at (one per line, nearest first), karo when unset,
# and none when empty. With real_env set (an array of NAME=value), land itself runs instead, with those
# variables added to its environment after KARO_HOME and KARO_STATE_HOME; land itself gets as far as
# its look-up of the Claude Code process, which no Claude Code in this test folder can pass.
run() {
  local dir=$karo
  if [[ $1 != -- ]]; then dir=$1; shift; fi
  shift
  printf '%s' "${claude_at-$karo}" >"$root/claude-cwds" || exit 2
  if [[ -n ${real_env+set} ]]; then
    err=$(cd "$dir" && env KARO_HOME="$karo" KARO_STATE_HOME="$root" "${real_env[@]}" "$land" "$@" 2>&1 >/dev/null)
  else
    err=$(cd "$dir" && env KARO_HOME="$karo" KARO_STATE_HOME="$root" "$copy" "$@" 2>&1 >/dev/null)
  fi
}
# refused <name> <expected words in stderr> [<folder>] -- <land arguments>: land exits non-zero, says
# why, and leaves main and the branch where they were.
refused() {
  local name=$1 words=$2 main_before branch_before
  shift 2
  main_before=$(git -C "$karo" rev-parse main) branch_before=$(git -C "$karo" rev-parse "$branch" 2>/dev/null)
  if run "$@"; then
    fail "$name: land succeeded"
  elif [[ $err != *"$words"* ]]; then
    fail "$name: stderr lacks '$words': $err"
  elif [[ $(git -C "$karo" rev-parse main) != "$main_before" ]] ||
    [[ $(git -C "$karo" rev-parse "$branch" 2>/dev/null) != "$branch_before" ]]; then
    fail "$name: land moved main or the branch"
  else
    pass "$name is refused"
  fi
}

# KARO_HOME and KARO_STATE_HOME name folders in the test folder made with mktemp, not their defaults.
fresh
on_main
run -- "$branch" --rebase && run -- "$branch"
if [[ -z $err && $(git -C "$karo" rev-parse main) == "$(git -C "$karo" rev-parse "$branch")" &&
  -f $karo/b.txt && -f $wt/c.txt ]]; then
  pass "with KARO_HOME and KARO_STATE_HOME naming the test folder, a clean branch there is rebased onto main and main is fast-forwarded to it"
else
  fail "rebase and fast-forward: $err"
fi

fresh
run -- "$branch"
if [[ -z $err && $(git -C "$karo" rev-parse main) == "$(git -C "$karo" rev-parse "$branch")" ]]; then
  pass "a branch already on main is fast-forwarded without a rebase"
else
  fail "fast-forward: $err"
fi

fresh
on_main
refused "a branch main cannot fast-forward to" "--rebase first" -- "$branch"

fresh
on_main b.txt other
run -- "$branch" --rebase
if [[ $err == *"conflicted and was aborted: b.txt"* && ! -d $karo/.git/worktrees/x/rebase-merge &&
  ! -d $karo/.git/worktrees/x/rebase-apply && -z $(git -C "$wt" status --porcelain) &&
  $(git -C "$wt" log -1 --format=%s) == b ]]; then
  pass "a conflicting rebase is aborted, names the file, and leaves the branch as it was"
else
  fail "conflicting rebase: $err"
fi

fresh
echo changed >"$karo/a.txt"
refused "a KARO_HOME with an uncommitted change" "uncommitted changes" -- "$branch"

fresh
echo changed >"$wt/b.txt"
refused "a worktree with an uncommitted change" "uncommitted changes" -- "$branch" --rebase

fresh
git -C "$karo" checkout -q -b other
refused "a KARO_HOME off main" "not main" -- "$branch"

fresh
refused "a call from the worktree" "run it from" "$wt" -- "$branch" --rebase

# A call made in $KARO_HOME but under an agent's Claude Code, which started in its worktree.
fresh
claude_at=$wt
refused "a call under a Claude Code session in the worktree" "runs in $wt, not $karo" -- "$branch"

# An agent starts a Claude Code in $KARO_HOME and calls land under it: the agent's own session is still
# an ancestor.
fresh
claude_at=$karo$'\n'$wt
refused "a call under a Claude Code in KARO_HOME started by a session in the worktree" "runs in $wt, not $karo" -- "$branch"

# "?" is what the look-up prints for a folder lsof could not read; neither it nor a relative path may
# resolve against land's own folder. A one-letter folder in $KARO_HOME would match "?" as a glob.
fresh
mkdir "$karo/a"
claude_at='?'
refused "a Claude Code session whose folder cannot be read" "cannot be read: ?" -- "$branch"

fresh
claude_at=.
refused "a Claude Code session given by a relative path" "cannot be read: ." -- "$branch"

fresh
claude_at=
refused "a call with no Claude Code process among the callers" "no Claude Code process" -- "$branch"
unset claude_at

fresh
claude_at=$karo/.
run -- "$branch"
if [[ -z $err && $(git -C "$karo" rev-parse main) == "$(git -C "$karo" rev-parse "$branch")" ]]; then
  pass "a call under a Claude Code session in KARO_HOME lands the branch"
else
  fail "Claude Code session in KARO_HOME: $err"
fi
unset claude_at

fresh
git -C "$karo" branch -q -m "$branch" feature/x
branch=feature/x
refused "a branch not named <semantics>/agent/<title>" "<semantics>/agent/<title>" -- "$branch"

fresh
git -C "$karo" worktree add -q -b feat/agent/y "$root/elsewhere" main
branch=feat/agent/y
refused "a worktree outside the worktrees folder" "not directly in" -- "$branch" --rebase

fresh
git -C "$karo" branch -q feat/agent/z
branch=feat/agent/z
refused "a branch no worktree has checked out" "no worktree" -- "$branch"

fresh
git -C "$karo" config filter.x.clean 'touch pwned'
refused "a KARO_HOME whose config runs a command" "does not allow: filter.x.clean" -- "$branch"

# bd reads beads.role from the git config; that one key is allowed, not the rest of beads.*.
fresh
git -C "$karo" config beads.role maintainer
run -- "$branch"
if [[ -z $err && $(git -C "$karo" rev-parse main) == "$(git -C "$karo" rev-parse "$branch")" ]]; then
  pass "a KARO_HOME with beads.role in its config lands the branch"
else
  fail "beads.role: $err"
fi

fresh
git -C "$karo" config beads.foo x
refused "a KARO_HOME with another beads.* key in its config" "does not allow: beads.foo" -- "$branch"

fresh
other=$root/other
git init -q -b main "$other" && git -C "$other" -c user.name=test -c user.email=test@example.invalid commit -q --allow-empty -m other
git -C "$other" worktree add -q -b "$branch" "$root/worktrees/fake" main
# The worktree of karo keeps its branch, but its .git now names the other repository.
printf 'gitdir: %s\n' "$other/.git/worktrees/fake" >"$wt/.git"
refused "a worktree whose .git names another repository" "not a worktree of" -- "$branch" --rebase

fresh
git -C "$karo" config extensions.worktreeConfig true
refused "a KARO_HOME that reads config.worktree, which agents can write" "does not allow: extensions.worktreeconfig" -- "$branch" --rebase

# An agent rewrites the worktree's .git file and its commondir after land's checks, pointing them at a
# copy of the repository whose config runs a command on checkout. A git on PATH plants both just
# before the rebase runs; land must still use only the repository it checked.
fresh
printf 'c.txt filter=evil\n' >"$karo/.gitattributes" && git -C "$karo" add .gitattributes && git -C "$karo" commit -q -m attributes
on_main
cp -R "$karo/.git" "$root/evil.git"
git --git-dir="$root/evil.git" config filter.evil.smudge "touch $root/pwned; cat"
mkdir -p "$root/path"
real_git=$(command -v git)
cat >"$root/path/git" <<EOF
#!/bin/sh
case " \$* " in
  *" rebase main "*)
    printf '%s\n' "$root/evil.git" >"$karo/.git/worktrees/x/commondir"
    printf 'gitdir: %s\n' "$root/evil.git/worktrees/x" >"$wt/.git" ;;
esac
exec "$real_git" "\$@"
EOF
chmod +x "$root/path/git"
PATH=$root/path:$PATH run -- "$branch" --rebase
if [[ ! -e $root/pwned ]]; then
  pass "a .git and commondir rewritten after the checks are not followed"
else
  fail "the rebase read config from a repository planted after the checks: $err"
fi

fresh
mv "$karo/.git" "$root/real.git" && ln -s "$root/real.git" "$karo/.git"
refused "a KARO_HOME whose .git is a link" ".git is not a folder" -- "$branch"
rm "$karo/.git" && mv "$root/real.git" "$karo/.git"

# git reads no gitdir file in a main checkout's .git, so only land's own check stands in the way.
fresh
printf '%s\n' "$root/elsewhere/.git" >"$karo/.git/gitdir"
refused "a KARO_HOME whose .git has a gitdir file" "has a gitdir file" -- "$branch"

fresh
outside=$(mktemp -d "$tmp_root/elsewhere.XXXXXX") || exit 2
real_env=(LAND_TEST_ROOT="$outside")
refused "LAND_TEST_ROOT outside a land-test.* folder" "land $branch: " -- "$branch"
unset real_env

# LAND_TEST_ROOT and LAND_TEST_CLAUDE_CWD naming the test folder and karo, which land must not take
# as a place for $KARO_HOME or as the Claude Code callers: land still looks up the real callers.
fresh
real_env=(TMPDIR="$tmp_root" LAND_TEST_ROOT="$root" LAND_TEST_CLAUDE_CWD="$karo")
refused "LAND_TEST_ROOT and LAND_TEST_CLAUDE_CWD in the environment" "Claude Code" -- "$branch"
unset real_env

# A call from the folder KARO_HOME would name by default under HOME, while KARO_HOME names karo.
fresh
mkdir -p "$root/home/karo" || exit 2
real_env=(HOME="$root/home")
refused "a call from the default KARO_HOME while KARO_HOME names another folder" "run it from $karo" "$root/home/karo" -- "$branch"
unset real_env

# A TMPDIR of the caller's choosing, with a land-test.* folder in it whose karo and worktrees are links
# to the $KARO_HOME and the worktrees land uses.
fresh
mkdir -p "$root/tmp/land-test.evil" &&
  ln -s "$karo" "$root/tmp/land-test.evil/karo" &&
  ln -s "$root/worktrees" "$root/tmp/land-test.evil/worktrees" || exit 2
real_env=(TMPDIR="$root/tmp" LAND_TEST_ROOT="$root/tmp/land-test.evil" LAND_TEST_CLAUDE_CWD="$karo")
refused "a land-test.* folder linking to the KARO_HOME land uses" "Claude Code" -- "$branch"
unset real_env

# usage_error <name> -- <land arguments>: land exits 2 with its usage line and nothing else.
usage_error() {
  local name=$1 code
  shift
  run "$@"
  code=$?
  if [[ $code -eq 2 && $err == "usage: land <branch> [--rebase]" ]]; then pass "$name is a usage error"
  else fail "$name: exit $code: $err"; fi
}
fresh
usage_error "a call without a branch" --
usage_error "a second argument other than --rebase" -- "$branch" --force

if [[ $failed -gt 0 ]]; then
  echo "land-test: $failed failed" >&2
  exit 1
fi
echo "land-test: all passed"
