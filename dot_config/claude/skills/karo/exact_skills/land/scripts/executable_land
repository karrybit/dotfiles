#!/bin/sh
# Lands a delegated agent's branch on the main of $KARO_HOME. karo runs it
# outside the sandbox (sandbox.excludedCommands), because rebasing and
# fast-forwarding a branch that changes .claude/settings.json or .claude/skills
# replaces files the sandbox never lets a command write.
#
#   land <branch> --rebase  rebases the branch onto main inside its worktree;
#                           main does not move. On a conflict the rebase is
#                           aborted and the conflicting files are listed.
#   land <branch>           fast-forwards main of $KARO_HOME to the branch, or
#                           stops when main is not an ancestor of it.
#
# Nothing is changed unless every check passes: the caller's working directory
# and that of the Claude Code process it runs under are $KARO_HOME, $KARO_HOME
# is on main with no uncommitted change to a tracked file, the branch is named
# <semantics>/agent/<title> and checked out in a worktree of $KARO_HOME
# directly in $KARO_STATE_HOME/worktrees that has no uncommitted change either.
# Every failure is one line on stderr and exit code 1; a usage error exits 2.
#
# KARO_HOME and KARO_STATE_HOME move the folders, through lib/karo-env, which
# gives their defaults. land runs outside the sandbox, so their values come
# only from the environment Claude Code started with and from its settings,
# which no command in the sandbox can change; a call that puts a value before
# the name does not match the exclusion and runs in the sandbox. No config
# file is read. land-test runs a copy of this script in which the callers line
# is replaced, so it stays on one line of its own.
set -eu

usage() {
  echo "usage: land <branch> [--rebase]" >&2
  exit 2
}
case $# in
  1) branch=$1 mode=ff ;;
  2) [ "$2" = --rebase ] || usage; branch=$1 mode=rebase ;;
  *) usage ;;
esac

stop() {
  echo "land $branch: $*" >&2
  exit 1
}
oneline() { printf '%s' "$1" | tr '\n' ' ' | cut -c 1-300; }

# Sandboxed agents can write the .git of $KARO_HOME and their own worktree, so
# every git here runs no hooks, fsmonitor, automatic maintenance or submodule
# update (command-line config outranks every config file), and safe_git lets
# git run only when the repository's own config (local and worktree scope)
# holds no key that makes git run a command.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_COMMON_DIR GIT_OBJECT_DIRECTORY
export GIT_OPTIONAL_LOCKS=0 GIT_CONFIG_COUNT=5 \
  GIT_CONFIG_KEY_0=core.hooksPath GIT_CONFIG_VALUE_0=/dev/null \
  GIT_CONFIG_KEY_1=core.fsmonitor GIT_CONFIG_VALUE_1=false \
  GIT_CONFIG_KEY_2=gc.auto GIT_CONFIG_VALUE_2=0 \
  GIT_CONFIG_KEY_3=maintenance.auto GIT_CONFIG_VALUE_3=false \
  GIT_CONFIG_KEY_4=submodule.recurse GIT_CONFIG_VALUE_4=false

. "${0%/*}/../../../lib/karo-env"
karo_path=$KARO_HOME worktrees_path=$KARO_STATE_HOME/worktrees
karo=$(cd "$karo_path" 2>/dev/null && pwd -P) || stop "$karo_path is not a folder"
worktrees=$(cd "$worktrees_path" 2>/dev/null && pwd -P) || stop "$worktrees_path is not a folder"

# claude_cwds: print the working directory of every Claude Code process among
# this one's ancestors, nearest first, one per line ("?" when it cannot be
# read), or nothing when there is none.
claude_cwds() {
  pid=$PPID
  while [ "${pid:-0}" -gt 1 ]; do
    comm=$(ps -o comm= -p "$pid" 2>/dev/null) || return 0
    args=$(ps -o args= -p "$pid" 2>/dev/null) || return 0
    argv0=${args%% *}
    # A native install runs the binary ~/.local/share/claude/versions/<version>
    # through the link ~/.local/bin/claude.
    case "${argv0##*/} $comm" in
      "claude "* | *" claude" | */claude | *"/claude/versions/"*)
        dir=$(lsof -a -d cwd -p "$pid" -Fn 2>/dev/null | sed -n 's/^n//p' | head -n 1)
        printf '%s\n' "${dir:-?}"
        ;;
    esac
    pid=$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d ' ') || return 0
  done
}
# An agent's settings exclude this command from its sandbox too, so only a call
# made from $KARO_HOME under Claude Code sessions that all run in $KARO_HOME,
# which is karo, is taken. The agent's own Claude Code process keeps the
# worktree it started in, whatever folder the call itself runs in, and stays
# among the ancestors of any Claude Code it starts in $KARO_HOME.
[ "$(pwd -P)" = "$karo" ] || stop "run it from $karo"
callers=$(claude_cwds)
[ -n "$callers" ] || stop "no Claude Code process is among the callers"
checked=$(printf '%s\n' "$callers" | while IFS= read -r caller; do
  case $caller in
    (/*) ;;
    (*) echo "a calling Claude Code session runs in a folder that cannot be read: $caller"; break ;;
  esac
  dir=$(cd "$caller" 2>/dev/null && pwd -P) || { echo "a calling Claude Code session runs in a folder that cannot be read: $caller"; break; }
  [ "$dir" = "$karo" ] || { echo "a calling Claude Code session runs in $dir, not $karo"; break; }
done)
[ -z "$checked" ] || stop "$checked"

if ! printf '%s' "$branch" | grep -Eq '^(feat|fix|docs|refactor|perf|test|build|ci|chore|revert)/agent/[a-z0-9]+(-[a-z0-9]+)*$'; then
  stop "the branch must be <semantics>/agent/<title>"
fi

# $KARO_HOME is a main checkout, so its .git is a folder that names no other
# repository; a link or a commondir or gitdir file in it would send git to
# config that was never checked.
{ [ -d "$karo/.git" ] && [ ! -L "$karo/.git" ]; } || stop "$karo/.git is not a folder"
for f in commondir gitdir; do
  { [ ! -e "$karo/.git/$f" ] && [ ! -L "$karo/.git/$f" ]; } ||
    stop "$karo/.git has a $f file, which points at another repository"
done

# Agents can rewrite a worktree's .git file and the commondir and gitdir files
# under $KARO_HOME/.git at any moment, also between a check here and the git
# that follows it. So no git here finds its repository through those files:
# every call names the git folder, the common folder and the work tree itself.
# The only config git then reads from the repository is
# $KARO_HOME/.git/config, which sandboxed commands cannot write, and
# config.worktree in the worktree's git folder, which they can;
# config.worktree is read only when extensions.worktreeConfig is set, so that
# key is refused.
# git_at <git folder> <work tree> <args>: run git there.
git_at() {
  at_dir=$1 at_tree=$2
  shift 2
  env GIT_DIR="$at_dir" GIT_COMMON_DIR="$karo/.git" GIT_WORK_TREE="$at_tree" git -C "$at_tree" "$@"
}
# safe_git <git folder> <work tree> <args>: run git there, or stop.
safe_git() {
  sg_dir=$1 sg_tree=$2
  shift 2
  listing=$(git_at "$sg_dir" "$sg_tree" config --list --show-scope --name-only 2>/dev/null) || {
    err=$(git_at "$sg_dir" "$sg_tree" config --list --show-scope --name-only 2>&1 >/dev/null) || true
    stop "git config in $sg_tree failed: $(oneline "$err")"
  }
  bad=$(printf '%s\n' "$listing" |
    awk -F '\t' '$1 == "local" || $1 == "worktree" { print tolower($2) }' |
    grep -Ev '^core\.(repositoryformatversion|filemode|bare|logallrefupdates|ignorecase|precomposeunicode|symlinks)$|^user\.(name|email)$|^submodule\.active$|^remote\..+\.(url|pushurl|fetch|push|prune|tagopt)$|^branch\..+\.[a-z0-9-]+$|^beads\.role$' |
    sort -u | paste -sd ' ' -) || true
  [ -z "$bad" ] || stop "the git config of $sg_tree has keys this command does not allow: $bad"
  { err=$(git_at "$sg_dir" "$sg_tree" "$@" 2>&1 >&3 3>&-); } 3>&1 || stop "git $1 in $sg_tree failed: $(oneline "$err")"
}

# Each git output is assigned before it is tested: a stop inside a command
# substitution ends only the subshell, and set -e then ends the script.
current=$(safe_git "$karo/.git" "$karo" symbolic-ref -q --short HEAD)
[ "$current" = main ] || stop "$karo is on '$current', not main"
changes=$(safe_git "$karo/.git" "$karo" status --porcelain --untracked-files=no --ignore-submodules=all)
[ -z "$changes" ] || stop "$karo has uncommitted changes"

listing=$(safe_git "$karo/.git" "$karo" worktree list --porcelain)
wt=$(printf '%s\n' "$listing" | awk -v b="branch refs/heads/$branch" '/^worktree /{p=substr($0, 10)} $0 == b {print p}')
[ -n "$wt" ] || stop "no worktree of $karo has the branch checked out"
[ -d "$wt" ] || stop "the worktree is not a folder: $wt"
wt=$(cd "$wt" && pwd -P)
[ "${wt%/*}" = "$worktrees" ] || stop "the worktree is not directly in $worktrees: $wt"
# The worktree's git folder is the one in $KARO_HOME/.git/worktrees whose gitdir
# file names it. The files are read as text only; the folder found is a real
# folder directly in $KARO_HOME/.git/worktrees whatever they say.
gitdir=
for d in "$karo"/.git/worktrees/*; do
  { [ -d "$d" ] && [ ! -L "$d" ] && [ -f "$d/gitdir" ]; } || continue
  named=$(sed -n 1p "$d/gitdir")
  named=$(cd "${named%/.git}" 2>/dev/null && pwd -P) || continue
  [ "$named" != "$wt" ] || gitdir=$d
done
[ -n "$gitdir" ] || stop "$wt is not a worktree of $karo"
[ "$(cd "${gitdir%/*}" && pwd -P)" = "$karo/.git/worktrees" ] || stop "$karo/.git/worktrees is not a folder"
{ [ -f "$wt/.git" ] && [ ! -L "$wt/.git" ] && [ "$(sed -n 1p "$wt/.git")" = "gitdir: $gitdir" ]; } ||
  stop "$wt is not a worktree of $karo: its .git does not name $gitdir"
here=$(safe_git "$gitdir" "$wt" symbolic-ref -q HEAD)
[ "$here" = "refs/heads/$branch" ] || stop "$wt is on '$here', not the branch"
changes=$(safe_git "$gitdir" "$wt" status --porcelain --untracked-files=no --ignore-submodules=all)
[ -z "$changes" ] || stop "$wt has uncommitted changes"

if [ "$mode" = rebase ]; then
  if ! out=$(safe_git "$gitdir" "$wt" rebase main 2>&1); then
    conflicts=$(git_at "$gitdir" "$wt" diff --name-only --diff-filter=U 2>/dev/null | paste -sd ' ' -) || true
    git_at "$gitdir" "$wt" rebase --abort >/dev/null 2>&1 || true
    if [ -n "$conflicts" ]; then
      stop "the rebase conflicted and was aborted: $conflicts"
    fi
    stop "git rebase failed and was aborted: $(oneline "$out")"
  fi
  echo "land $branch: rebased onto main at $(git_at "$gitdir" "$wt" rev-parse --short HEAD)"
  exit 0
fi

git_at "$karo/.git" "$karo" merge-base --is-ancestor main "$branch" ||
  stop "main is not an ancestor of the branch; run land $branch --rebase first"
safe_git "$karo/.git" "$karo" merge -q --ff-only "$branch"
echo "land $branch: main fast-forwarded to $(git_at "$karo/.git" "$karo" rev-parse --short HEAD)"
