#!/bin/sh
# Counts one day of CoS and agent work from the Claude Code transcripts and the
# task database (bd, run in COS_DIR), and prints the counts as one JSON object
# for the karo:insights skill.
# It reads only structural fields; the output holds counts, seconds, tokens,
# dollars, session IDs, agent names, times and tool names, never prompt,
# command or result text.
#
# Transcripts come in three groups: cos (the sessions in the project folder of
# COS_DIR), subagents (their <session>/subagents/), and agents (any other
# project's session whose agent-name record starts with a task ID: a Herdr
# agent). A continued session copies earlier records into its new file, so
# records are counted once per uuid within a group. A record belongs to the day
# of its timestamp in the local time zone.
#
# Output keys:
#   turns          CoS turns (one per prompt from the owner, a peer or a task
#                  notification) with tool calls, not counting AskUserQuestion,
#                  Write/Edit to a scratchpad, and runs of the scripts the
#                  skills call as steps (karo's scripts/commit,
#                  scripts/karo-check, and scripts/view-open, the karo land
#                  skill's land, the karo
#                  insights skill's insights, the karrybit crit skill's
#                  crit-open, the karrybit herdr-agent skill's agent-ctl and
#                  agent-report, and every command matching a regular
#                  expression in the uncounted: list of
#                  <cos>/rules/karo.yaml): AGENTS.md leaves the calls a skill
#                  requires out of the CoS's two. A run is a command that
#                  starts with the script's ~ path, the one form AGENTS.md
#                  allows, so a command that only reads a script still counts.
#   over_limit     the turns with more than 2 such calls: session, start time,
#                  kind, calls, and calls per tool.
#   approvals      per group: prompted (a permission dialog was answered yes),
#                  rejected_user, rejected_classifier (auto mode), and
#                  prompt_wait_s (tool call to result for the prompted and
#                  user-rejected calls, run time included). AskUserQuestion is
#                  a question, not a permission, and is left out.
#   agent_prompts  per Herdr agent that waited on a dialog: calls and seconds.
#   cos_turn_s     CoS turn lengths from turn_duration: count, total, max.
#   delegations    the tasks first claimed (started_at) on the day, each with
#                  the first comment or the close after its start, whichever
#                  is earlier, and the minutes in between; ended is null
#                  while it has neither.
#   tokens         per group and model: input, output, cache_read and
#                  cache_creation tokens of the day, one count per API message.
#   session_cost   per session with a cost-state record: when it started and
#                  its running total in dollars. Claude Code writes the total
#                  now and then, not per day, so it is not the day's cost.
#
# usage: insights [YYYY-MM-DD]   (default: today)
# Environment: COS_DIR (default ~/cos), CLAUDE_CONFIG_DIR (default ~/.claude).
set -eu

usage() {
  echo "usage: insights [YYYY-MM-DD]" >&2
  exit 2
}
[ $# -le 1 ] || usage
day=${1:-$(date +%F)}
case $day in
  [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]) ;;
  *) usage ;;
esac
cos=$(cd "${COS_DIR:-$HOME/cos}" && pwd -P)
projects=${CLAUDE_CONFIG_DIR:-$HOME/.claude}/projects
# Claude Code names a project folder after its cwd with every non-alphanumeric
# character replaced by "-".
cosproj=$projects/$(printf '%s' "$cos" | tr -c 'A-Za-z0-9' '-')
uncounted='[]'
[ ! -f "$cos/rules/karo.yaml" ] || uncounted=$(yq -o=json -I=0 '.uncounted // []' "$cos/rules/karo.yaml")

# The $ names below are jq variables, not shell ones.
# shellcheck disable=SC2016
group='
def ts: .timestamp[:19] + "Z" | fromdate;
def day: ts | strflocaltime("%Y-%m-%d");
def hm: ts | strflocaltime("%H:%M");
def session: split("/") | last | sub("\\.jsonl$"; "") | .[:8];
def text: .content | if type == "string" then . else (map(.text? // "") | join("")) end;
def step: test("^~/\\.config/claude/skills/karo/(scripts/(commit|karo-check|view-open)|skills/(land/scripts/land|insights/scripts/insights))( |$)|^~/\\.config/claude/skills/karrybit/skills/(crit/scripts/crit-open|herdr-agent/scripts/(agent-ctl|agent-report))( |$)")
  or (. as $c | any($uncounted[]; . as $re | $c | test($re)));
def counted: .name == "AskUserQuestion" or (.name == "Bash" and (.input.command | tostring | step))
  or ((.name == "Write" or .name == "Edit") and (.input.file_path | tostring | test("/scratchpad/")))
  | not;
[inputs | .f = input_filename] as $all
| [$all | group_by(.f)[] | (map(select(.type == "cost-state")) | last) as $c | select($c)
    | {group: $group, session: (.[0].f | session), name: $name,
       started: ($c.startTime / 1000 | strflocaltime("%Y-%m-%d %H:%M")),
       total_usd: ($c.totalCostUSD * 100 | round / 100)}] as $cost
| (reduce ($all[] | select(.timestamp and day == $day)) as $r ({seen: {}, out: []};
    if $r.uuid and .seen[$r.uuid] then . else .seen[$r.uuid // ""] = true | .out += [$r] end)
  | .out | sort_by(ts)) as $d
| ([$d[] | select(.type == "assistant") | .ts = ts | .message.content[]? as $c
    | select($c.type? == "tool_use") | {key: $c.id, value: {ts, name: $c.name}}] | from_entries) as $uses
| [$d[] | select(.type == "user" and (.message.content | type) == "array") | . as $r
    | .message.content[] | select(.type == "tool_result")
    | select($uses[.tool_use_id].name != "AskUserQuestion")
    | (if $r.permissionDecision.decision? == "reject" and ($r.permissionDecision.reasonCode // "" | startswith("classifier")) then "rejected_classifier"
       elif (text | test("denied by the Claude Code auto mode classifier")) then "rejected_classifier"
       elif (text | test("^The user doesn.t want to proceed")) then "rejected_user"
       elif ($r.permissionDecision.source? // "" | startswith("user_")) then "prompted"
       else empty end) as $k
    | {k: $k, wait: (if $k == "rejected_classifier" then 0 else ($r | ts) - ($uses[.tool_use_id].ts // ($r | ts)) end)}] as $ap
| {group: $group, name: $name, session: ($all[0].f // "" | session),
   approvals: {
     prompted: ($ap | map(select(.k == "prompted")) | length),
     rejected_user: ($ap | map(select(.k == "rejected_user")) | length),
     rejected_classifier: ($ap | map(select(.k == "rejected_classifier")) | length),
     prompt_wait_s: ($ap | map(.wait) | add // 0 | floor)},
   turns: (if $group != "cos" then [] else
     reduce $d[] as $r ([];
       if $r.type == "user" and ($r.message.content | type) == "string" and $r.origin.kind? then
         . + [{session: $r.sessionId[:8], time: ($r | hm), kind: $r.origin.kind, ids: {}}]
       elif $r.type == "assistant" and length > 0 then
         reduce ($r.message.content[]? | select(.type? == "tool_use") | select(counted)) as $u (.; .[-1].ids[$u.id] = $u.name)
       else . end)
     | map({session, time, kind, calls: (.ids | length),
            tools: (.ids | [.[]] | group_by(.) | map({key: .[0], value: length}) | from_entries)}) end),
   turn_ms: [$d[] | select(.type == "system" and .subtype == "turn_duration") | .durationMs],
   tokens: ([$d[] | select(.type == "assistant" and .message.usage and .message.model != "<synthetic>")]
     | group_by(.message.id) | map(last.message)
     | group_by(.model) | map({key: .[0].model, value: {
         input: (map(.usage.input_tokens // 0) | add),
         output: (map(.usage.output_tokens // 0) | add),
         cache_read: (map(.usage.cache_read_input_tokens // 0) | add),
         cache_creation: (map(.usage.cache_creation_input_tokens // 0) | add)}}) | from_entries),
   cost: $cost}
'

summarize() { # <group> <agent-name or ""> <file>...
  g=$1 n=$2
  shift 2
  [ $# -gt 0 ] || return 0
  jq -n -c --arg day "$day" --arg group "$g" --arg name "$n" --argjson uncounted "$uncounted" "$group" "$@"
}

files() { # <dir> <depth>: jsonl files changed since the day began (an older file holds no record of the day)
  [ -d "$1" ] || return 0
  fd -e jsonl --changed-after "$day 00:00:00" --min-depth "$2" --max-depth "$2" . "$1"
}

# bd query takes a bare date in a time zone this script does not set, so it
# takes a day on either side, and the local day of started_at picks the day's
# tasks.
from=$(jq -rn --arg d "$day" '$d + "T00:00:00Z" | fromdate - 86400 | todate[:10]')
to=$(jq -rn --arg d "$day" '$d + "T00:00:00Z" | fromdate + 2 * 86400 | todate[:10]')
started=$(cd "$cos" && bd query "started>=$from AND started<$to" --all --limit 0 --json)
ids=$(printf '%s\n' "$started" | jq -r '.[].id')
shown='[]'
# IDs have no spaces, so the word splitting below is safe.
# shellcheck disable=SC2086
[ -z "$ids" ] || shown=$(cd "$cos" && bd show $ids --json --include-comments)
# shellcheck disable=SC2016
delegations=$(printf '%s\n' "$shown" | jq -c --arg day "$day" '
# bd writes RFC 3339 times, with or without fractional seconds, in UTC or with an offset.
def epoch: capture("^(?<s>[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2})(\\.[0-9]+)?(?<z>Z|[+-][0-9]{2}:[0-9]{2})$") as $t
  | ($t.s + "Z" | fromdate) - (if $t.z == "Z" then 0
      else ($t.z[1:3] | tonumber) * 3600 + ($t.z[4:6] | tonumber) * 60 | if $t.z[0:1] == "-" then -. else . end end);
[.[] | select(.started_at) | (.started_at | epoch) as $s
 | select($s | strflocaltime("%Y-%m-%d") == $day)
 | ([(.comments // [])[].created_at | epoch | select(. >= $s)] + [.closed_at // empty | epoch | select(. >= $s)] | min) as $e
 | {task: .id, delegated: ($s | strflocaltime("%H:%M")), ended: (if $e then $e | strflocaltime("%H:%M") else null end),
    minutes: (if $e then ($e - $s) / 60 | floor else null end), s: $s}]
| sort_by(.s, .task) | map(del(.s))')

{
  # Project folder names have no spaces, so the word splitting below is safe.
  # shellcheck disable=SC2046
  summarize cos "" $(files "$cosproj" 1)
  # shellcheck disable=SC2046
  summarize subagents "" $(files "$cosproj" 3)
  for dir in "$projects"/*/; do
    [ "${dir%/}" = "$cosproj" ] && continue
    for f in $(files "$dir" 1); do
      name=$(jq -r 'select(.type == "agent-name") | .agentName' "$f" | tail -n 1)
      case $name in [A-Za-z]*-?*) summarize agents "$name" "$f" ;; esac
    done
  done
} | jq -s --arg day "$day" --argjson delegations "$delegations" '
def sumobj: reduce .[] as $o ({}; reduce ($o | to_entries[]) as $e (.; .[$e.key] += $e.value));
. as $f
| ($f | map(select(.group == "cos")) | map(.turns) | add // []) as $turns
| {date: $day,
   turns: ($turns | length),
   over_limit: ($turns | map(select(.calls > 2))),
   approvals: ($f | group_by(.group) | map({key: .[0].group, value: (map(.approvals) | sumobj)}) | from_entries),
   agent_prompts: ($f | map(select(.group == "agents" and (.approvals.prompted + .approvals.rejected_user) > 0))
     | map({agent: .name, session, calls: (.approvals.prompted + .approvals.rejected_user), wait_s: .approvals.prompt_wait_s})),
   cos_turn_s: ($f | map(select(.group == "cos")) | map(.turn_ms) | add // [] | map(. / 1000 | floor)
     | {count: length, total: (add // 0), max: (max // 0)}),
   delegations: $delegations,
   tokens: ($f | group_by(.group) | map({key: .[0].group,
     value: (reduce (.[].tokens | to_entries[]) as $e ({}; .[$e.key] = ([.[$e.key] // {}, $e.value] | sumobj)))}) | from_entries),
   session_cost: ($f | map(.cost) | add // [])}
'
