#!/usr/bin/env bash
# shellcheck disable=SC2016,SC2088  # the filters are jq, and the ~ paths are rule text, not paths to expand
# Show that a project's settings.json holds what karo's scripts need from it: karo enabled, the scripts
# a skill runs as one call allowed and kept out of ask and deny, view-open in ask and kept out of allow
# and deny (each open asks first, since the page it opens can run scripts outside the sandbox), and the
# ones that must leave the sandbox in sandbox.excludedCommands. The hooks are karo's own hooks/hooks.json, which Claude Code merges with
# the settings' hooks: it must run call-check by a PreToolUse hook on Bash and post-edit by a
# PostToolUse hook on Edit|Write, and no settings hook may name a karo script or repeat one of its
# commands,
# since that hook would run twice. Each missing value is a FAIL line of its own. The rules use the ~
# form, since permission rules and sandbox.excludedCommands match the command text as written.
# usage: settings-test <settings.json>
set -uo pipefail
exec </dev/null
[[ $# -eq 1 ]] || { echo "usage: settings-test <settings.json>" >&2; exit 2; }
settings=$1
hooks=$(cd "$(dirname "$0")/.." && pwd)/hooks/hooks.json
for f in "$settings" "$hooks"; do
  jq -e 'type == "object"' "$f" >/dev/null 2>&1 || { echo "settings-test: $f is not a JSON object" >&2; exit 2; }
done
failed=0
fail() { printf 'FAIL\t%s\n' "$1"; failed=$((failed+1)); }
pass() { printf 'ok\t%s\n' "$1"; }

# check <name> <file> <jq filter that must give true> [<jq options>...]
check() { if jq -e "${@:4}" "$3" "$2" >/dev/null 2>&1; then pass "$1"; else fail "$1"; fi; }
karo='~/.config/claude/skills/karo'
# hook <event> <matcher wanted> <script>: a hook of the event in hooks.json whose matcher covers the
# wanted one runs the script.
hook() {
  check "a $1 hook on $2 in hooks.json runs $3" "$hooks" '
    any(.hooks[$event][]?; (.matcher // "" | split("|")) as $m | all($want | split("|")[]; . as $w | $m | index($w))
      and any(.hooks[]?; .command // "" | test("\"\\$\\{CLAUDE_PLUGIN_ROOT\\}\"/scripts/" + $script + "( |$)")))' \
    --arg event "$1" --arg want "$2" --arg script "$3"
}

check "karo@skills-dir is enabled" "$settings" '.enabledPlugins["karo@skills-dir"] == true'
for rule in "scripts/commit *" "skills/land/scripts/land *" "scripts/karo-check" "scripts/karo-check *"; do
  check "Bash($karo/$rule) is allowed and in neither ask nor deny" "$settings" '
    any(.permissions.allow[]?; . == "Bash(\($r))")
      and ([.permissions.ask[]?, .permissions.deny[]?] | any(startswith("Bash(" + ($r | rtrimstr(" *")))) | not)' \
    --arg r "$karo/$rule"
done
check "Bash($karo/scripts/view-open *) is in ask and in neither allow nor deny" "$settings" '
  any(.permissions.ask[]?; . == "Bash(\($r))")
    and ([.permissions.allow[]?, .permissions.deny[]?] | any(startswith("Bash(" + ($r | rtrimstr(" *")))) | not)' \
  --arg r "$karo/scripts/view-open *"
for command in "skills/land/scripts/land *" "scripts/view-open *"; do
  check "$karo/$command is in sandbox.excludedCommands" "$settings" 'any(.sandbox.excludedCommands[]?; . == $c)' --arg c "$karo/$command"
done
hook PreToolUse Bash call-check
hook PostToolUse 'Edit|Write' post-edit
check "no settings hook names a karo script or repeats a hooks.json command" "$settings" '
  [$plugin[0].hooks[][].hooks[].command] as $p
  | all(.hooks[]?[]?.hooks[]?.command // ""; (test("skills/karo/scripts/") or IN($p[])) | not)' \
  --slurpfile plugin "$hooks"

echo "settings-test: $failed failure(s)" >&2
[ "$failed" -eq 0 ]
