#!/usr/bin/env bash
# Show that post-edit runs rumdl fmt on each .md written under KARO_HOME and karo-check --only on that file
# alone: a broken record note exits 2 with its problem on stderr, a valid one passes while another note is
# broken, a .md outside the record folders and a hidden path pass, a check that cannot run exits 2 with
# its reason, and a file outside KARO_HOME or reached through .. is left untouched.
# usage: post-edit-test [<karo dir>]   (default KARO_HOME or ~/karo, read only: the vault takes its .rumdl.toml and
#        rule/frontmatter-schema.yaml; the vault goes to a temporary directory and is removed)
set -uo pipefail
exec </dev/null
karo=${1:-${KARO_HOME:-$HOME/karo}}
bin=$(cd "$(dirname "$0")" && pwd)
tmp=$(mktemp -d "${TMPDIR:-/tmp}/post-edit-test.XXXXXX") || exit 2
trap 'rm -rf "$tmp"' EXIT
failed=0
fail() { printf 'FAIL\t%s\n' "$1"; failed=$((failed+1)); }
pass() { printf 'ok\t%s\n' "$1"; }

v=$tmp/karo
export KARO_HOME=$v
mkdir -p "$v/rule"
cp "$karo/.rumdl.toml" "$v/" && cp "$karo/rule/frontmatter-schema.yaml" "$v/rule/" || exit 2
cd "$v" || exit 2

# edit <name> <file> <content> <want exit> <want stderr, or empty for none>: writes the file with a trailing
# space on its last line, passes post-edit a Write's hook input for it, and checks the exit and stderr.
# The file is left for the caller to check rumdl's fix.
edit() {
  local name=$1 f=$2 rc=$4 want=$5 err code
  mkdir -p "$(dirname "$f")" && printf '%s ' "$3" > "$f"
  err=$(jq -n --arg f "$f" '{hook_event_name: "PostToolUse", tool_name: "Write", tool_input: {file_path: $f}}' \
    | "$bin/post-edit" 2>&1 >/dev/null); code=$?
  if [[ $code -eq $rc && ( -z $want && -z $err || -n $want && $err == *"$want"* ) ]]; then pass "$name"; else fail "$name: exit $code: $err"; fi
}
# fixed <name> <file>: rumdl removed the trailing space; kept <name> <file>: it is still there.
fixed() { if ! grep -q ' $' "$2"; then pass "$1"; else fail "$1: trailing space left"; fi; }
kept() { if grep -q ' $' "$2"; then pass "$1"; else fail "$1: file changed"; fi; }

note=$'---\ntype: Standup\ndate: 2026-01-01\n---\n\n## 報告'
edit "a valid record note passes" "$v/standup/2026-01-01.md" "$note" 0 ""
fixed "rumdl formats a record note" "$v/standup/2026-01-01.md"
edit "a broken record note exits 2 with its problem" "$v/standup/2026-01-02.md" $'## 例' 2 $'standup/2026-01-02.md\tno frontmatter'
fixed "rumdl formats a broken record note" "$v/standup/2026-01-02.md"
edit "a .md outside the record folders is not checked" "$v/README.md" $'## 例' 0 ""
fixed "rumdl formats a .md outside the record folders" "$v/README.md"
edit "a worktree under KARO_HOME is not checked" "$v/.claude/worktrees/w/standup/2026-01-02.md" $'## 例' 0 ""
edit "a file that is not .md is left alone" "$v/standup/2026-01-02.txt" $'## 例' 0 ""
kept "rumdl leaves a file that is not .md" "$v/standup/2026-01-02.txt"
mkdir -p "$v/doc" && printf -- '---\ntype: Bogus\n---\n\n## 例\n' > "$v/doc/broken.md"
edit "only the edited file is checked" "$v/standup/2026-01-03.md" "${note//01-01/01-03}" 0 ""
rm "$v/doc/broken.md"
edit "a path that climbs out of KARO_HOME is not checked" "$v/standup/../../wt2/standup/2026-01-02.md" $'## 例' 0 ""
kept "rumdl leaves a path that climbs out of KARO_HOME" "$tmp/wt2/standup/2026-01-02.md"
mv rule/frontmatter-schema.yaml rule/schema.yaml
edit "a check that cannot run exits 2 with its reason" "$v/standup/2026-01-04.md" "${note//01-01/01-04}" 2 "karo-check: no schema"
mv rule/schema.yaml rule/frontmatter-schema.yaml
edit "a file outside KARO_HOME is not checked" "$tmp/wt/standup/2026-01-02.md" $'## 例' 0 ""
kept "rumdl leaves a file outside KARO_HOME" "$tmp/wt/standup/2026-01-02.md"

echo "post-edit-test: $failed failure(s)"
[[ $failed -eq 0 ]]
