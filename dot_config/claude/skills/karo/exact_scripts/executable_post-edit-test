#!/usr/bin/env bash
# Show that post-edit runs rumdl fmt on each .md written in KARO_HOME or a worktree of it and karo-check
# --only on it, and stops only on the written file's problems: a broken record note exits 2 with its
# problem on stderr, in KARO_HOME and in a worktree, a valid one passes while another note is broken, even
# one that reads it, a .md outside the record folders and a hidden path pass, a check that cannot run
# exits 2 with its reason, rumdl leaves the notes that were not edited, and a file outside KARO_HOME, in
# another repository, or reached through .. is left untouched.
# usage: post-edit-test [<karo dir>]   (default KARO_HOME or ~/karo, read only: the vault takes its .rumdl.toml;
#        the vault goes to a temporary directory and is removed)
set -uo pipefail
exec </dev/null
karo=${1:-${KARO_HOME:-$HOME/karo}}
bin=$(cd "$(dirname "$0")" && pwd)
tmp=$(mktemp -d "${TMPDIR:-/tmp}/post-edit-test.XXXXXX") || exit 2
trap 'rm -rf "$tmp"' EXIT
failed=0
fail() { printf 'FAIL\t%s\n' "$1"; failed=$((failed+1)); }
pass() { printf 'ok\t%s\n' "$1"; }

v=$tmp/karo
export KARO_HOME=$v
mkdir -p "$v"
cp "$karo/.rumdl.toml" "$v/" || exit 2
git -C "$v" init -q && git -C "$v" add .rumdl.toml \
  && git -C "$v" -c user.name=test -c user.email=test@example.invalid commit -q -m init || exit 2
cd "$v" || exit 2

# edit <name> <file> <content> <want exit> <want stderr, or empty for none>: writes the file with a trailing
# space on its last line, passes post-edit a Write's hook input for it, and checks the exit and stderr.
# The file is left for the caller to check rumdl's fix.
edit() {
  local name=$1 f=$2 rc=$4 want=$5 err code
  mkdir -p "$(dirname "$f")" && printf '%s ' "$3" > "$f"
  err=$(jq -n --arg f "$f" '{hook_event_name: "PostToolUse", tool_name: "Write", tool_input: {file_path: $f}}' \
    | "${post_edit_bin:-$bin}/post-edit" 2>&1 >/dev/null); code=$?
  if [[ $code -eq $rc && ( -z $want && -z $err || -n $want && $err == *"$want"* ) ]]; then pass "$name"; else fail "$name: exit $code: $err"; fi
}
# fixed <name> <file>: rumdl removed the trailing space; kept <name> <file>: it is still there.
fixed() { if ! grep -q ' $' "$2"; then pass "$1"; else fail "$1: trailing space left"; fi; }
kept() { if grep -q ' $' "$2"; then pass "$1"; else fail "$1: file changed"; fi; }

note=$'---\ntype: Standup\ndescription: 例の日。\ndate: 2026-01-01\ntasks: []\nprojects: []\n---\n\n## 報告'
edit "a valid record note passes" "$v/standup/2026-01-01.md" "$note" 0 ""
fixed "rumdl formats a record note" "$v/standup/2026-01-01.md"
edit "a broken record note exits 2 with its problem" "$v/standup/2026-01-02.md" $'## 例' 2 $'standup/2026-01-02.md\tno frontmatter'
fixed "rumdl formats a broken record note" "$v/standup/2026-01-02.md"
edit "a .md outside the record folders is not checked" "$v/README.md" $'## 例' 0 ""
fixed "rumdl formats a .md outside the record folders" "$v/README.md"
edit "a hidden path under KARO_HOME is not checked" "$v/.claude/worktrees/w/standup/2026-01-02.md" $'## 例' 0 ""
edit "a file that is not .md is left alone" "$v/standup/2026-01-02.txt" $'## 例' 0 ""
kept "rumdl leaves a file that is not .md" "$v/standup/2026-01-02.txt"
mkdir -p "$v/doc" && printf -- '---\ntype: Bogus\n---\n\n## 例\n' > "$v/doc/broken.md"
edit "only the edited file is checked" "$v/standup/2026-01-03.md" "${note//01-01/01-03}" 0 ""
rm "$v/doc/broken.md"
printf -- '---\ntype: Bogus\nderived_from:\n  - standup/2026-01-05.md\n---\n\n## 例\n' > "$v/doc/reader.md"
edit "a broken note that reads the edited file does not stop it" "$v/standup/2026-01-05.md" "${note//01-01/01-05}" 0 ""
rm "$v/doc/reader.md"
edit "a path that climbs out of KARO_HOME is not checked" "$v/standup/../../wt2/standup/2026-01-02.md" $'## 例' 0 ""
kept "rumdl leaves a path that climbs out of KARO_HOME" "$tmp/wt2/standup/2026-01-02.md"
# A copy of this folder whose karo-check is a stub that cannot run stands in for a check that cannot run.
post_edit_bin=$tmp/bin
mkdir -p "$post_edit_bin"
for s in "$bin"/*; do [[ ${s##*/} == karo-check ]] || ln -s "$s" "$post_edit_bin/"; done
printf '#!/bin/sh\necho "karo-check: cannot run yq" >&2\nexit 2\n' > "$post_edit_bin/karo-check" && chmod +x "$post_edit_bin/karo-check"
edit "a check that cannot run exits 2 with its reason" "$v/standup/2026-01-04.md" "${note//01-01/01-04}" 2 "karo-check: cannot run"
post_edit_bin=
edit "a file outside KARO_HOME is not checked" "$tmp/wt/standup/2026-01-02.md" $'## 例' 0 ""
kept "rumdl leaves a file outside KARO_HOME" "$tmp/wt/standup/2026-01-02.md"

# A worktree of the record is checked from its own root: its broken note, which KARO_HOME does not hold,
# exits 2 with its problem. rumdl formats only the edited file, not another note in the worktree.
w=$tmp/worktrees/w
git -C "$v" worktree add -q -b w "$w" || exit 2
mkdir -p "$w/doc" && printf -- '---\ntype: Document\n---\n\n## 例 \n' > "$w/doc/other.md"
edit "a broken note in a worktree of the record exits 2 with its problem" "$w/standup/2026-01-07.md" $'## 例' 2 $'standup/2026-01-07.md\tno frontmatter'
fixed "rumdl formats the edited note in a worktree" "$w/standup/2026-01-07.md"
kept "rumdl leaves a note in the worktree that was not edited" "$w/doc/other.md"
edit "a valid note in a worktree of the record passes" "$w/standup/2026-01-08.md" "${note//01-01/01-08}" 0 ""
git init -q "$tmp/other" || exit 2
edit "a .md in another repository is not checked" "$tmp/other/standup/2026-01-02.md" $'## 例' 0 ""
kept "rumdl leaves a .md in another repository" "$tmp/other/standup/2026-01-02.md"

echo "post-edit-test: $failed failure(s)"
[[ $failed -eq 0 ]]
