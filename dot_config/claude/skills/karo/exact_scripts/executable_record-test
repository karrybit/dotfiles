#!/usr/bin/env bash
# Show that record applies a write instruction exactly and all-or-nothing: in a small git vault, each
# kind of item lands as written and is committed, a bad item leaves the vault and HEAD untouched and
# lands in the problems file, only a later success naming it in 解決 clears it, and two calls at once both commit.
# After a commit that wrote a thread file it runs thread-show (a stub here) on it, and --detach queues
# instructions that a worker applies in order, reporting only through the problems file.
# usage: record-test [<cos dir>]   (default ~/cos, read only: the small vaults take its .rumdl.toml and
#        rules/frontmatter-schema.yaml, and the instructions of its rules/record-examples.md are run; the
#        vaults, state, and problems file go to a temporary directory and are removed)
set -uo pipefail
# Each record call gets its instruction through an explicit redirect; nothing else reads the caller's stdin.
exec </dev/null
cos=${1:-$HOME/cos}
bin=$(cd "$(dirname "$0")" && pwd)
tmp=$(mktemp -d "${TMPDIR:-/tmp}/record-test.XXXXXX") || exit 2
trap 'rm -rf "$tmp"' EXIT
failed=0
fail() { printf 'FAIL\t%s\n' "$1"; failed=$((failed+1)); }
pass() { printf 'ok\t%s\n' "$1"; }

v=$tmp/cos
export COS_DIR=$v COS_RECORD_STATE=$tmp/state COS_RECORD_PROBLEMS=$tmp/problems.md
# thread-show would reach for the real Herdr panes; the stub records each call and fails on request.
printf '#!/bin/sh\nprintf "%%s\\n" "$1" >> "%s/shown"\n[ -z "${STUB_FAIL:-}" ] || { echo "not sending keys"; exit 1; }\n' "$tmp" > "$tmp/thread-show"
chmod +x "$tmp/thread-show"
export COS_THREAD_SHOW=$tmp/thread-show
mkdir -p "$v"/{journal,projects,threads,investigations,rules}
cp "$cos/.rumdl.toml" "$v/" && cp "$cos/rules/frontmatter-schema.yaml" "$v/rules/" || exit 2
mkdir -p "$v/tasks"
printf -- '---\ntype: Task\ndescription: 例\ndate: 2026-01-01\ntasks:\n  - t-test0001\nprojects:\n  - demo\nstate: delegated\n---\n' > "$v/tasks/t-test0001.md"
printf -- '---\ntype: Journal\ndate: 2026-01-01\n---\n\n- 09:00 [note] t-test0001: 例（thread 2026-01-01 09:00）\n' > "$v/journal/2026-01-01.md"
# The project note also holds a table for the 行: cases and takes the appends whose target does not matter.
printf -- '---\ntype: Project\ndescription: 例のプロジェクト。\nprojects:\n  - demo\n---\n\n## demo\n\n| ID | 状態 |\n| --- | --- |\n| t-test0001 | delegated |\n' > "$v/projects/demo.md"
git -C "$v" init -q && git -C "$v" config user.name test && git -C "$v" config user.email test@example.invalid
git -C "$v" add -A && git -C "$v" commit -q -m init || exit 2

run() { out=$("$bin/record" 2>&1); code=$?; last=${out##*$'\n'}; }
# copy_of <subject>: the name of the instruction copy the latest NG entry for the subject names.
copy_of() { rg -F -- "- " "$COS_RECORD_PROBLEMS" | rg -F -- " $1: " | rg -o '指示の写し: [^）]+' | tail -n 1 | sed 's/^指示の写し: //'; }
head_sha() { git -C "$v" rev-parse --short HEAD; }
clean() { [[ -z $(git -C "$v" status --porcelain) ]]; }

# append, new, replace, and take in, with {日付} and {時刻}, in one commit
printf -- '---\ntype: Investigation\ndescription: 例の調べ物。\ndate: 2026-01-01\nprojects:\n  - demo\nsources:\n  - https://example.invalid\n---\n\n## 例\n' > "$v/investigations/2026-01-01-demo.md"
run <<'EOF'
書き込み指示
commit 件名: t-test0001: record the demo
commit 本文:
~~~~
Because the test says so ({日付}).
~~~~

追記: journal/2026-01-01.md
~~~~
- {時刻} [note] t-test0001: 追記した（会話 {日付} {時刻}）
~~~~

新規: threads/t-test0001-demo.md
タスク: t-test0001
~~~~
---
type: Thread
description: 例の会話
topic: 例
date: {日付}
tasks:
  - t-test0001
projects:
  - demo
---

### オーナー · {日付} {時刻}

本文
~~~~

置き換え: tasks/t-test0001.md
~~~~
state: delegated
~~~~
~~~~
state: in-review
~~~~

取り込み: investigations/2026-01-01-demo.md
EOF
now=$(date '+%Y-%m-%d')
if [[ $code -eq 0 && $last == "OK $(head_sha) t-test0001: record the demo" ]] && clean; then pass "applies and commits"; else fail "applies and commits: exit $code: $out"; fi
if [[ $(tail -n 1 "$v/journal/2026-01-01.md") =~ ^-\ [0-9]{2}:[0-9]{2}\ \[note\]\ t-test0001:\ 追記した（会話\ $now\ [0-9]{2}:[0-9]{2}）$ ]]; then pass "appends with {日付} and {時刻} filled"; else fail "append: $(tail -n 2 "$v/journal/2026-01-01.md")"; fi
if [[ $(tail -c 1 "$v/threads/t-test0001-demo.md" | od -An -c | tr -d ' ') == '\n' && $(tail -n 1 "$v/threads/t-test0001-demo.md") == 本文 ]] && rg -q "^date: $now$" "$v/threads/t-test0001-demo.md"; then pass "creates the new file with one final newline"; else fail "new file: $(cat "$v/threads/t-test0001-demo.md")"; fi
if rg -qx 'state: in-review' "$v/tasks/t-test0001.md" && ! rg -qF 'delegated' "$v/tasks/t-test0001.md"; then pass "replaces"; else fail "replace: $(cat "$v/tasks/t-test0001.md")"; fi
if git -C "$v" show --name-only --format= HEAD | rg -qx 'investigations/2026-01-01-demo.md'; then pass "takes in the file written elsewhere"; else fail "take in: $(git -C "$v" show --stat HEAD)"; fi
if git -C "$v" log -1 --format=%b | rg -qF "Because the test says so ($now)."; then pass "commit body as given"; else fail "commit body: $(git -C "$v" log -1 --format=%B)"; fi
if [[ $(fd -t f -e txt . "$tmp/state" | wc -l | tr -d ' ') -eq 1 ]] && rg -qF '{日付}' "$tmp/state"/*.txt && rg -q '^# OK ' "$tmp/state"/*.txt; then pass "keeps the instruction and its result"; else fail "instruction log: $(ls "$tmp/state")"; fi
if [[ $(cat "$tmp/shown" 2>/dev/null) == "$(cd "$v" && pwd -P)/threads/t-test0001-demo.md" ]]; then pass "shows the thread file it wrote"; else fail "thread-show calls: $(cat "$tmp/shown" 2>/dev/null)"; fi

# karo-check sees only the staged files and the notes that depend on them: a problem already in another
# note does not block a commit, and taking in a deletion that a note still names is an NG.
mkdir -p "$v/investigations/demo/sources"
printf 'raw\n' > "$v/investigations/demo/sources/ref.md"
printf -- '---\ntype: Investigation\ndescription: 参照する調べ物。\ndate: 2026-01-01\nprojects:\n  - demo\nderived_from:\n  - investigations/demo/sources/ref.md\n---\n\n## 参照\n' > "$v/investigations/2026-01-02-ref.md"
printf -- '---\ntype: Investigation\ndescription: 壊れた調べ物。\ndate: 2026-01-01\nprojects:\n  - nope\nsources:\n  - https://example.invalid\n---\n\n## 壊れた\n' > "$v/investigations/2026-01-03-broken.md"
git -C "$v" add -A && git -C "$v" commit -q -m 'add notes for the scoped check'
run <<'EOF'
書き込み指示
commit 件名: t-test0001: append beside a broken note
commit 本文:
~~~~
why
~~~~
追記: journal/2026-01-01.md
~~~~
- 12:00 [ask] t-test0001: 壊れたノートの横で書いた（会話 2026-01-01 12:00）
~~~~
EOF
if [[ $code -eq 0 && $last == "OK "* ]]; then pass "a problem in an unchanged note does not block"; else fail "unchanged broken note: exit $code: $out"; fi
rm "$v/investigations/demo/sources/ref.md"
before=$(head_sha)
run <<'EOF'
書き込み指示
commit 件名: t-test0001: take in a deletion still named
commit 本文:
~~~~
why
~~~~
取り込み: investigations/demo/sources
EOF
if [[ $code -eq 1 && $last == *"derived_from missing: investigations/demo/sources/ref.md"* && $(head_sha) == "$before" ]] && [[ -z $(git -C "$v" diff --cached --name-only) ]]; then
  pass "a deleted file still named by a note is an NG"
else
  fail "deleted and named: exit $code: $out"
fi
git -C "$v" checkout -q -- investigations/demo/sources/ref.md
git -C "$v" rm -q investigations/2026-01-03-broken.md && git -C "$v" commit -q -m 'drop the broken note'

# An HTML explanation's index.html and index.md, written elsewhere, are taken in as they are; the .html is not formatted or checked for frontmatter.
mkdir -p "$v/docs/a1b2c3d4/abc1234"
printf '<!doctype html>\n<title>例</title>\n<p>  本文</p>\n' > "$v/docs/a1b2c3d4/abc1234/index.html"
printf -- '---\ntype: Explain\ndescription: 例の解説。\ntasks:\n  - t-test0001\nprojects:\n  - demo\nresource: https://example.invalid/demo\nderived_from:\n  - journal/2026-01-01.md#09:00\n---\n\n## 例\n' > "$v/docs/a1b2c3d4/abc1234/index.md"
html_before=$(cat "$v/docs/a1b2c3d4/abc1234/index.html")
run <<'EOF2'
書き込み指示
commit 件名: t-test0001: take in the explanation
commit 本文:
~~~~
why
~~~~
取り込み: docs/a1b2c3d4/abc1234/index.html
取り込み: docs/a1b2c3d4/abc1234/index.md
EOF2
if [[ $code -eq 0 && $last == "OK "* ]] && clean && [[ $(git -C "$v" show --name-only --format= HEAD | sort | tr '\n' ' ') == "docs/a1b2c3d4/abc1234/index.html docs/a1b2c3d4/abc1234/index.md " && $(cat "$v/docs/a1b2c3d4/abc1234/index.html") == "$html_before" ]]; then
  pass "takes in an explanation's index.html and index.md"
else
  fail "explanation take in: exit $code: $out"
fi

# A bad item anywhere writes nothing, leaves HEAD alone, and is reported in the problems file.
# <name>|<expected reason>|<items>
cases=(
  'replace matching nothing|置き換え: tasks/t-test0001.md: 一致が 0 か所|追記: journal/2026-01-01.md\n~~~~\n- 10:00 [note] t-test0001: 書かれない（会話 2026-01-01 10:00）\n~~~~\n置き換え: tasks/t-test0001.md\n~~~~\nない行\n~~~~\n~~~~\n新しい行\n~~~~'
  'replace matching twice|置き換え: journal/2026-01-01.md: 一致が 2 か所|置き換え: journal/2026-01-01.md\n~~~~\n[note] t-test0001\n~~~~\n~~~~\n[note] t-test0002\n~~~~'
  'new over an existing file|新規: tasks/t-test0001.md: ファイルがもうある|新規: tasks/t-test0001.md\n~~~~\nx\n~~~~'
  'append to a missing file|追記: investigations/2026-01-09-missing.md: ファイルがない|追記: investigations/2026-01-09-missing.md\n~~~~\nx\n~~~~'
  'path outside the record|記録の書き先でない: AGENTS.md|新規: AGENTS.md\n~~~~\nx\n~~~~'
  'task ledger file|記録の書き先でない: tasks.md|追記: tasks.md\n~~~~\nx\n~~~~'
  'path escaping the vault|記録の書き先でない: journal/../../x.md|新規: journal/../../x.md\n~~~~\nx\n~~~~'
  'take in with nothing to commit|取り込み: projects/demo.md: 未 commit の変更がない|取り込み: projects/demo.md'
  'take in outside the record|記録の書き先でない: notes/a.html|取り込み: notes/a.html'
  'unclosed body|本文を閉じる ~~~~ の行がない|追記: projects/demo.md\n~~~~\nx'
  'karo-check problem rolls back|karo-check: journal/2026-01-02.md	no frontmatter|追記: projects/demo.md\n~~~~\n\nx\n~~~~\n新規: journal/2026-01-02.md\n~~~~\n## no frontmatter\n~~~~'
  'diff --check problem rolls back|git diff --cached --check|新規: investigations/demo/sources/a.md\n~~~~\ntrailing \n~~~~'
)
for c in "${cases[@]}"; do
  name=${c%%|*}; rest=${c#*|}; want=${rest%%|*}; items=${rest#*|}
  before=$(head_sha)
  run < <(printf '書き込み指示\ncommit 件名: t-test0001: bad %s\ncommit 本文:\n~~~~\nwhy\n~~~~\n%b\n' "$name" "$items")
  if [[ $code -eq 1 && $last == "NG t-test0001: bad $name: "*"$want"* && $(head_sha) == "$before" ]] && clean && [[ ! -e $v/journal/2026-01-02.md ]] \
     && rg -qF -- "t-test0001: bad $name: " "$COS_RECORD_PROBLEMS"; then
    pass "$name"
  else
    fail "$name: exit $code, want /$want/, HEAD $before -> $(head_sha): $out $(git -C "$v" status --porcelain)"
  fi
done

# A karo-check NG prints each of its lines verbatim above the NG line, so the CoS can compare them
# with a full karo-check of the untouched vault.
run <<'EOF'
書き込み指示
commit 件名: t-test0001: two karo-check problems
commit 本文:
~~~~
why
~~~~
新規: journal/2026-01-02.md
~~~~
## no frontmatter
~~~~
新規: journal/2026-01-03.md
~~~~
## no frontmatter either
~~~~
EOF
if [[ $code -eq 1 && $last == "NG t-test0001: two karo-check problems: karo-check: "* ]] \
   && printf '%s\n' "$out" | rg -qx $'journal/2026-01-02.md\tno frontmatter' && printf '%s\n' "$out" | rg -qx $'journal/2026-01-03.md\tno frontmatter'; then
  pass "karo-check lines printed verbatim above the NG"
else
  fail "karo-check lines: exit $code: $out"
fi

# record runs outside the sandbox, so a repository config naming a command (here a clean filter that git
# add would run) stops it before anything is written or run.
printf '*.md filter=pwn\n' > "$v/.git/info/attributes"
git -C "$v" config filter.pwn.clean "touch $tmp/pwned; cat"
before=$(head_sha)
run <<'EOF'
書き込み指示
commit 件名: t-test0001: blocked by the git config
commit 本文:
~~~~
why
~~~~
追記: projects/demo.md
~~~~
x
~~~~
EOF
crit_out=$("$bin/record" --restart-crit 2>&1)
# The test's own git calls below would run the filter too, so the marker is read before them.
ran=no; [[ -e $tmp/pwned ]] && ran=yes
git -C "$v" config --unset filter.pwn.clean
rm "$v/.git/info/attributes"
if [[ $code -eq 1 && $last == *"git の設定に record が許していない項目がある"*"filter.pwn.clean"* && $ran == no && $(head_sha) == "$before" ]] && clean; then
  pass "a repository config that runs a command is refused"
else
  fail "git config: exit $code, filter ran: $ran: $out"
fi
if ! command -v crit >/dev/null; then
  printf 'skip\t--restart-crit with the git config: no crit on PATH, so record does nothing about crit\n'
elif [[ ${crit_out##*$'\n'} == "NG crit: "*"filter.pwn.clean"* && $ran == no ]]; then pass "--restart-crit refuses it too"; else fail "--restart-crit with the git config: $crit_out"; fi
# A commondir file in .git would point git at another config (and other refs), so record refuses it.
before=$(head_sha)
cp -R "$v/.git" "$tmp/other-git"
printf '*.md filter=pwn\n' > "$tmp/other-git/info/attributes"
git --git-dir="$tmp/other-git" config filter.pwn.clean "touch $tmp/pwned; cat"
printf '%s\n' "$tmp/other-git" > "$v/.git/commondir"
run <<'EOF'
書き込み指示
commit 件名: t-test0001: commondir points elsewhere
commit 本文:
~~~~
why
~~~~
追記: projects/demo.md
~~~~
x
~~~~
EOF
ran=no; [[ -e $tmp/pwned ]] && ran=yes
rm "$v/.git/commondir"
if [[ $code -eq 1 && $last == *"ほかのリポジトリを指すファイルがある"*"commondir"* && $ran == no && $(head_sha) == "$before" ]] && clean; then
  pass "a commondir file in .git is refused"
else
  fail "commondir: exit $code, filter ran: $ran: $out"
fi

# Any key outside the allowed set is refused, not only the ones known to run a command.
git -C "$v" config core.alternateRefsCommand "touch $tmp/pwned"
run <<'EOF'
書き込み指示
commit 件名: t-test0001: blocked by another key
commit 本文:
~~~~
why
~~~~
追記: projects/demo.md
~~~~
x
~~~~
EOF
git -C "$v" config --unset core.alternateRefsCommand
if [[ $code -eq 1 && $last == *"core.alternaterefscommand"* ]] && clean; then pass "a key outside the allowed set is refused"; else fail "allowlist: exit $code: $out"; fi

# extensions.worktreeConfig would make git read .git/config.worktree, which the sandbox can write.
git -C "$v" config extensions.worktreeConfig true
run <<'EOF'
書き込み指示
commit 件名: t-test0001: blocked by worktree config
commit 本文:
~~~~
why
~~~~
追記: projects/demo.md
~~~~
x
~~~~
EOF
git -C "$v" config --unset extensions.worktreeConfig
if [[ $code -eq 1 && $last == *"extensions.worktreeconfig"* ]] && clean; then pass "extensions.worktreeConfig is refused"; else fail "worktreeConfig: exit $code: $out"; fi

# Every git record runs names the common folder, so a commondir file planted after the config check
# (here with the check bypassed, as if the file came between the check and the git) is not followed.
toctou=$(PYTHONDONTWRITEBYTECODE=1 python3 - "$bin/record" "$v/.git/commondir" "$tmp/other-git" "$tmp/pwned" <<'PY'
import importlib.machinery, importlib.util, os, sys
loader = importlib.machinery.SourceFileLoader("record", sys.argv[1])
record = importlib.util.module_from_spec(importlib.util.spec_from_loader("record", loader))
loader.exec_module(record)
record.check_git_config()
record.check_git_config = lambda: None
with open(sys.argv[2], "w") as f:
    f.write(sys.argv[3] + "\n")
record.git("hash-object", "projects/demo.md")
print("followed" if os.path.exists(sys.argv[4]) else "not followed")
PY
)
rm "$v/.git/commondir"
if [[ $toctou == "not followed" ]]; then pass "a commondir file planted after the check is not followed"; else fail "commondir after the check: $toctou"; fi
rm -f "$tmp/pwned"

# crit's daemon outlives record and runs git long after the check, so it gets the same environment: a
# stub crit whose daemon plants a commondir file once it is up, then runs git, does not reach the filter.
mkdir -p "$tmp/fakecrit"
cat > "$tmp/fakecrit/crit" <<EOF
#!/bin/sh
case \$1 in
  status) echo '{"daemon": {"running": true}, "sessions": [{"args": ["."]}]}' ;;
  .) printf '%s\n' "$tmp/other-git" > .git/commondir; git hash-object projects/demo.md >/dev/null 2>&1; : > "$tmp/fakecrit/done" ;;
esac
EOF
chmod +x "$tmp/fakecrit/crit"
out=$(PATH=$tmp/fakecrit:$PATH "$bin/record" --restart-crit 2>&1)
for _ in $(seq 50); do [[ -e $tmp/fakecrit/done ]] && break; sleep 0.1; done
ran=no; [[ -e $tmp/pwned ]] && ran=yes
rm -f "$v/.git/commondir" "$tmp/pwned"
if [[ $out == "OK crit: 起動し直した" && -e $tmp/fakecrit/done && $ran == no ]]; then
  pass "crit's daemon does not follow a commondir file planted after it started"
else
  fail "crit daemon env: $out, daemon ran: $([[ -e $tmp/fakecrit/done ]] && echo yes || echo no), filter ran: $ran"
fi

# The new-then-append ordering inside one instruction: the diff --check case above fails only on the
# trailing space, so the same items without it must succeed. Its 解決 lines, naming the copies of the
# failed instructions, clear those entries.
c1=$(copy_of 't-test0001: bad replace matching nothing'); c2=$(copy_of 't-test0001: bad diff --check problem rolls back')
run <<EOF
書き込み指示
commit 件名: t-test0001: bad diff --check problem rolls back
commit 本文:
~~~~
fixed
~~~~
解決: $c1
解決: $c2

新規: investigations/demo/sources/a.md
~~~~
x
~~~~

追記: investigations/demo/sources/a.md
~~~~
y
~~~~
EOF
if [[ $code -eq 0 && $(cat "$v/investigations/demo/sources/a.md") == $'x\ny' ]] && ! rg -qF 't-test0001: bad diff --check' "$COS_RECORD_PROBLEMS" && ! rg -qF 't-test0001: bad replace matching nothing' "$COS_RECORD_PROBLEMS" \
   && rg -qF 't-test0001: bad new over an existing file' "$COS_RECORD_PROBLEMS"; then
  pass "success clears the 解決 entries"
else
  fail "resolve: exit $code: $out: $(cat "$COS_RECORD_PROBLEMS")"
fi

# Two calls at once both commit, one after the other.
before=$(git -C "$v" rev-list --count HEAD)
for n in 1 2; do
  printf '書き込み指示\ncommit 件名: parallel %s\ncommit 本文:\n~~~~\nwhy\n~~~~\n追記: journal/2026-01-01.md\n~~~~\n- 11:0%s [note] t-test0001: 並べた（会話 2026-01-01 11:00）\n~~~~\n' "$n" "$n" |
    "$bin/record" > "$tmp/par$n" 2>&1 &
done
wait
if [[ $(git -C "$v" rev-list --count HEAD) -eq $((before+2)) ]] && rg -q '^OK ' "$tmp/par1" && rg -q '^OK ' "$tmp/par2" && clean; then
  pass "two calls at once both commit"
else
  fail "parallel: $(cat "$tmp/par1" "$tmp/par2")"
fi

# A non-ASCII file name reaches karo-check as it is (git would quote it without -z).
run <<'EOF'
書き込み指示
commit 件名: t-test0001: a broken note with a Japanese name
commit 本文:
~~~~
why
~~~~
新規: investigations/2026-01-04-日本語.md
~~~~
---
type: Bogus
---

## 日本語
~~~~
EOF
if [[ $code -eq 1 ]] && printf '%s\n' "$out" | rg -qx $'investigations/2026-01-04-日本語.md\tunknown type: Bogus' && clean; then
  pass "a Japanese file name is checked"
else
  fail "Japanese name: exit $code: $out"
fi

# A symlink in a record folder cannot lead record (outside the sandbox) to a file or folder outside the record.
printf 'keep\n' > "$v/outside.txt"
ln -s ../outside.txt "$v/journal/link.md"
ln -s .. "$v/investigations/up"
run <<'EOF'
書き込み指示
commit 件名: t-test0001: replace through a link
commit 本文:
~~~~
why
~~~~
置き換え: journal/link.md
~~~~
keep
~~~~
~~~~
changed
~~~~
EOF
code1=$code; last1=$last
run <<'EOF'
書き込み指示
commit 件名: t-test0001: create through a folder link
commit 本文:
~~~~
why
~~~~
新規: investigations/up/AGENTS.md
~~~~
x
~~~~
EOF
if [[ $code1 -eq 1 && $last1 == *"シンボリックリンクを通る"* && $code -eq 1 && $last == *"シンボリックリンクを通る"* \
      && $(cat "$v/outside.txt") == keep && ! -e $v/AGENTS.md ]]; then
  pass "symlinks out of the record are refused"
else
  fail "symlinks: $last1 / $last"
fi
rm "$v/outside.txt" "$v/journal/link.md" "$v/investigations/up"

# A folder swapped for a link after the path check is still not followed: with record_path's check
# bypassed, writing, reading, and removing through the link all stop at the link.
mkdir -p "$tmp/elsewhere" "$v/investigations/swap"
printf 'keep\n' > "$tmp/elsewhere/a.md"
rmdir "$v/investigations/swap" && ln -s "$tmp/elsewhere" "$v/investigations/swap"
swap=$(PYTHONDONTWRITEBYTECODE=1 python3 - "$bin/record" <<'PY'
import importlib.machinery, importlib.util, os, sys
loader = importlib.machinery.SourceFileLoader("record", sys.argv[1])
record = importlib.util.module_from_spec(importlib.util.spec_from_loader("record", loader))
loader.exec_module(record)
record.record_path = os.path.normpath  # as if the check had passed before the swap
for name, call in [("write", lambda: record.write_file("investigations/swap/a.md", b"changed\n")),
                   ("read", lambda: record.read_file("investigations/swap/a.md")),
                   ("remove", lambda: record.remove_file("investigations/swap/a.md"))]:
    try:
        call()
        print(f"{name}: followed")
    except record.Bad:
        print(f"{name}: refused")
PY
)
rm "$v/investigations/swap"
if [[ $swap == $'write: refused\nread: refused\nremove: refused' && $(cat "$tmp/elsewhere/a.md") == keep ]]; then
  pass "a folder swapped for a link is not followed"
else
  fail "swapped folder: $swap, elsewhere: $(cat "$tmp/elsewhere/a.md" 2>&1)"
fi

# A hard link from a record folder to a file elsewhere is neither read nor written through: an
# instruction on it is an NG, and a write (with the read bypassed) replaces the name instead.
printf 'keep\n' > "$tmp/elsewhere/h.md"
ln "$tmp/elsewhere/h.md" "$v/journal/h.md"
run <<'EOF'
書き込み指示
commit 件名: t-test0001: append through a hard link
commit 本文:
~~~~
why
~~~~
追記: journal/h.md
~~~~
changed
~~~~
EOF
hard=$(PYTHONDONTWRITEBYTECODE=1 python3 - "$bin/record" <<'PY'
import importlib.machinery, importlib.util, sys
loader = importlib.machinery.SourceFileLoader("record", sys.argv[1])
record = importlib.util.module_from_spec(importlib.util.spec_from_loader("record", loader))
loader.exec_module(record)
record.write_file("journal/h.md", b"written\n")
print("written")
PY
)
if [[ $code -eq 1 && $last == *"ハードリンクがある"* && $hard == written && $(cat "$tmp/elsewhere/h.md") == keep && $(cat "$v/journal/h.md") == written ]]; then
  pass "a hard link out of the record is not read or written through"
else
  fail "hard link: exit $code: $last / $hard / elsewhere: $(cat "$tmp/elsewhere/h.md")"
fi
rm "$v/journal/h.md"

# git add reads what 取り込み stages, so a hard link to a file elsewhere, given or under a given folder,
# and a symbolic link under a given folder are NGs, and nothing is committed.
take_in() { printf '書き込み指示\ncommit 件名: t-test0001: take in %s\ncommit 本文:\n~~~~\nwhy\n~~~~\n取り込み: %s\n' "$1" "$1"; }
printf 'secret\n' > "$tmp/elsewhere/t.md"
before=$(head_sha)
ln "$tmp/elsewhere/t.md" "$v/investigations/demo/sources/hard.md"
run < <(take_in investigations/demo/sources/hard.md); code1=$code; last1=$last
run < <(take_in investigations/demo/sources); code2=$code; last2=$last
rm "$v/investigations/demo/sources/hard.md"
ln -s "$tmp/elsewhere/t.md" "$v/investigations/demo/sources/link.md"
run < <(take_in investigations/demo/sources); code3=$code; last3=$last
rm "$v/investigations/demo/sources/link.md"
if [[ $code1 -eq 1 && $last1 == *"ハードリンクがある"*"sources/hard.md" && $code2 -eq 1 && $last2 == *"ハードリンクがある"*"sources/hard.md" \
      && $code3 -eq 1 && $last3 == *"シンボリックリンクを通る"*"sources/link.md" && $(head_sha) == "$before" ]] && clean; then
  pass "取り込み refuses a hard link and a symbolic link"
else
  fail "取り込み links: $last1 / $last2 / $last3"
fi

# rumdl tidies what record wrote: trailing spaces would otherwise fail diff --check.
printf '書き込み指示\ncommit 件名: t-test0001: trailing spaces\ncommit 本文:\n~~~~\nwhy\n~~~~\n追記: journal/2026-01-01.md\n~~~~\n- 13:00 [ask] t-test0001: 行末に空白（会話 2026-01-01 13:00）  \n~~~~\n' > "$tmp/instr"
run < "$tmp/instr"
if [[ $code -eq 0 && $(tail -n 1 "$v/journal/2026-01-01.md") == "- 13:00 [ask] t-test0001: 行末に空白（会話 2026-01-01 13:00）" ]] && clean; then
  pass "rumdl formats the written files"
else
  fail "rumdl: exit $code: $out: $(tail -n 1 "$v/journal/2026-01-01.md" | od -c | tail -n 3)"
fi

# A multi-line failure (git's author-identity message) still ends with the NG line, and the problems
# file keeps one line per entry.
git -C "$v" config --unset user.name; git -C "$v" config --unset user.email
out=$(printf '書き込み指示\ncommit 件名: t-test0001: no identity\ncommit 本文:\n~~~~\nwhy\n~~~~\n追記: projects/demo.md\n~~~~\nx\n~~~~\n' |
  GIT_CONFIG_GLOBAL=/dev/null GIT_AUTHOR_NAME= GIT_COMMITTER_NAME= EMAIL= "$bin/record" 2>&1); code=$?; last=${out##*$'\n'}
git -C "$v" config user.name test; git -C "$v" config user.email test@example.invalid
if [[ $code -eq 1 && $last == "NG t-test0001: no identity: git commit が失敗: "* && $(printf '%s\n' "$out" | wc -l) -gt 1 ]] \
   && ! rg -v '^(## |- |$)' "$COS_RECORD_PROBLEMS" >/dev/null && clean; then
  pass "a multi-line failure ends with one NG line"
else
  fail "multi-line: exit $code: $out: $(cat "$COS_RECORD_PROBLEMS")"
fi

# A failure after the commit does not undo it: the result stays OK and the cleanup failure has its own line.
before=$(head_sha)
out=$(printf '書き込み指示\ncommit 件名: t-test0001: cleanup fails\ncommit 本文:\n~~~~\nwhy\n~~~~\n追記: projects/demo.md\n~~~~\ny\n~~~~\n' |
  COS_RECORD_PROBLEMS=$tmp "$bin/record" 2>&1); code=$?; last=${out##*$'\n'}
if [[ $code -eq 0 && $last == "OK $(head_sha) t-test0001: cleanup fails" && $(head_sha) != "$before" ]] \
   && printf '%s\n' "$out" | rg -q '^record: commit のあとの後始末に失敗' && [[ $(tail -n 1 "$v/projects/demo.md") == y ]] && clean; then
  pass "a failure after the commit keeps the commit"
else
  fail "after commit: exit $code: $out"
fi

# Without a commit body the journal lines become the body; with neither the instruction is an NG.
out=$(printf '書き込み指示\ncommit 件名: t-test0001: no body\n\n追記: journal/2026-01-01.md\n~~~~\n- 14:00 [note] t-test0001: 本文なし（会話 2026-01-01 14:00）\n~~~~\n' | "$bin/record" 2>&1); code=$?
if [[ $code -eq 0 && $(git -C "$v" log -1 --format=%b) == "- 14:00 [note] t-test0001: 本文なし（会話 2026-01-01 14:00）" ]]; then pass "the journal line becomes the body"; else fail "no body: exit $code: $out: $(git -C "$v" log -1 --format=%B)"; fi
before=$(head_sha)
out=$(printf '書き込み指示\ncommit 件名: t-test0001: no body no journal\n\n追記: projects/demo.md\n~~~~\nz\n~~~~\n' | "$bin/record" 2>&1); code=$?; last=${out##*$'\n'}
if [[ $code -eq 1 && $last == "NG t-test0001: no body no journal: 「commit 本文:」がなく、journal の行もない" && $(head_sha) == "$before" ]] && clean; then pass "no body and no journal line is an NG"; else fail "no body no journal: exit $code: $out"; fi

# An instruction that changes nothing (state.md rewritten from unchanged task files) is an OK without a commit.
before=$(head_sha)
row=$(rg '^\| t-test0001 ' "$v/projects/demo.md")
out=$(printf '書き込み指示\ncommit 件名: t-test0001: nothing changes\ncommit 本文:\n~~~~\nwhy\n~~~~\n置き換え: projects/demo.md\n~~~~\n%s\n~~~~\n~~~~\n%s\n~~~~\n' "$row" "$row" | "$bin/record" 2>&1); code=$?; last=${out##*$'\n'}
if [[ $code -eq 0 && $last == "OK - t-test0001: nothing changes（変更なし）" && $(head_sha) == "$before" ]] && clean; then pass "an instruction that changes nothing is an OK without a commit"; else fail "no change: exit $code: $out"; fi

# An append to a day's journal that does not exist yet creates it with its frontmatter and heading.
out=$(printf '書き込み指示\ncommit 件名: t-test0001: new day\n\n追記: journal/2026-01-05.md\n~~~~\n- 09:00 [note] t-test0001: 新しい日（会話 2026-01-05 09:00）\n~~~~\n' | "$bin/record" 2>&1); code=$?
if [[ $code -eq 0 && $(cat "$v/journal/2026-01-05.md") == $'---\ntype: Journal\ndate: 2026-01-05\n---\n\n## 2026-01-05\n\n- 09:00 [note] t-test0001: 新しい日（会話 2026-01-05 09:00）' ]] && clean; then pass "an append creates a missing day's journal"; else fail "new day: exit $code: $out: $(cat "$v/journal/2026-01-05.md" 2>/dev/null)"; fi

# 行: sets named cells of the one row whose first cell is the ID, and refuses what it cannot place.
out=$(printf '書き込み指示\ncommit 件名: t-test0001: set a cell\n\n行: projects/demo.md t-test0001\n~~~~\n状態: done\n~~~~\n追記: journal/2026-01-01.md\n~~~~\n- 15:00 [close] t-test0001: 閉じた（会話 2026-01-01 15:00）\n~~~~\n' | "$bin/record" 2>&1); code=$?
row=$(rg '^\| t-test0001 ' "$v/projects/demo.md")
if [[ $code -eq 0 && $row == "| t-test0001 | done |" ]] && clean; then pass "行: sets the named cell"; else fail "row update: exit $code: $out: $row"; fi
for bad in '行: projects/demo.md t-test0001\n~~~~\n期限: x\n~~~~@@見出しにない列: 期限' '行: projects/demo.md t-test0009\n~~~~\n状態: done\n~~~~@@1 列目が t-test0009 の行が 0 行' '行: projects/demo.md t-test0001\n~~~~\n状態: a | b\n~~~~@@値に | がある'; do
  item=${bad%@@*}; want=${bad##*@@}
  before=$(head_sha)
  out=$(printf "書き込み指示\ncommit 件名: t-test0001: bad row $want\ncommit 本文:\n~~~~\nwhy\n~~~~\n$item\n" | "$bin/record" 2>&1); code=$?; last=${out##*$'\n'}
  if [[ $code -eq 1 && $last == *"$want"* && $(head_sha) == "$before" ]] && clean; then pass "行: refuses ($want)"; else fail "bad row ($want): exit $code: $out"; fi
done

# An ID in the first cell of two rows (a running and an ended table) is an NG, not a guess.
before=$(head_sha)
out=$(printf '書き込み指示\ncommit 件名: t-test0001: two rows\ncommit 本文:\n~~~~\nwhy\n~~~~\n新規: assignments.md\n~~~~\n## 稼働中\n\n| Agent 名 | 開始日 |\n| --- | --- |\n| t-test0001 | 2026-01-01 |\n\n## 終了\n\n| Agent 名 | 終了日 |\n| --- | --- |\n| t-test0001 | 2026-01-02 |\n~~~~\n行: assignments.md t-test0001\n~~~~\n開始日: 2026-01-03\n~~~~\n' | "$bin/record" 2>&1); code=$?; last=${out##*$'\n'}
if [[ $code -eq 1 && $last == *"1 列目が t-test0001 の行が 2 行"* && $(head_sha) == "$before" ]] && clean; then pass "行: refuses an ID on two rows"; else fail "two rows: exit $code: $out"; fi

# 行: on the second table of a file uses that table's headings; the body is the journal lines alone,
# even when another item holds "- " lines.
out=$(printf '書き込み指示\ncommit 件名: t-test0001: second table\n\n新規: investigations/demo/sources/tables.md\n~~~~\n## 開いている\n\n| ID | 問い |\n| --- | --- |\n| q-test0001 | 例 |\n\n## 閉じた\n\n| ID | 決まった日 | 問い |\n| --- | --- | --- |\n| q-test0002 | 2026-01-01 | 例 |\n~~~~\n行: investigations/demo/sources/tables.md q-test0002\n~~~~\n決まった日: 2026-01-02\n~~~~\n追記: projects/demo.md\n~~~~\n- ノートの箇条\n~~~~\n追記: journal/2026-01-01.md\n~~~~\n- 16:00 [note] t-test0001: 2 つ目の表（会話 2026-01-01 16:00）\n~~~~\n' | "$bin/record" 2>&1); code=$?
if [[ $code -eq 0 ]] && rg -qxF '| q-test0002 | 2026-01-02 | 例 |' "$v/investigations/demo/sources/tables.md" && [[ $(git -C "$v" log -1 --format=%b) == "- 16:00 [note] t-test0001: 2 つ目の表（会話 2026-01-01 16:00）" ]]; then
  pass "行: on a second table, and a body of journal lines only"
else
  fail "second table: exit $code: $out: $(cat "$v/investigations/demo/sources/tables.md" 2>/dev/null): $(git -C "$v" log -1 --format=%b)"
fi

# A column the table lacks is an NG that lists the table's columns. The item names 担当 for the
# table's 担当 Agent, a short form easy to write on delegating.
before=$(head_sha)
out=$(printf '書き込み指示\ncommit 件名: t-test0001: delegated\ncommit 本文:\n~~~~\nwhy\n~~~~\n新規: docs/tasks-demo.md\n~~~~\n| ID | プロジェクト | 件名 | 状態 | 優先度 | 担当 Agent | 更新日 | リンク |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| t-test0002 | demo | 例 | ready | 中 | - | 2026-01-02 | - |\n~~~~\n行: docs/tasks-demo.md t-test0002\n~~~~\n状態: delegated\n担当: t-test0002\n更新日: 2026-01-02\n~~~~\n' | "$bin/record" 2>&1); code=$?; last=${out##*$'\n'}
if [[ $code -eq 1 && $last == *"見出しにない列: 担当（列は ID・プロジェクト・件名・状態・優先度・担当 Agent・更新日・リンク）" && $(head_sha) == "$before" ]] && clean; then
  pass "行: names the table's columns for a column it lacks"
else
  fail "unknown column: exit $code: $out"
fi

# An append to a thread that does not exist creates it with frontmatter from its task's file. The items
# add a task and make its thread with 新規: and no frontmatter; that 新規: is an NG naming the fix, and
# the same body through 追記: lands.
row='新規: tasks/t-test0123.md\n~~~~\n---\ntype: Task\ndescription: 例の作業の残りを洗い出す\ndate: 2026-01-01\ntasks:\n  - t-test0123\nprojects:\n  - demo\nstate: delegated\n---\n~~~~\n'
body='### オーナー · 2026-01-01 09:00\n\n例の作業の残りを見てほしい。\n\n***\n\n### CoS · 2026-01-01 09:00\n\n残りを一覧にした。\n'
before=$(head_sha)
out=$(printf "書き込み指示\ncommit 件名: t-test0123: record the example request\ncommit 本文:\n~~~~\nwhy\n~~~~\n$row\n新規: threads/t-test0123-example.md\nタスク: t-test0123\n~~~~\n$body~~~~\n" | "$bin/record" 2>&1); code=$?; last=${out##*$'\n'}
if [[ $code -eq 1 && $last == *"新規: threads/t-test0123-example.md: フロントマターがない（まだないファイルに 追記: で書くと"* && $(head_sha) == "$before" ]] && clean; then
  pass "新規: of a thread without frontmatter is an NG naming 追記"
else
  fail "thread without frontmatter: exit $code: $out"
fi
out=$(printf "書き込み指示\ncommit 件名: t-test0123: record the example request\ncommit 本文:\n~~~~\nwhy\n~~~~\n$row\n追記: threads/t-test0123-example.md\nタスク: t-test0123\n~~~~\n$body~~~~\n" | "$bin/record" 2>&1); code=$?
want=$'---\ntype: Thread\ndescription: "例の作業の残りを洗い出す"\ntopic: "例の作業の残りを洗い出す"\ndate: '"$(date +%F)"$'\ntasks:\n  - t-test0123\nprojects:\n  - demo\n---\n\n### オーナー · 2026-01-01 09:00'
if [[ $code -eq 0 && $(cat "$v/threads/t-test0123-example.md") == "$want"* ]] && clean; then pass "追記: creates a thread with frontmatter from its task's file"; else fail "thread by 追記: exit $code: $out: $(cat "$v/threads/t-test0123-example.md" 2>/dev/null)"; fi
before=$(head_sha)
out=$(printf '書き込み指示\ncommit 件名: t-test0001: no row\ncommit 本文:\n~~~~\nwhy\n~~~~\n追記: threads/t-test0999-none.md\nタスク: t-test0999\n~~~~\nx\n~~~~\n' | "$bin/record" 2>&1); code=$?; last=${out##*$'\n'}
if [[ $code -eq 1 && $last == *"ファイルがなく、tasks/t-test0999.md もない"* && $(head_sha) == "$before" ]] && clean; then pass "追記: to a missing thread needs the task's file"; else fail "thread without row: exit $code: $out"; fi

# An append to a day's standup that does not exist creates it deriving from the latest journal. A
# checkin's 新規: with frontmatter that has no derived_from is an NG; the same report through 追記: lands.
out=$(printf '書き込み指示\ncommit 件名: t-test0001: checkin\ncommit 本文:\n~~~~\nwhy\n~~~~\n新規: journal/2026-01-06-standup.md\n~~~~\n---\ntype: Standup\ndescription: 2026-01-06 の checkin\ndate: 2026-01-06\n---\n\n## Checkin（2026-01-06）\n~~~~\n' | "$bin/record" 2>&1); code=$?; last=${out##*$'\n'}
if [[ $code -eq 1 && $last == *"no sources or derived_from"* ]]; then pass "a standup by 新規: without derived_from is an NG"; else fail "standup by 新規: exit $code: $out"; fi
out=$(printf '書き込み指示\ncommit 件名: t-test0001: checkin\ncommit 本文:\n~~~~\nwhy\n~~~~\n追記: journal/2026-01-06-standup.md\n~~~~\n## Checkin（2026-01-06）\n~~~~\n' | "$bin/record" 2>&1); code=$?
if [[ $code -eq 0 && $(cat "$v/journal/2026-01-06-standup.md") == $'---\ntype: Standup\ndate: 2026-01-06\nderived_from:\n  - journal/2026-01-05.md\n---\n\n## Checkin（2026-01-06）' ]] && clean; then pass "追記: creates a standup deriving from the latest journal"; else fail "standup by 追記: exit $code: $out: $(cat "$v/journal/2026-01-06-standup.md" 2>/dev/null)"; fi
# Only a day's journal gives the commit body: a "- " line in a standup beside it does not.
before=$(head_sha)
out=$(printf '書き込み指示\ncommit 件名: t-test0001: standup line\n\n追記: journal/2026-01-06-standup.md\n~~~~\n- 10:00 [note] t-test0001: standup の行（会話 2026-01-06 10:00）\n~~~~\n' | "$bin/record" 2>&1); code=$?; last=${out##*$'\n'}
if [[ $code -eq 1 && $last == *"「commit 本文:」がなく、journal の行もない" && $(head_sha) == "$before" ]] && clean; then pass "a standup line is not a commit body"; else fail "standup line as body: exit $code: $out"; fi

# A [note] line saying an Agent or a subagent was stopped is an NG: a stopped delegation ends with
# [close].
for l in '- 10:00 [note] t-test0001: 例の作業の worktree が別の場所にできた。Agent を止め、worktree と branch を片付けた（会話 2026-01-01 10:00）' \
         '- 10:10 [note] t-test0001: 例のサブエージェントを止めた（会話 2026-01-01 10:10）' \
         '- 10:20 [note] t-test0001: 例のサブエージェントを止めた。作業は t-test0002 に含めた（会話 2026-01-01 10:20）'; do
  before=$(head_sha)
  out=$(printf '書き込み指示\ncommit 件名: t-test0001: stopped\n\n追記: journal/2026-01-01.md\n~~~~\n%s\n~~~~\n' "$l" | "$bin/record" 2>&1); code=$?; last=${out##*$'\n'}
  if [[ $code -eq 1 && $last == *"途中で止めた Agent やサブエージェントは [note] でなく [close] で書く"* && $(head_sha) == "$before" ]] && clean; then pass "a stopped delegation as [note] is an NG: ${l:0:40}"; else fail "stopped note: exit $code: $out"; fi
done
for l in '- 10:30 [close] t-test0001: 例のサブエージェントを止めた（会話 2026-01-01 10:30）' \
         '- 10:40 [note] t-test0001: 例の通信を止めた worktree で試した（会話 2026-01-01 10:40）' \
         '- 10:50 [note] t-test0001: 例の返信を止めて先に報告する（会話 2026-01-01 10:50）'; do
  out=$(printf '書き込み指示\ncommit 件名: t-test0001: not stopped\n\n追記: journal/2026-01-01.md\n~~~~\n%s\n~~~~\n' "$l" | "$bin/record" 2>&1); code=$?
  if [[ $code -eq 0 ]] && clean; then pass "a line that is not a stopped delegation as [note] passes: ${l:0:40}"; else fail "not stopped: exit $code: $out"; fi
done

# 行を足す: adds a row by column name to the table under a heading. A 置き換え anchored on another
# row's first cell, adding a running Agent to assignments.md, matches 0 or 2 places; the same intent
# as 行を足す lands at the end of 稼働中.
asg='## 稼働中\n\n| Agent 名 | タスク | 役割 | Herdr workspace | pane | worktree | branch | 開始日 |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| t-test0106 | t-test0106 | 実装 | w1 | w1:p1 | /w/a | docs/agent/a | 2026-01-02 |\n\n## 終了\n\n| Agent 名 | タスク | 役割 | worktree | branch | 開始日 | 終了日 |\n| --- | --- | --- | --- | --- | --- | --- |\n| t-test0106 | t-test0106 | 実装 | /w/old | docs/agent/old | 2026-01-01 | 2026-01-01 |'
printf "書き込み指示\ncommit 件名: t-test0001: assignments\ncommit 本文:\n~~~~\nwhy\n~~~~\n新規: assignments.md\n~~~~\n$asg\n~~~~\n" | "$bin/record" >/dev/null 2>&1
before=$(head_sha)
out=$(printf '書き込み指示\ncommit 件名: t-test0001: anchored add\ncommit 本文:\n~~~~\nwhy\n~~~~\n置き換え: assignments.md\n~~~~\n| t-test0106 |\n~~~~\n~~~~\n| t-test0124 | t-test0124 | 実装 | w2 | w2:p1 | /w/b | fix/agent/b | 2026-01-03 |\n| t-test0106 |\n~~~~\n' | "$bin/record" 2>&1); code=$?; last=${out##*$'\n'}
if [[ $code -eq 1 && $last =~ 一致が\ [02-9][0-9]*\ か所$ && $(head_sha) == "$before" ]]; then pass "a 置き換え anchored on another row is an NG"; else fail "anchored add: exit $code: $out"; fi
add='行を足す: assignments.md 稼働中\n~~~~\nAgent 名: t-test0124\nタスク: t-test0124\n役割: 実装\nHerdr workspace: w2\npane: w2:p1\nworktree: /w/b\nbranch: fix/agent/b\n開始日: 2026-01-03\n~~~~\n'
out=$(printf "書き込み指示\ncommit 件名: t-test0001: add a running agent\ncommit 本文:\n~~~~\nwhy\n~~~~\n$add" | "$bin/record" 2>&1); code=$?
want=$'| t-test0106 | t-test0106 | 実装 | w1 | w1:p1 | /w/a | docs/agent/a | 2026-01-02 |\n| t-test0124 | t-test0124 | 実装 | w2 | w2:p1 | /w/b | fix/agent/b | 2026-01-03 |\n\n## 終了'
if [[ $code -eq 0 && $(cat "$v/assignments.md") == *"$want"* ]] && clean; then pass "行を足す: adds the row at the end of the table under the heading"; else fail "add row: exit $code: $out: $(cat "$v/assignments.md")"; fi
out=$(printf '書き込み指示\ncommit 件名: t-test0001: add an ended agent\ncommit 本文:\n~~~~\nwhy\n~~~~\n行を足す: assignments.md 終了\n~~~~\nAgent 名: t-test0124\n終了日: 2026-01-04\n~~~~\n' | "$bin/record" 2>&1); code=$?
if [[ $code -eq 0 && $(tail -n 1 "$v/assignments.md") == "| t-test0124 |  |  |  |  |  | 2026-01-04 |" ]] && clean; then pass "行を足す: leaves the columns not named empty"; else fail "add ended: exit $code: $out: $(tail -n 1 "$v/assignments.md")"; fi
for bad in "行を足す: assignments.md\n~~~~\nAgent 名: t-test0200\n~~~~@@ファイル（見出しを書いて表を選ぶ）の表が 2 個" \
           "行を足す: assignments.md 待ち\n~~~~\nAgent 名: t-test0200\n~~~~@@見出し「待ち」が 0 か所" \
           "行を足す: assignments.md 稼働中\n~~~~\nAgent 名: t-test0106\n~~~~@@1 列目が t-test0106 の行がもうある" \
           "行を足す: assignments.md 稼働中\n~~~~\n役割: 実装\n~~~~@@1 列目（Agent 名）の値がない" \
           "行を足す: assignments.md 稼働中\n~~~~\nAgent 名: t-test0200\n担当: x\n~~~~@@見出しにない列: 担当（列は Agent 名・タスク・役割・Herdr workspace・pane・worktree・branch・開始日）"; do
  item=${bad%@@*}; want=${bad##*@@}
  before=$(head_sha)
  out=$(printf "書き込み指示\ncommit 件名: t-test0001: bad add\ncommit 本文:\n~~~~\nwhy\n~~~~\n$item\n" | "$bin/record" 2>&1); code=$?; last=${out##*$'\n'}
  if [[ $code -eq 1 && $last == *"$want" && $(head_sha) == "$before" ]] && clean; then pass "行を足す: refuses ($want)"; else fail "bad add ($want): exit $code: $out"; fi
done

# Two thread files in one instruction are shown in the order the instruction names them.
: > "$tmp/shown"
out=$(printf '書き込み指示\ncommit 件名: t-test0001: two threads\ncommit 本文:\n~~~~\nwhy\n~~~~\n新規: threads/memo.md\n~~~~\n---\ntype: Memo\ndescription: メモ帳\ntopic: メモ\n---\n~~~~\n%b' "${thread_item:-追記: threads/t-test0001-demo.md\nタスク: t-test0001\n~~~~\n\n続き\n~~~~\n}" | "$bin/record" 2>&1); code=$?
real=$(cd "$v" && pwd -P)
if [[ $code -eq 0 && $(tr '\n' ' ' < "$tmp/shown") == "$real/threads/memo.md $real/threads/t-test0001-demo.md " ]]; then pass "shows two threads in the instruction's order"; else fail "two threads: exit $code: $out: $(cat "$tmp/shown")"; fi

# A thread item declares the one task it is about, and that task is in the thread's tasks (for 新規, in
# the body's frontmatter); threads/memo.md needs none. The declaration line is not written.
before=$(head_sha)
thread() { printf '書き込み指示\ncommit 件名: t-test0001: %s\ncommit 本文:\n~~~~\nwhy\n~~~~\n%b' "$1" "$2" | "$bin/record" 2>&1; }
out=$(thread 'no declaration' '追記: threads/t-test0001-demo.md\n~~~~\n\n宣言なし\n~~~~\n'); code=$?
if [[ $code -eq 1 && $out == *"threads/t-test0001-demo.md: 「タスク:」の行がない"* && $(head_sha) == "$before" ]] && clean; then pass "a thread item without タスク: is an NG"; else fail "no declaration: exit $code: $out"; fi
out=$(thread 'other task' '追記: threads/t-test0001-demo.md\nタスク: t-test0002\n~~~~\n\n別のタスク\n~~~~\n'); code=$?
if [[ $code -eq 1 && $out == *"threads/t-test0001-demo.md: t-test0002 がフロントマターの tasks にない"* && $(head_sha) == "$before" ]] && clean; then pass "a declared task not in the thread's tasks is an NG"; else fail "other task: exit $code: $out"; fi
out=$(thread 'two tasks' '追記: threads/t-test0001-demo.md\nタスク: t-test0001, t-test0002\n~~~~\n\n2 つ\n~~~~\n'); code=$?
if [[ $code -eq 1 && $out == *"「タスク:」はタスク ID 1 つ"* && $(head_sha) == "$before" ]] && clean; then pass "a declaration of two tasks is an NG"; else fail "two tasks: exit $code: $out"; fi
out=$(thread 'declared' '追記: threads/t-test0001-demo.md\nタスク: t-test0001\n~~~~\n\n宣言あり\n~~~~\n'); code=$?
if [[ $code -eq 0 && $(tail -n 1 "$v/threads/t-test0001-demo.md") == 宣言あり ]] && ! rg -qF 'タスク:' "$v/threads/t-test0001-demo.md"; then pass "a declared task in tasks is appended, without the declaration"; else fail "declared: exit $code: $out"; fi
second='---\ntype: Thread\ndescription: 2 つ目の会話\ntopic: 2 つ目\ndate: 2026-01-01\ntasks:\n  - t-test0001\nprojects:\n  - demo\n---\n\n### オーナー · 2026-01-01 09:00\n\n本文\n'
before=$(head_sha)
out=$(thread 'new other task' "新規: threads/t-test0001-second.md\nタスク: t-test0002\n~~~~\n$second~~~~\n"); code=$?
if [[ $code -eq 1 && $out == *"threads/t-test0001-second.md: t-test0002 がフロントマターの tasks にない"* && $(head_sha) == "$before" ]] && clean; then pass "新規: a declared task not in the body's tasks is an NG"; else fail "new other task: exit $code: $out"; fi
out=$(thread 'new declared' "新規: threads/t-test0001-second.md\nタスク: t-test0001\n~~~~\n$second~~~~\n"); code=$?
if [[ $code -eq 0 ]] && ! rg -qF 'タスク:' "$v/threads/t-test0001-second.md"; then pass "新規: a declared task in the body's tasks is written"; else fail "new declared: exit $code: $out"; fi

# Two NGs with one subject are cleared one by one: 解決 with one copy's name leaves the other, and a 解決
# with the subject alone clears neither. A malformed instruction is refused by --detach on the spot.
for n in 1 2; do printf '書き込み指示\ncommit 件名: t-test0001: same subject\ncommit 本文:\n~~~~\nwhy\n~~~~\n追記: journal/nope%s.md\n~~~~\nx\n~~~~\n' "$n" | "$bin/record" >/dev/null 2>&1; sleep 1; done
first=$(rg -F 't-test0001: same subject: ' "$COS_RECORD_PROBLEMS" | rg -o '指示の写し: [^）]+' | head -n 1 | sed 's/^指示の写し: //')
out=$(printf '書き込み指示\ncommit 件名: t-test0001: fix one\ncommit 本文:\n~~~~\nwhy\n~~~~\n解決: t-test0001: same subject\n解決: %s\n\n追記: projects/demo.md\n~~~~\nz2\n~~~~\n' "$first" | "$bin/record" 2>&1); code=$?
if [[ $code -eq 0 && $(rg -cF 't-test0001: same subject: ' "$COS_RECORD_PROBLEMS") -eq 1 ]] && ! rg -qF "$first" "$COS_RECORD_PROBLEMS"; then pass "解決 clears one NG by its copy, not every NG of the subject"; else fail "same subject: exit $code: $out: $(rg -F 'same subject' "$COS_RECORD_PROBLEMS")"; fi
printf '書き込み指示\n追記: projects/demo.md\n' > "$tmp/malformed.txt"
out=$("$bin/record" --detach "$tmp/malformed.txt" 2>&1); code=$?
if [[ $code -eq 1 && $out == "NG (件名なし): 「commit 件名:」の行がない" && -z $(ls "$tmp/state/queue" 2>/dev/null) ]]; then pass "--detach refuses a malformed instruction on the spot"; else fail "detach malformed: exit $code: $out"; fi

# A thread-show that fails leaves the commit, prints its line, and goes to the problems file until a
# later thread-show succeeds.
thread_item='追記: threads/t-test0001-demo.md\nタスク: t-test0001\n~~~~\n\n***\n\n### CoS · 2026-01-01 10:00\n\n続き\n~~~~\n'
out=$(printf "書き込み指示\ncommit 件名: t-test0001: show fails\ncommit 本文:\n~~~~\nwhy\n~~~~\n$thread_item" | STUB_FAIL=1 "$bin/record" 2>&1); code=$?; last=${out##*$'\n'}
if [[ $code -eq 0 && $last == "OK $(head_sha) t-test0001: show fails" ]] && printf '%s\n' "$out" | rg -q '^thread-show: threads/t-test0001-demo.md を開けなかった' \
   && rg -q '^- [0-9-]+ [0-9:]+ thread-show: ' "$COS_RECORD_PROBLEMS"; then
  pass "a failed thread-show keeps the commit and is a problem"
else
  fail "thread-show fails: exit $code: $out: $(cat "$COS_RECORD_PROBLEMS" 2>/dev/null)"
fi
out=$(printf '書き込み指示\ncommit 件名: t-test0001: no thread\n\n追記: journal/2026-01-01.md\n~~~~\n- 12:30 [note] t-test0001: threads なし（会話 2026-01-01 12:30）\n~~~~\n' | "$bin/record" 2>&1); code=$?
if [[ $code -eq 0 ]] && rg -q 'thread-show: ' "$COS_RECORD_PROBLEMS"; then pass "a commit without threads keeps the thread-show problem"; else fail "no thread: exit $code: $out: $(cat "$COS_RECORD_PROBLEMS")"; fi
out=$(printf "書き込み指示\ncommit 件名: t-test0001: show works\ncommit 本文:\n~~~~\nwhy\n~~~~\n$thread_item" | "$bin/record" 2>&1); code=$?
if [[ $code -eq 0 ]] && ! rg -q 'thread-show: ' "$COS_RECORD_PROBLEMS" 2>/dev/null; then pass "a later thread-show clears the problem"; else fail "thread-show clears: exit $code: $out: $(cat "$COS_RECORD_PROBLEMS")"; fi

# --detach returns at once; the worker applies the queue in order and reports an NG only through the
# problems file.
# The queue is done when it is empty and no worker holds the drain lock.
wait_queue() {
  for _ in $(seq 100); do
    [[ -z $(ls "$tmp/state/queue" 2>/dev/null) ]] && python3 -c 'import fcntl, sys; fcntl.flock(open(sys.argv[1], "a"), fcntl.LOCK_EX | fcntl.LOCK_NB)' "$tmp/state/drain.lock" 2>/dev/null && return 0
    sleep 0.2
  done
  return 1
}
for n in first second third; do
  printf '書き込み指示\ncommit 件名: t-test0001: detached %s\ncommit 本文:\n~~~~\nwhy\n~~~~\n追記: journal/2026-01-01.md\n~~~~\n- 13:00 [note] t-test0001: detached %s（会話 2026-01-01 13:00）\n~~~~\n' "$n" "$n" > "$tmp/detach-$n.txt"
done
before=$(git -C "$v" rev-list --count HEAD)
# A holder of the drain lock keeps every worker away until all three are queued, so the order checked
# is the queue's, not the order in which separate workers happened to finish.
mkdir -p "$tmp/state"
python3 -c 'import fcntl, sys, time; f = open(sys.argv[1], "a"); fcntl.flock(f, fcntl.LOCK_EX); open(sys.argv[2], "w").close(); time.sleep(3)' "$tmp/state/drain.lock" "$tmp/held" &
holder=$!
for _ in $(seq 50); do [[ -e $tmp/held ]] && break; sleep 0.1; done
t0=$(python3 -c 'import time; print(time.time())')
outs=$(for n in first second third; do "$bin/record" --detach "$tmp/detach-$n.txt"; done)
t1=$(python3 -c 'import time; print(time.time())')
mid=$(git -C "$v" rev-list --count HEAD)
wait "$holder"
# The workers started while the lock was held left the queue to its holder; a worker takes it from here.
"$bin/record" --drain >/dev/null
wait_queue
order=$(rg -o 'detached (first|second|third)' -r '$1' "$v/journal/2026-01-01.md" | tr '\n' ' ')
if [[ $(printf '%s\n' "$outs" | rg -c '^queued [0-9]+-[0-9]+\.txt$') -eq 3 && $mid -eq $before && $(git -C "$v" rev-list --count HEAD) -eq $((before+3)) \
   && $order == "first second third " ]] && python3 -c "import sys; sys.exit(0 if $t1 - $t0 < 3 else 1)" && clean; then
  pass "--detach returns at once and applies the queue in order"
else
  fail "detach: $outs, commits $before -> $(git -C "$v" rev-list --count HEAD), order $order, took $(python3 -c "print(round($t1 - $t0, 2))")s"
fi
# A worker busy with one instruction (a slow thread-show) takes the one queued meanwhile: the worker
# that one starts cannot get the lock and leaves it to the busy one, which looks again before it stops.
printf '#!/bin/sh\nsleep 1\n' > "$tmp/slow-show"; chmod +x "$tmp/slow-show"
before=$(git -C "$v" rev-list --count HEAD)
printf "書き込み指示\ncommit 件名: t-test0001: slow first\ncommit 本文:\n~~~~\nwhy\n~~~~\n$thread_item" > "$tmp/slow1.txt"
printf '書き込み指示\ncommit 件名: t-test0001: queued meanwhile\n\n追記: journal/2026-01-01.md\n~~~~\n- 13:30 [note] t-test0001: 待つ間に入れた（会話 2026-01-01 13:30）\n~~~~\n' > "$tmp/slow2.txt"
COS_THREAD_SHOW=$tmp/slow-show "$bin/record" --detach "$tmp/slow1.txt" >/dev/null
sleep 0.5
COS_THREAD_SHOW=$tmp/slow-show "$bin/record" --detach "$tmp/slow2.txt" >/dev/null
wait_queue
if [[ $(git -C "$v" rev-list --count HEAD) -eq $((before+2)) ]] && git -C "$v" log -1 --format=%s | rg -qx 't-test0001: queued meanwhile' && clean; then
  pass "a busy worker takes what is queued meanwhile"
else
  fail "busy worker: commits $before -> $(git -C "$v" rev-list --count HEAD), queue $(ls "$tmp/state/queue")"
fi
printf '書き込み指示\ncommit 件名: t-test0001: detached bad\ncommit 本文:\n~~~~\nwhy\n~~~~\n追記: journal/nope.md\n~~~~\nx\n~~~~\n' > "$tmp/detach-bad.txt"
before=$(head_sha)
out=$("$bin/record" --detach "$tmp/detach-bad.txt" 2>&1); code=$?
wait_queue
if [[ $code -eq 0 && $out == queued* && $(head_sha) == "$before" ]] && rg -q 't-test0001: detached bad: 追記: journal/nope.md: ファイルがない（commit なし。指示の写し: [0-9]+-[0-9]+\.txt）' "$COS_RECORD_PROBLEMS" && clean; then
  pass "a detached NG reaches the problems file"
else
  fail "detached NG: exit $code: $out: $(cat "$COS_RECORD_PROBLEMS" 2>/dev/null)"
fi

# The five instructions of rules/record-examples.md pass in order, as written, in a vault
# of their own: a new task with its thread, a delegation, a pending decision added, the decision, and the close.
ex=$tmp/ex
mkdir -p "$ex/projects" "$ex/rules" "$tmp/examples"
cp "$cos/.rumdl.toml" "$ex/" && cp "$cos/rules/frontmatter-schema.yaml" "$ex/rules/" || exit 2
printf -- '---\ntype: Project\ndescription: 例のプロジェクト。\nprojects:\n  - dotfiles\n---\n\n## dotfiles\n' > "$ex/projects/dotfiles.md"
printf '# 割り当て\n\n## 稼働中\n\n| Agent 名 | タスク | 役割 | Herdr workspace | pane | worktree | branch | 開始日 |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n\n## 終了\n\n| Agent 名 | タスク | 役割 | worktree | branch | 開始日 | 終了日 |\n| --- | --- | --- | --- | --- | --- | --- |\n' > "$ex/assignments.md"
printf '# 現在の状況\n\n## 焦点\n\nなし\n\n## 判断待ち\n\nなし\n' > "$ex/state.md"
git -C "$ex" init -q && git -C "$ex" config user.name test && git -C "$ex" config user.email test@example.invalid
git -C "$ex" add -A && git -C "$ex" commit -q -m init || exit 2
awk -v dir="$tmp/examples" '/^<example>$/ {inex = 1; next} /^<\/example>$/ {inex = 0; next}
  inex && /^```$/ {if (code) {code = 0; close(f)} else {code = 1; f = sprintf("%s/%d.txt", dir, ++n)}; next}
  inex && code {print > f}' "$cos/rules/record-examples.md"
examples=$(fd -t f . "$tmp/examples" | wc -l | tr -d ' ')
results=
for n in $(seq "$examples"); do
  out=$(COS_DIR=$ex "$bin/record" < "$tmp/examples/$n.txt" 2>&1)
  results+="${out##*$'\n'}"$'\n'
done
# The examples name one task and one pending decision.
id=$(rg -o -m 1 -r '$1' '^commit 件名: (t-[a-z0-9]{8}):' "$tmp/examples/1.txt")
q=$(cat "$tmp/examples"/*.txt | rg -o -m 1 'q-[a-z0-9]{8}')
task=$ex/tasks/$id.md
thread=$ex/threads/$id-fb-sort.md
if [[ $examples -eq 5 && -n $id && -n $q && $(printf '%s' "$results" | rg -c "^OK [0-9a-f]+ $id: ") -eq 5 ]] && rg -qx 'state: done' "$task" && rg -qx "agent: $id" "$task" \
   && rg -qx -e '- 決定: 並び順の基準は更新日にする（会話 [0-9-]+ [0-9:]+）' "$task" && ! rg -q "判断待ち|$q" "$task" \
   && [[ $(sed -n '/^## 判断待ち/,$p' "$ex/state.md") == $'## 判断待ち\n\nなし' ]] \
   && rg -qx "\\| $id \\| $id \\| 実装 \\| dotfiles の main \\| main \\| [0-9-]+ \\| [0-9-]+ \\|" "$ex/assignments.md" \
   && [[ -z $(git -C "$ex" status --porcelain) ]] && "$bin/karo-check" "$ex" >/dev/null 2>&1; then
  pass "the five instructions in rules/record-examples.md pass in order"
else
  fail "rules/record-examples.md instructions: $examples found: $results$(cat "$task" 2>/dev/null)"
fi
# The first one's thread takes its topic, description, and project from the task file it added.
want=$'---\ntype: Thread\ndescription: "fb の一覧を更新日の新しい順にする"\ntopic: "fb の一覧を更新日の新しい順にする"\ndate: '"$(date +%F)"$'\ntasks:\n  - '"$id"$'\nprojects:\n  - dotfiles\n---\n\n### オーナー · '
if [[ $(cat "$thread" 2>/dev/null) == "$want"* ]]; then pass "a thread made by 追記: takes its frontmatter from the task file"; else fail "thread from task file: $(head -n 12 "$thread" 2>/dev/null)"; fi
# With a pending decision, state.md and the task files must agree: a state.md left without its q-ID is an NG.
before=$(git -C "$ex" rev-parse --short HEAD)
out=$(printf '書き込み指示\ncommit 件名: %s: pending without state.md\n\n追記: tasks/%s.md\n~~~~\n\n## 判断待ち\n\n- q-test0003（起票 2026-01-01）: 例 選択肢と推奨: 例\n~~~~\n追記: journal/2026-01-01.md\n~~~~\n- 10:00 [ask] q-test0003: 例（会話 2026-01-01 10:00）\n~~~~\n' "$id" "$id" | COS_DIR=$ex "$bin/record" 2>&1); last=${out##*$'\n'}
if [[ $last == *"pending q-test0003 missing from state.md"* && $(git -C "$ex" rev-parse --short HEAD) == "$before" ]]; then pass "a pending decision missing from state.md is an NG"; else fail "pending without state.md: $out"; fi

# Without crit on PATH, a commit that adds a file says nothing about crit.
mkdir -p "$tmp/nocrit"
# aqua's shims need aqua on PATH, so link the binaries they resolve to.
for t in git rumdl yq rg fd python3; do ln -s "$(aqua which "$t" 2>/dev/null || command -v "$t")" "$tmp/nocrit/$t"; done
out=$(printf '書き込み指示\ncommit 件名: t-test0001: no crit\ncommit 本文:\n~~~~\nwhy\n~~~~\n新規: investigations/demo/sources/nocrit.md\n~~~~\nx\n~~~~\n' |
  PATH=$tmp/nocrit:/usr/bin:/bin "$bin/record" 2>&1); code=$?
if [[ $code -eq 0 ]] && ! printf '%s\n' "$out" | rg -q '^crit:'; then pass "no crit, no crit line"; else fail "no crit: exit $code: $out"; fi

# While crit reviews the vault ("crit ." there), a commit that adds a file restarts it with its comments
# kept and the new file listed; a commit that only changes files leaves it alone. A test daemon needs a
# free local port, which the sandbox refuses, so the cases are skipped when it cannot start.
crit_q() { (cd "$v" && crit "$@" 2>/dev/null); }
crit_pid() { crit_q status --json | jq -r 'if .daemon.running then .daemon.pid else "none" end'; }
if command -v crit >/dev/null; then
  printf '{"port": 55191}\n' > "$v/.crit.config.json"
  printf '.crit.config.json\n' >> "$v/.git/info/exclude"
  trap '(cd "$v" && crit stop . >/dev/null 2>&1); rm -rf "$tmp"' EXIT
  (cd "$v" && nohup crit . --no-open >/dev/null 2>&1 &)
  for _ in $(seq 50); do [[ $(crit_pid) != none ]] && break; sleep 0.2; done
fi
if ! command -v crit >/dev/null || [[ $(crit_pid) == none ]]; then
  printf 'skip\tcrit restart: no test crit daemon on port 55191 (needs crit, run outside the sandbox)\n'
else
  crit_q comment projects/demo.md:1 'keep me' >/dev/null
  pid=$(crit_pid)
  printf '書き込み指示\ncommit 件名: t-test0001: change only\ncommit 本文:\n~~~~\nwhy\n~~~~\n追記: projects/demo.md\n~~~~\nx\n~~~~\n' | "$bin/record" > "$tmp/crit1" 2>&1
  if rg -q '^OK ' "$tmp/crit1" && ! rg -q '^crit:' "$tmp/crit1" && [[ $(crit_pid) == "$pid" ]]; then pass "crit left alone when no file is added or removed"; else fail "crit on change: $(cat "$tmp/crit1"), pid $pid -> $(crit_pid)"; fi
  printf '書き込み指示\ncommit 件名: t-test0001: add a file\ncommit 本文:\n~~~~\nwhy\n~~~~\n新規: investigations/demo/sources/added.md\n~~~~\nx\n~~~~\n' | "$bin/record" > "$tmp/crit2" 2>&1
  port=$(crit_q status --json | jq -r .daemon.port)
  # A daemon just started answers with no files while it is still loading.
  listed=no
  for _ in $(seq 50); do
    curl -s "http://127.0.0.1:$port/api/session" | jq -e 'any(.files[]?; .path == "investigations/demo/sources/added.md")' >/dev/null && { listed=yes; break; }
    sleep 0.2
  done
  if [[ $(tail -n 1 "$tmp/crit2") == "OK "* ]] && rg -qx 'crit: 起動し直した' "$tmp/crit2" && [[ $(crit_pid) != "$pid" && $(crit_pid) != none ]] \
     && [[ $listed == yes ]] \
     && crit_q comments --json | jq -e 'any(.[]; .body == "keep me")' >/dev/null; then
    pass "crit restarted on an added file, comments kept"
  else
    fail "crit on add: $(cat "$tmp/crit2"), pid $pid -> $(crit_pid)"
  fi
  pid=$(crit_pid); out=$("$bin/record" --restart-crit 2>&1)
  if [[ $out == "OK crit: 起動し直した" && $(crit_pid) != "$pid" && $(crit_pid) != none ]]; then pass "--restart-crit restarts"; else fail "--restart-crit: $out"; fi
  crit_q stop . >/dev/null; out=$("$bin/record" --restart-crit 2>&1)
  if [[ $out == "OK crit: crit . は動いていない" && $(crit_pid) == none ]]; then pass "--restart-crit leaves a stopped crit stopped"; else fail "--restart-crit when stopped: $out"; fi
fi

echo "record-test: $failed failure(s)" >&2
[[ $failed -eq 0 ]]
