#!/bin/sh
# Commit only the given paths of the karo record, after rumdl fmt on each .md, git diff --cached --check,
# and fmcheck. A failed check unstages the paths, leaves the files as written, and prints
# "NG <subject>" after the reason; a commit prints "OK <short hash> <subject>".
# usage: commit <subject> <body> <path>...   (paths from KARO_HOME; the body says why)
# Environment: KARO_HOME (default ~/karo). Runs inside the sandbox: it writes only KARO_HOME and its .git.
[ $# -ge 3 ] && [ -n "$2" ] || { echo "usage: commit <subject> <body (why)> <path>..." >&2; exit 2; }
subject=$1 body=$2; shift 2
bin=$(cd "$(dirname "$0")" && pwd)
cd "${KARO_HOME:-$HOME/karo}" || exit 2
for p; do
  case $p in *..*|/*|*//*) echo "NG $subject: not a record path: $p"; exit 1 ;; esac
  case $p in standup/?*|source/?*|investigation/?*|project/?*|doc/?*) ;;
    *) echo "NG $subject: not a record path: $p"; exit 1 ;; esac
done
ng() { git reset -q -- "$@"; echo "NG $subject"; exit 1; }
for p; do case $p in *.md) [ -f "$p" ] && rumdl fmt --silent "$p" ;; esac; done
git add -- "$@" || ng "$@"
staged=$(git diff --cached --name-only -- "$@")
[ -n "$staged" ] || { echo "OK - $subject (no change)"; exit 0; }
git diff --cached --check -- "$@" || ng "$@"
printf '%s\n' "$staged" | tr '\n' '\0' | xargs -0 "$bin/fmcheck" || ng "$@"
git commit -q -m "$subject" -m "$body" -- "$@" || ng "$@"
git log -1 --format='OK %h %s'
