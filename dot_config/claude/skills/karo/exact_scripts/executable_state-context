#!/usr/bin/env bash
# Print karo's state for a hook of a session in the record repository at KARO_HOME (default ~/karo), and
# nothing for a session anywhere else.
# session-start (SessionStart on startup, resume, clear, compact and fork): the KARO_* values, then
# state.md once with its path and last change, or a notice when it is missing or longer than 8,000
# characters (the hook's output must stay under Claude Code's 10,000), then a request to check the
# items marked "（YYYY-MM-DD HH:MM 時点）" against Beads and Herdr when there are any, and on compact a
# request to call the karo skills again.
# pre-compact (PreCompact, manual and auto): instructions for the compaction summary, which leave
# state.md's content out (SessionStart puts the file back) and keep what changed after its last change.
# It never blocks compaction: it exits 0, and 1 on a usage error, never 2.
# agents (SessionStart, as a hook of its own so it has its own 10,000 characters): the agents to wait
# for again, the in_progress assignees of KARO_HOME's Beads that are in `herdr agent list` (an assignee
# matching the Herdr name with each character herdr does not take turned into "-"), each with its
# agent_status and the agent-report --wait command, since a wait in the background ends with the
# session; nothing when there is none or bd or herdr fails. Waiting for each again misses no stop and
# repeats none, as agent-report --wait hands over a stop only once.
# The rules for state.md are in the record skill's "state.md を書く".
# usage: state-context session-start|pre-compact|agents   (the hook input JSON on stdin)
set -uo pipefail
mode=${1:-}
[[ $mode == session-start || $mode == pre-compact || $mode == agents ]] || { echo "usage: state-context session-start|pre-compact|agents" >&2; exit 1; }
input=$(cat)
home=${KARO_HOME:-$HOME/karo}
[[ ${CLAUDE_PROJECT_DIR:-} == "$home" && -f $home/AGENTS.md ]] || exit 0
state_home=${KARO_STATE_HOME:-${XDG_STATE_HOME:-$HOME/.local/state}/karo}
state=$state_home/state.md
max=8000
changed() { date -r "$state" '+%Y-%m-%d %H:%M'; }

if [[ $mode == agents ]]; then
  cd "$home" 2>/dev/null && [[ -d .beads ]] || exit 0
  tasks=$(bd list --status in_progress --limit 0 --json 2>/dev/null) || exit 0
  herdr=$(herdr agent list 2>/dev/null) || exit 0
  jq -r --argjson herdr "$herdr" '
    ([$herdr.result[]? | arrays | .[] | {key: .name, value: .agent_status}] | from_entries) as $status
    | [.[]? | .assignee // empty | select($status[gsub("[^a-z0-9_-]"; "-")])] | unique
    | select(length > 0)
    | "## 待ち直す Agent",
      "このセッションで走らせている agent-report --wait がなければ、karo:herdr-agent skill の「終わるのを待つ」のとおり、次のコマンドをそれぞれ単独で、Bash の background 実行で、timeout を 86400000 にして走らせる（待ちの background はセッションが終わると消える。一度返した停止はもう返さないので、全員を待ち直してよい）。",
      (.[] | "- \(.)（\($status[gsub("[^a-z0-9_-]"; "-")])）: `~/.config/claude/skills/karo/skills/herdr-agent/scripts/agent-report --wait \(.)`")' \
    <<<"$tasks" 2>/dev/null
  exit 0
fi

if [[ $mode == pre-compact ]]; then
  echo 'state.md の中身は要約に写さない（compact のあと、SessionStart の hook が最新の state.md を入れ直す）。'
  if [[ -f $state ]]; then
    printf '要約には、state.md の最終更新（%s）より後に会話で変わった目標・制約・進めている作業と次の行動・オーナーへの未回答の問いと、まだ Beads にも記録にも書いていない決定を残す。\n' "$(changed)"
  else
    echo 'state.md がないので、要約に、今の目標・制約・進めている作業と次の行動・オーナーへの未回答の問いと、まだ Beads にも記録にも書いていない決定を残す。'
  fi
  echo '要約に残す Beads のタスクと Herdr の Agent の状態には、観察した時刻を添える（compact のあとに正本で確かめ直す）。'
  exit 0
fi

printf 'KARO_HOME=%s KARO_DATA_HOME=%s KARO_CONFIG_HOME=%s KARO_STATE_HOME=%s\n' "$home" \
  "${KARO_DATA_HOME:-${XDG_DATA_HOME:-$HOME/.local/share}/karo}" \
  "${KARO_CONFIG_HOME:-${XDG_CONFIG_HOME:-$HOME/.config}/karo}" "$state_home"
if [[ ! -f $state ]]; then
  printf '%s がない。進めている作業は Beads の一覧と herdr agent list から読み、karo:record skill の「state.md を書く」で state.md を作る。\n' "$state"
elif (( $(jq -Rs length "$state") > max )); then
  printf '%s（最終更新 %s）は %s 字を超えるので出さない。Read で読み、karo:record skill の「state.md を書く」のとおり、古い項目を消して正本への参照に置き換える。\n' "$state" "$(changed)" "$max"
else
  printf '## %s（最終更新 %s）\n\n%s\n\n## state.md の終わり\n' "$state" "$(changed)" "$(cat "$state")"
  if grep -q ' 時点）' "$state"; then
    echo '「（… 時点）」の付いた項目は、その時刻の観察で、今の状態とは限らない。次の行動に使う前に、タスクは bd show <ID> --json、Agent は herdr agent get <名前> で確かめ、食い違えば正本に従って state.md を直す。'
  fi
fi
if jq -e '.source == "compact"' <<<"$input" >/dev/null 2>&1; then
  echo '記録を書く・bd で書く・委任する前に、使う karo の skill を Skill tool で呼び直す（compact で戻された skill の中身は、古い版のことがある）。'
fi
exit 0
