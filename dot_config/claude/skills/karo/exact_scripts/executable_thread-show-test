#!/usr/bin/env bash
# shellcheck disable=SC2016  # the checks are single-quoted for eval, which expands them
# Show that thread-show reopens a thread only in a pane that comes back to a shell, against a herdr on
# PATH whose pane reports a scripted run of foreground programs, one per process-info call (the last
# one repeats): a pager gets q and the thread opens once the shell is back, even when the prompt
# renderer (starship) or direnv's prompt hook holds the foreground on the way; a pane that turns to another program, or never
# leaves starship, gets nothing after the q. The pager is given a copy headed by the frontmatter's topic,
# the pane is labelled with it, and a thread without a topic is refused before any key is sent.
# usage: thread-show-test [<thread-show>]   (default: the one beside this script; its files go to a
#        temporary directory that is removed)
set -uo pipefail
exec </dev/null
bin=$(cd "$(dirname "$0")" && pwd)
ts=${1:-$bin/thread-show}
tmp=$(mktemp -d "${TMPDIR:-/tmp}/thread-show-test.XXXXXX") || exit 2
tmp=$(cd "$tmp" && pwd -P)
trap 'rm -rf "$tmp"' EXIT
failed=0
fail() { printf 'FAIL\t%s\n' "$1"; failed=$((failed+1)); }
pass() { printf 'ok\t%s\n' "$1"; }

mkdir -p "$tmp/fake" "$tmp/threads"
cat > "$tmp/fake/herdr" <<'EOF'
#!/bin/sh
st=$FAKE_STATE
log() { printf '%s\n' "$*" >> "$FAKE_LOG"; }
case "$1 $2" in
  "pane list") echo '{"result":{"panes":[{"pane_id":"w1:p2","label":"thread"}]}}' ;;
  "pane process-info")
    fg=$(jq -r '.fg[0]' "$st")
    jq 'if (.fg | length) > 1 then .fg |= .[1:] else . end' "$st" > "$st.new" && mv "$st.new" "$st"
    jq -nc --arg fg "$fg" '{result: {process_info: {foreground_processes: [{name: $fg}]}}}' ;;
  "pane send-keys") log send-keys "$3" "$4" ;;
  "pane run") log run "$3"; log cmd "$4" ;;
  "pane rename") log rename "$3" "$4" ;;
  "agent focus") ;;
  *) log unexpected "$*"; exit 1 ;;
esac
EOF
chmod +x "$tmp/fake/herdr"
printf -- '---\ntype: Thread\ndescription: 例の会話の説明\ntopic: 話題\n---\n\n### オーナー · 2026-01-01 09:00\n\n本文\n' > "$tmp/threads/t-ex0001-topic.md"
printf -- '---\ntype: Thread\ndescription: 話題のない会話\n---\n\n### オーナー · 2026-01-01 09:00\n\n本文\n' > "$tmp/threads/t-ex0002-none.md"

export FAKE_STATE=$tmp/state.json FAKE_LOG=$tmp/log
# show <foreground programs as a JSON array> [<thread file>]: run thread-show on the thread with that pane.
show() {
  jq -n --argjson fg "$1" '{fg: $fg}' > "$FAKE_STATE"
  : > "$FAKE_LOG"
  out=$(env PATH="$tmp/fake:$PATH" HERDR_WORKSPACE_ID=w1 COS_THREADS_DIR="$tmp/threads" \
    COS_THREAD_STATE="$tmp/last-pane" COS_THREAD_VIEW_DIR="$tmp/view" "$ts" "$tmp/threads/${2:-t-ex0001-topic.md}" 2>&1); code=$?
}
opened() { rg -qx 'run w1:p2' "$FAKE_LOG"; }
quit() { rg -qx 'send-keys w1:p2 q' "$FAKE_LOG"; }
check() { if "${@:2}"; then pass "$1"; else fail "$1: exit $code: $out: $(paste -sd '|' "$FAKE_LOG")"; fi; }

show '["zsh"]'
check "a pane at a shell opens the thread with no q" eval '[[ $code -eq 0 ]] && opened && ! quit'
check "the pager gets the copy headed by the topic" eval '
  [[ $(cat "$tmp/view/t-ex0001-topic.md") == $'"'"'## 話題\n\n### オーナー · 2026-01-01 09:00\n\n本文'"'"' ]] && rg -qF -- "-- '"'"'$tmp/view/t-ex0001-topic.md'"'"'" "$FAKE_LOG"'
check "the pane is labelled with the topic" eval 'rg -qx "rename w1:p2 thread - 話題" "$FAKE_LOG"'
check "the thread file is not written" eval 'rg -q "^topic: 話題$" "$tmp/threads/t-ex0001-topic.md" && ! rg -q "^## " "$tmp/threads/t-ex0001-topic.md"'

show '["zsh"]' t-ex0002-none.md
check "a thread without a topic is refused" eval '[[ $code -ne 0 && $out == *"no topic"* && ! -s $FAKE_LOG ]]'

show '["less", "starship", "zsh"]'
check "the pager gets q and the thread opens after starship draws the prompt" eval '[[ $code -eq 0 ]] && quit && opened'

show '["less", "direnv.darwin-a", "starship", "zsh"]'
check "the thread opens after direnv's prompt hook runs" eval '[[ $code -eq 0 ]] && quit && opened'

show '["starship", "starship", "-zsh"]'
check "a pane drawing its prompt opens the thread once the shell shows" eval '[[ $code -eq 0 ]] && opened && ! quit'

show '["less", "less", "zsh"]'
check "a pager still drawing is waited out" eval '[[ $code -eq 0 ]] && quit && opened'

show '["less", "starship", "vim"]'
check "a pane that turns to another program gets nothing after the q" eval '
  [[ $code -eq 1 && $out == *"running vim; not sending keys"* ]] && ! opened && [[ $(rg -c . "$FAKE_LOG") -eq 1 ]]'

show '["node"]'
check "a pane running another program gets nothing" eval '[[ $code -eq 1 && ! -s $FAKE_LOG ]]'

show '["starship"]'
check "a pane that never leaves starship gets nothing" eval '[[ $code -eq 1 ]] && ! opened && ! quit'

if [[ $failed -gt 0 ]]; then echo "$failed failed"; exit 1; fi
echo "all passed"
