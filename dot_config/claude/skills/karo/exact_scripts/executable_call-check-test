#!/usr/bin/env bash
# shellcheck disable=SC2016,SC2088  # the commands are single-quoted on purpose: they are the hook's input
# Show that call-check stops a path to a script in the plugin's bin/ (the herdr-agent skill's
# scripts included, reads too), a git rebase that asks to leave the sandbox, a herdr call joined to
# another command or a file redirection, and a lone herdr call that asks to leave the sandbox, while
# it lets through calls by name, tests in scripts/ by path, git rebase --abort, a rebase inside the sandbox, lone herdr calls (2>&1
# included), and quoted text and heredoc bodies that mention git rebase or herdr. settings-test
# checks that karo's hooks/hooks.json runs it.
# usage: call-check-test [<call-check>]   (default: the one beside this script)
set -uo pipefail
exec </dev/null
bin=$(cd "$(dirname "$0")" && pwd)
hc=${1:-$bin/call-check}
# /bin/bash on macOS cannot make a here document while the current folder is one it may not write, even
# with TMPDIR writable, so the test runs from TMPDIR.
cd "${TMPDIR:-/tmp}" || exit 2
failed=0
fail() { printf 'FAIL\t%s\n' "$1"; failed=$((failed+1)); }
pass() { printf 'ok\t%s\n' "$1"; }

# run <command> [<dangerouslyDisableSandbox>]: feed the hook a Bash PreToolUse input.
run() {
  out=$(jq -n --arg c "$1" --argjson d "${2:-false}" \
    '{hook_event_name: "PreToolUse", tool_name: "Bash", tool_input: {command: $c, dangerouslyDisableSandbox: $d}}' |
    LC_ALL=en_US.UTF-8 "$hc" 2>&1); code=$?
}
stops_path() {
  run "$@"
  if [[ $code -eq 2 && $out == *'bin/ の script（…/bin/karo-<name>）をパスで指している。'* && $out == *'名前だけで、単独で呼び直す'* ]]; then pass "stops_path: $1"
  else fail "stops_path: $1: exit $code: $out"; fi
}
passes() {
  run "$@"
  if [[ $code -eq 0 && -z $out ]]; then pass "passes: $1 ${2:-}"; else fail "passes: $1 ${2:-}: exit $code: $out"; fi
}

stops_path '~/.claude/skills/karo/bin/karo-commit s b x'
stops_path "$HOME/.claude/skills/karo/bin/karo-land b"
stops_path '$HOME/.claude/skills/karo/bin/karo-check --only doc/a.md'
stops_path '"${CLAUDE_PLUGIN_ROOT}"/bin/karo-check'
stops_path '/opt/plugins/karo/bin/karo-agent-ctl close a1'
stops_path 'cat /opt/plugins/karo/bin/karo-agent-ctl'
stops_path '/opt/plugins/karo/bin/karo-agent-report a1 | head'

# git rebase outside the sandbox, in the shapes karo and Agents have run it in.
stops_rebase() {
  run "$1" true
  if [[ $code -eq 2 && $out == *'git rebase を sandbox の外で'* && $out == *'karo-land <branch> --rebase'* ]]; then pass "stops_rebase: $1"
  else fail "stops_rebase: $1: exit $code: $out"; fi
}
stops_rebase 'git -c core.hooksPath=/dev/null -c core.fsmonitor=false -c maintenance.auto=false -c gc.auto=0 -C /home/owner/.local/state/karo/worktrees/land-agent-branches rebase main'
stops_rebase 'git rebase main'
stops_rebase 'git status --short && git rebase main 2>&1 | tail -5; git status --short | head'
stops_rebase 'cd ~/.local/state/karo/worktrees/markdown-format && git rebase -q main && git log --oneline -3'
passes 'git rebase main'
passes 'git -c core.hooksPath=/dev/null -C /home/owner/.local/state/karo/worktrees/x rebase --abort' true
passes 'git log --oneline main..HEAD' true
passes "rg -n 'git rebase main' notes.md" true
passes "cat > s.sh <<'EOF'
git rebase main
EOF" true

# herdr joined to another command or a file redirection, and a lone one that asks to leave the sandbox.
stops_herdr() {
  run "$@"
  if [[ ${2:-false} == true ]]; then first='dangerouslyDisableSandbox は要らない。herdr'; else first='つないでいる。herdr'; fi
  if [[ $code -eq 2 && $out == *"$first"* && $out == *単独の呼び出しで実行する* && $out == *socket* ]]; then pass "stops_herdr: $1 ${2:-}"
  else fail "stops_herdr: $1 ${2:-}: exit $code: $out"; fi
}
stops_herdr 'herdr pane layout --current | head'
stops_herdr 'herdr status --json; echo'
stops_herdr 'herdr agent list > f'
stops_herdr 'herdr status --json 2>/dev/null'
stops_herdr 'herdr workspace list && echo done'
stops_herdr 'herdr tab list || true'
stops_herdr 'x=$(herdr status)'
stops_herdr 'echo `herdr agent list`'
stops_herdr 'herdr api snapshot > snapshot.json'
stops_herdr 'herdr pane list
herdr tab list'
stops_herdr "echo \"it's\"; herdr pane list"
stops_herdr 'herdr status --json' true
stops_herdr 'herdr pane layout --current' true

passes 'karo-commit s b x'
passes 'karo-land b'
passes 'karo-agent-ctl close a1'
passes 'karo-safe-key enter a1'
passes '/opt/plugins/karo/scripts/karo-check-test'
passes '/opt/plugins/karo/skills/land/scripts/land-test'
passes 'git status'
passes 'git status' true
passes 'herdr agent list'
passes 'herdr pane layout --current'
passes 'herdr pane layout --current 2>&1'
passes 'herdr agent list --json'
passes "jq '.a | .b' f"
passes 'git log | head'
passes "rg -n 'herdr status | head' notes.md"
passes 'herdr --session x workspace list'
passes 'herdr --session x workspace list' true
passes 'herdr --skill | head'
passes 'herdr api snapshot'
passes "cat > s.sh <<'EOF'
herdr pane list | jq .
EOF"

echo "call-check-test: $failed failure(s)" >&2
[ "$failed" -eq 0 ]
