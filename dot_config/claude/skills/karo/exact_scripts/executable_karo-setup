#!/usr/bin/env bash
# Set up the karo record repository at KARO_HOME (default ~/karo), or with --check only check the tools.
# It checks the tools that karo's scripts, hooks and skills call, listed once below, and installs none:
# each missing tool gets a line naming where to get it. A missing required tool stops the run before it
# writes anything (exit 1); a missing feature tool names the feature that will not work and the run goes on.
# The setup makes the folder and its git repository on main, copies the skeleton folder of this plugin
# file by file, leaving every file already there as it is, makes the record folders listed in
# record-folders, commits the files it copied, and makes the task database with bd init when .beads is
# missing. A second run changes nothing.
# Run the setup in a terminal: the sandbox of a Claude Code session lets no command write .claude/.
# usage: karo-setup [--check]
set -uo pipefail
exec </dev/null
[[ $# -eq 0 || ( $# -eq 1 && $1 == --check ) ]] || { echo "usage: karo-setup [--check]" >&2; exit 2; }

# <tool>|<"required", or the feature that does not work without it>|<where to get it>
tools=(
  'claude|required|https://code.claude.com/docs/en/setup'
  'herdr|required|https://github.com/herdrdev/herdr'
  'git|required|https://git-scm.com/downloads'
  'bd|required|https://github.com/gastownhall/beads'
  'jq|required|https://jqlang.org/download/'
  'yq|required|https://github.com/mikefarah/yq'
  'rg|required|https://github.com/BurntSushi/ripgrep'
  'fd|required|https://github.com/sharkdp/fd'
  'rumdl|required|https://github.com/rvben/rumdl'
  'lsof|required|the lsof package of the OS'
  'ps|required|the procps package of the OS'
  'bv|task analysis (karo:tasks)|https://github.com/Dicklesworthstone/beads_viewer'
  'cass|past conversations (karo:recall)|https://github.com/Dicklesworthstone/coding_agent_session_search'
  'crit|crit reviews (karrybit:crit)|https://github.com/tomasz-tomczyk/crit'
  'terminal-browser|opening pages (view-open, crit-open)|https://terminal-browser.com/'
  'gh|pull request checks (karrybit:publish-check)|https://cli.github.com/'
  'uuidgen|HTML explanations (karo:explain)|the util-linux or uuid-runtime package of the OS'
)
missing=0
for t in "${tools[@]}"; do
  name=${t%%|*}; rest=${t#*|}; need=${rest%%|*}; from=${rest#*|}
  command -v "$name" >/dev/null && continue
  if [[ $need == required ]]; then
    printf 'missing: %s (required): install it from %s\n' "$name" "$from"
    missing=$((missing+1))
  else
    printf 'missing: %s (%s will not work): install it from %s\n' "$name" "$need" "$from"
  fi
done
if (( missing )); then
  echo "karo-setup: $missing required tool(s) missing, nothing changed" >&2
  exit 1
fi
[[ ${1:-} == --check ]] && { echo "karo-setup: required tools found" >&2; exit 0; }

plugin=$(cd "$(dirname "$0")/.." && pwd)
home=${KARO_HOME:-$HOME/karo}
mkdir -p "$home" && cd "$home" || exit 2
[[ -e .git ]] || git init -q -b main || exit 2

copied=()
while IFS= read -r f; do
  [[ -e $f ]] && continue
  mkdir -p "$(dirname "$f")" && cp "$plugin/skeleton/$f" "$f" || exit 2
  copied+=("$f")
done < <(cd "$plugin/skeleton" && find . -type f | sed 's#^\./##' | sort)
read -r -a folders < "$plugin/scripts/record-folders"
mkdir -p "${folders[@]}" || exit 2
if (( ${#copied[@]} )); then
  git add -- "${copied[@]}" && git commit -q -m "Add the karo skeleton" -- "${copied[@]}" || exit 2
fi
# The ID prefix is given, since bd takes the folder name when it is not, and karo's IDs start with karo-.
if [[ ! -e .beads ]]; then
  BD_DISABLE_METRICS=1 DO_NOT_TRACK=1 BD_NO_PUSH=1 \
    bd init --quiet --stealth --non-interactive --skip-agents --skip-hooks --prefix karo || exit 2
fi
printf 'karo-setup: %s is set up, %d file(s) copied\n' "$home" "${#copied[@]}" >&2
