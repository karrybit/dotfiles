#!/usr/bin/env python3
"""Apply one CoS write instruction to the record vault and commit it.

usage: record [<instruction file>]   (reads standard input when no file is given)
       record --detach <instruction file>
       record --restart-crit

The instruction has the form described in rules/record.md ("書き込みの指示の形"). Without a commit
body, the commit body is the instruction's journal lines (the "- " lines it appends to or creates in a
day's journal, journal/YYYY-MM-DD.md), and an instruction with neither is an NG. An append to a day's
journal that does not exist yet creates it with its frontmatter and heading; an append to a day's
standup (journal/YYYY-MM-DD-standup.md) that does not exist creates it with its frontmatter, deriving
from the latest day's journal up to its day, and so does an append to a thread of a task with a t- ID,
taking the frontmatter from the task's file, tasks/<ID>.md. A thread of a task with a bd ID (cos- and
three to eight letters or digits, a child with ".<n>" added) starts with a "新規:" that carries its
frontmatter. A "新規:" of a thread or a standup without frontmatter is an NG. A "行:" item sets
named cells of the one table row whose first cell is the given ID, from "<column>: <value>" lines
under the table's header. A
"行を足す:" item adds a row, from the same lines, to the end of the table under the given heading (or
the file's only table); a first cell already in that table is an NG. An
"追記:" or "新規:" item for a thread file (threads/, except threads/memo.md) carries a "タスク:" line
with the one task it is about, which must be in the tasks of the thread's frontmatter; the line is
not written. Every item is checked
against the vault before anything is written; one bad item writes nothing. After writing, the
Markdown files written are formatted with rumdl, the instruction's paths are staged, and
git diff --cached --check and karo-check (beside this script) --only <each staged path> (the staged
files and the notes that depend on them) must pass before the commit. An instruction that leaves every
file as it was is an OK without a commit ("OK - <subject>（変更なし）"). A failure after writing
puts the files and the index back as they were.

The last line of standard output is "OK <commit> <subject>" (exit 0) or "NG <subject>: <reason>"
(exit 1). An NG is also added to the problems file, which a hook shows to the CoS, with the name of
the instruction's copy; an OK removes the entries each "解決:" line names, and only those: an NG by the
name of its copy, so two NGs that share a subject are cleared one by one and an unrelated instruction
never clears an NG the CoS has not seen; a step's entry (crit, thread-show) by its name.

crit lists only the files that existed when it started. When the commit adds, deletes, or renames a
file and a crit daemon runs "crit ." in the vault, record restarts it with --no-open (the session and
its comments stay) and prints a line before the OK; a failed restart leaves the OK as it is.
--restart-crit does only the restart, for commits made elsewhere (a merge).

When the commit wrote a file under threads/, record then runs thread-show on each such file, in the
order of the instruction, so the thread pane shows the conversation; a failure prints a line before
the OK. A crit restart or thread-show that fails also goes to the problems file, under "crit" or
"thread-show"; a later run of the same step that succeeds (for crit, also one that finds no "crit ."
running) removes it.

--detach queues the instruction, with {日付} and {時刻} filled at that moment, and returns at once with
"queued <name>" (or an NG, with nothing queued); a worker it starts in its
own session applies the queue in the order it was queued, one instruction at a time, and stops when
the queue is empty. Nothing reports back: an NG and a failed step reach the CoS through the problems
file, and each instruction's copy under the state folder ends with its result.

Environment: COS_DIR (default ~/cos), COS_RECORD_STATE (default ~/.local/state/cos/record; one
file per instruction, the queue, and the locks), COS_RECORD_PROBLEMS (default
~/.local/state/cos/record/problems.md), COS_THREAD_SHOW (default thread-show beside this script; empty
to skip it).
"""
import datetime
import fcntl
import json
import os
import shutil
import stat
import tempfile
import re
import subprocess
import sys
import time

HOME = os.path.expanduser("~")
COS = os.path.realpath(os.environ.get("COS_DIR") or os.path.join(HOME, "cos"))
STATE = os.environ.get("COS_RECORD_STATE") or os.path.join(HOME, ".local/state/cos/record")
PROBLEMS = os.environ.get("COS_RECORD_PROBLEMS") or os.path.join(HOME, ".local/state/cos/record/problems.md")
BIN = os.path.dirname(os.path.realpath(__file__))
QUEUE = os.path.join(STATE, "queue")
THREAD_SHOW = os.environ.get("COS_THREAD_SHOW", os.path.join(BIN, "thread-show"))
FENCE = "~~~~"
PROBLEMS_HEADING = "## record からの問題"
RECORD_FILES = {"state.md", "assignments.md"}
RECORD_DIRS = {"journal", "decisions", "investigations", "projects", "threads", "docs", "tasks"}
# A task ID is a bd ID or a t- ID; only a t- task has a file, tasks/<ID>.md.
OLD_TASK_ID = r"t-[a-z0-9]{8}"
TASK_ID = rf"{OLD_TASK_ID}|cos-[a-z0-9]{{3,8}}(\.[0-9]+)*"


class Bad(Exception):
    """A reason for NG; lines are a checker's output, printed verbatim above the NG line."""
    def __init__(self, reason, lines=()):
        super().__init__(reason)
        self.lines = list(lines)


def parse(text):
    """Return (subject, body, resolves, items); items are (kind, path, texts)."""
    lines = text.split("\n")
    i = 0

    def skip_blank():
        nonlocal i
        while i < len(lines) and lines[i].strip() == "":
            i += 1

    def block(what):
        nonlocal i
        skip_blank()
        if i >= len(lines) or lines[i] != FENCE:
            raise Bad(f"{what}: 本文の {FENCE} の行がない（{i + 1} 行目）")
        start = i + 1
        i = start
        while i < len(lines) and lines[i] != FENCE:
            i += 1
        if i >= len(lines):
            raise Bad(f"{what}: 本文を閉じる {FENCE} の行がない")
        i += 1
        return "\n".join(lines[start:i - 1])

    def declared():
        """The ID on a "タスク:" line right under an item's line, or None."""
        nonlocal i
        skip_blank()
        if i < len(lines) and (v := field("タスク:", lines[i])) is not None:
            i += 1
            return v
        return None

    def field(prefix, line):
        if not line.startswith(prefix):
            return None
        value = line[len(prefix):].strip()
        if not value:
            raise Bad(f"{prefix} の値がない")
        return value

    skip_blank()
    if i >= len(lines) or lines[i].strip() != "書き込み指示":
        raise Bad("1 行目が「書き込み指示」でない")
    i += 1
    skip_blank()
    subject = field("commit 件名:", lines[i]) if i < len(lines) else None
    if subject is None:
        raise Bad("「commit 件名:」の行がない")
    i += 1
    skip_blank()
    body = None
    if i < len(lines) and lines[i].strip() == "commit 本文:":
        i += 1
        body = block("commit 本文")
    resolves, items = [], []
    while True:
        skip_blank()
        if i >= len(lines):
            break
        line = lines[i]
        i += 1
        if (v := field("解決:", line)) is not None:
            resolves.append(v)
        elif (v := field("追記:", line)) is not None:
            task = declared()
            items.append(("追記", v, [block(line), task]))
        elif (v := field("新規:", line)) is not None:
            task = declared()
            items.append(("新規", v, [block(line), task]))
        elif (v := field("置き換え:", line)) is not None:
            items.append(("置き換え", v, [block(line), block(line)]))
        elif (v := field("取り込み:", line)) is not None:
            items.append(("取り込み", v, []))
        elif (v := field("行を足す:", line)) is not None:
            path, _, heading = v.partition(" ")
            items.append(("行を足す", path, [heading.strip(), block(line)]))
        elif (v := field("行:", line)) is not None:
            path, _, key = v.partition(" ")
            if not key.strip():
                raise Bad(f"行: 表の行の ID がない: {line}")
            items.append(("行", path, [key.strip(), block(line)]))
        else:
            raise Bad(f"知らない行: {line}")
    if not items:
        raise Bad("書き込みの項目がない")
    if body is None:
        # Without a body the commit carries the journal lines, whose sources say why.
        body = "\n".join(l for kind, path, texts in items if kind in ("追記", "新規") and re.search(r"(^|/)journal/\d{4}-\d{2}-\d{2}\.md$", path)
                         for l in texts[0].split("\n") if l.startswith("- "))
        if not body:
            raise Bad("「commit 本文:」がなく、journal の行もない")
    return subject, body, resolves, items


def check_thread_task(kind, path, task, text):
    """A threads/ item declares the one task it is about, among the tasks of the thread's frontmatter
    (text is the file before an append, or the new file's body); threads/memo.md has no task."""
    if not path.startswith("threads/") or path == "threads/memo.md":
        if task is not None:
            raise Bad(f"{kind}: {path}: 「タスク:」は threads の会話のファイルの項目にだけ書く")
        return
    if task is None:
        raise Bad(f"{kind}: {path}: 「タスク:」の行がない（項目の行の下に、どのタスクの話かを書く）")
    if not re.fullmatch(TASK_ID, task):
        raise Bad(f"{kind}: {path}: 「タスク:」はタスク ID 1 つ（話題が 2 つなら項目を分ける）: {task}")
    p = subprocess.run(["yq", "--front-matter=extract", ".tasks // [] | .[]", "-"],
                       input=text, capture_output=True, text=True)
    if p.returncode != 0:
        raise Bad(f"{kind}: {path}: フロントマターが読めない", (p.stderr or p.stdout).strip().splitlines())
    if task not in p.stdout.split():
        raise Bad(f"{kind}: {path}: {task} がフロントマターの tasks にない（{task} のファイルに書く）")


def record_path(path):
    """Return the path relative to the vault, or raise when it is outside the record destinations."""
    if path.startswith("~/cos/"):
        path = path[len("~/cos/"):]
    elif os.path.isabs(path) and path.startswith(COS + "/"):
        path = path[len(COS) + 1:]
    norm = os.path.normpath(path)
    parts = norm.split("/")
    if os.path.isabs(path) or ".." in parts or not (
            norm in RECORD_FILES or (parts[0] in RECORD_DIRS and len(parts) > 1)):
        raise Bad(f"記録の書き先でない: {path}")
    # record runs outside the sandbox, so a link the sandbox could plant must not lead it outside the record.
    for i in range(1, len(parts) + 1):
        if os.path.islink(os.path.join(COS, *parts[:i])):
            raise Bad(f"記録の書き先でない（シンボリックリンクを通る）: {path}")
    if os.path.realpath(os.path.join(COS, norm)) != os.path.join(COS, norm):
        raise Bad(f"記録の書き先でない: {path}")
    return norm


# Every file access below walks the record path one component at a time from an open ~/cos, opening
# each folder with O_NOFOLLOW, so a link swapped in after record_path checked the path is not followed.
def _parent(path, create=False):
    """Return (an fd of the record path's folder, the file name); the caller closes the fd."""
    parts = record_path(path).split("/")
    fd = os.open(COS, os.O_RDONLY | os.O_DIRECTORY)
    try:
        for name in parts[:-1]:
            if create:
                try:
                    os.mkdir(name, 0o755, dir_fd=fd)
                except FileExistsError:
                    pass
            try:
                nfd = os.open(name, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=fd)
            except FileNotFoundError:
                if create:
                    raise
                os.close(fd)
                return None, parts[-1]
            except OSError:
                raise Bad(f"記録の書き先でない（シンボリックリンクを通る）: {path}")
            os.close(fd)
            fd = nfd
    except BaseException:
        os.close(fd)
        raise
    return fd, parts[-1]


def read_file(path):
    """The bytes of a record file, or None when there is none."""
    dfd, name = _parent(path)
    if dfd is None:
        return None
    try:
        fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW, dir_fd=dfd)
    except FileNotFoundError:
        return None
    except OSError as e:
        if os.path.islink(os.path.join(COS, path)):
            raise Bad(f"記録の書き先でない（シンボリックリンクを通る）: {path}")
        raise Bad(f"{path}: 読めない: {e}")
    finally:
        os.close(dfd)
    with os.fdopen(fd, "rb") as f:
        st = os.fstat(f.fileno())
        if not stat.S_ISREG(st.st_mode):
            raise Bad(f"{path}: ファイルでない")
        # A hard link could make a file outside the record readable (and writable) through a record path.
        if st.st_nlink > 1:
            raise Bad(f"記録の書き先でない（ハードリンクがある）: {path}")
        return f.read()


def write_file(path, data):
    """Write a new file in the folder and rename it over the name, so a link at the name (hard or
    symbolic) is replaced rather than written through."""
    dfd, name = _parent(path, create=True)
    tmp = f".{name}.record-{os.getpid()}"
    try:
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o644, dir_fd=dfd)
        try:
            with os.fdopen(fd, "wb") as f:
                f.write(data)
            os.replace(tmp, name, src_dir_fd=dfd, dst_dir_fd=dfd)
        except BaseException:
            try:
                os.unlink(tmp, dir_fd=dfd)
            except FileNotFoundError:
                pass
            raise
    except OSError as e:
        raise Bad(f"{path}: 書けない: {e}")
    finally:
        os.close(dfd)


def remove_file(path):
    dfd, name = _parent(path)
    if dfd is None:
        return
    try:
        st = os.stat(name, dir_fd=dfd, follow_symlinks=False)
        if stat.S_ISREG(st.st_mode):
            os.unlink(name, dir_fd=dfd)
    except FileNotFoundError:
        pass
    finally:
        os.close(dfd)


def format_md(texts):
    """Run rumdl on private copies under the state folder, keeping the vault-relative paths so the
    config's excludes apply, and return the formatted texts; rumdl never opens a vault path."""
    work = tempfile.mkdtemp(prefix="fmt-", dir=STATE)
    try:
        for path, text in texts.items():
            os.makedirs(os.path.join(work, os.path.dirname(path)), exist_ok=True)
            with open(os.path.join(work, path), "w", encoding="utf-8") as f:
                f.write(text)
        # The config sits at the vault root, which the sandbox cannot write.
        cfg_path = os.path.join(COS, ".rumdl.toml")
        p = subprocess.run(["rumdl", "fmt", "--silent", "--no-code-block-tools",
                            *(["--config", cfg_path] if os.path.isfile(cfg_path) else []), *texts],
                           cwd=work, capture_output=True, text=True)
        if p.returncode != 0:
            raise Bad(f"rumdl fmt が失敗（終了コード {p.returncode}）", (p.stderr or p.stdout).strip().splitlines())
        out = {}
        for path in texts:
            with open(os.path.join(work, path), encoding="utf-8") as f:
                out[path] = f.read()
        return out
    finally:
        shutil.rmtree(work, ignore_errors=True)


def count(haystack, needle):
    n, start = 0, 0
    while (k := haystack.find(needle, start)) >= 0:
        n += 1
        start = k + 1
    return n


# record runs outside the sandbox, but sandboxed sessions can write the vault's .git, except its config
# file. So every git that record and crit run (crit's daemon outlives record) runs no hooks, fsmonitor,
# or automatic maintenance, and has its git folder and common folder named, so a commondir file in .git
# is not followed. The only repository config git then reads is .git/config: config.worktree is read
# only when extensions.worktreeConfig is set, which SAFE_KEY refuses. Since the sandbox cannot change
# that file, check_git_config runs before a run's git and crit commands, not before each one, and allows
# only the keys below, none of which makes git run a command.
OVERRIDES = [("core.hooksPath", "/dev/null"), ("core.fsmonitor", "false"), ("gc.auto", "0"), ("maintenance.auto", "false")]
GIT_DIR = os.path.join(COS, ".git")
GIT_ENV = {**os.environ, "GIT_DIR": GIT_DIR, "GIT_COMMON_DIR": GIT_DIR, "GIT_WORK_TREE": COS,
           "GIT_CONFIG_COUNT": str(len(OVERRIDES)),
           **{f"GIT_CONFIG_KEY_{i}": k for i, (k, _) in enumerate(OVERRIDES)},
           **{f"GIT_CONFIG_VALUE_{i}": v for i, (_, v) in enumerate(OVERRIDES)}}
GIT = ["git", "-C", COS]
SAFE_KEY = re.compile(r"^core\.(repositoryformatversion|filemode|bare|logallrefupdates|ignorecase|precomposeunicode|symlinks)$|"
                      r"^user\.(name|email)$|^branch\.[^.]+\.(remote|merge)$|^beads\.role$")


def check_git_config():
    """Refuse unless the repository config holds only SAFE_KEY keys."""
    if os.path.islink(GIT_DIR) or not os.path.isdir(GIT_DIR):
        raise Bad(f"{GIT_DIR} がフォルダでない（record は本体のチェックアウトにだけ書く）")
    redirects = [f for f in ("commondir", "gitdir") if os.path.lexists(os.path.join(GIT_DIR, f))]
    if redirects:
        raise Bad(f"{GIT_DIR} にほかのリポジトリを指すファイルがある（本体のチェックアウトにはない）: " + ", ".join(redirects),
                  redirects)
    p = subprocess.run([*GIT, "config", "--list", "--show-scope", "--name-only"], env=GIT_ENV,
                       capture_output=True, text=True)
    if p.returncode != 0:
        raise Bad(f"git config が失敗: {(p.stderr or p.stdout).strip()}")
    bad = [k for scope, _, k in (l.partition("\t") for l in p.stdout.splitlines())
           if scope in ("local", "worktree") and not SAFE_KEY.match(k.lower())]
    if bad:
        raise Bad("~/cos の git の設定に record が許していない項目がある（record は sandbox の外で動くので止めた）: "
                  + ", ".join(bad), bad)


def git(*args, check=True):
    p = subprocess.run([*GIT, *args], env=GIT_ENV, capture_output=True, text=True)
    if check and p.returncode != 0:
        out = (p.stderr or p.stdout).strip().splitlines()
        raise Bad(f"git {args[0]} が失敗: " + " / ".join(out), out)
    return p


SEPARATOR = re.compile(r"^\|(\s*:?-+:?\s*\|)+$")


def cells(row):
    return [c.strip() for c in row.strip()[1:-1].split("|")]


def update_row(path, text, key, changes):
    """Set the named cells of the one table row whose first cell is key; return the new text."""
    lines = text.split("\n")
    hits = [i for i, l in enumerate(lines) if l.startswith("|") and not SEPARATOR.match(l) and cells(l)[0] == key]
    if len(hits) != 1:
        raise Bad(f"行: {path}: 1 列目が {key} の行が {len(hits)} 行")
    i = hits[0]
    if "\\|" in lines[i]:
        raise Bad(f"行: {path}: {key} の行に \\| がある")
    sep = next((j for j in range(i - 1, 0, -1) if SEPARATOR.match(lines[j])), None)
    if sep is None or not lines[sep - 1].startswith("|"):
        raise Bad(f"行: {path}: {key} の行の表の見出しがない")
    head, row = cells(lines[sep - 1]), cells(lines[i])
    if len(head) != len(row):
        raise Bad(f"行: {path}: {key} の行の列の数が見出しと違う")
    for raw in changes.split("\n"):
        if not raw.strip():
            continue
        name, colon, value = raw.partition(":")
        name, value = name.strip(), value.strip()
        if not colon or name not in head:
            raise Bad(f"行: {path}: 見出しにない列: {name or raw}（列は {'・'.join(head)}）")
        if "|" in value:
            raise Bad(f"行: {path}: 値に | がある: {value}")
        row[head.index(name)] = value
    lines[i] = "| " + " | ".join(row) + " |"
    return "\n".join(lines)


def add_row(path, text, heading, changes):
    """Add a row to the end of the table under the heading (or the file's only table), from
    "<column>: <value>" lines; columns not named stay empty. Return the new text."""
    lines = text.split("\n")
    tables = [h for h in range(len(lines) - 1) if lines[h].startswith("|") and SEPARATOR.match(lines[h + 1])]
    if heading:
        marks = [k for k, l in enumerate(lines) if re.fullmatch(r"#+ " + re.escape(heading), l.strip())]
        if len(marks) != 1:
            raise Bad(f"行を足す: {path}: 見出し「{heading}」が {len(marks)} か所")
        nxt = next((k for k in range(marks[0] + 1, len(lines)) if lines[k].startswith("#")), len(lines))
        tables = [h for h in tables if marks[0] < h < nxt]
    if len(tables) != 1:
        where = f"見出し「{heading}」の下" if heading else "ファイル（見出しを書いて表を選ぶ）"
        raise Bad(f"行を足す: {path}: {where}の表が {len(tables)} 個")
    h = tables[0]
    head = cells(lines[h])
    row = [""] * len(head)
    for raw in changes.split("\n"):
        if not raw.strip():
            continue
        name, colon, value = raw.partition(":")
        name, value = name.strip(), value.strip()
        if not colon or name not in head:
            raise Bad(f"行を足す: {path}: 見出しにない列: {name or raw}（列は {'・'.join(head)}）")
        if "|" in value:
            raise Bad(f"行を足す: {path}: 値に | がある: {value}")
        row[head.index(name)] = value
    if not row[0]:
        raise Bad(f"行を足す: {path}: 1 列目（{head[0]}）の値がない")
    end = h + 2
    while end < len(lines) and lines[end].startswith("|"):
        if cells(lines[end])[0] == row[0]:
            raise Bad(f"行を足す: {path}: 1 列目が {row[0]} の行がもうある")
        end += 1
    lines.insert(end, "| " + " | ".join(row) + " |")
    return "\n".join(lines)


def planned(path, state):
    """The text of a vault file after the items so far, or None when there is none."""
    if path in state:
        return state[path]
    data = read_file(path)
    return None if data is None else data.decode("utf-8")


def new_note(path, task, state):
    """The frontmatter that starts a thread or a standup an 追記 creates, or None for other paths.
    A thread of a t- task takes its topic and description from the description of the declared task's
    file, tasks/<ID>.md, and its project from that file's first project; a thread of a bd task has no
    file to take them from. A standup derives from the latest journal up to its day."""
    if path.startswith("threads/") and path != "threads/memo.md":
        if not task:
            raise Bad(f"追記: {path}: 「タスク:」の行がない（項目の行の下に、どのタスクの話かを書く）")
        if not re.fullmatch(OLD_TASK_ID, task):
            raise Bad(f"追記: {path}: ファイルがない（{task} の threads は 新規: でフロントマターを付けて作る）")
        text = planned(f"tasks/{task}.md", state)
        if text is None:
            raise Bad(f"追記: {path}: ファイルがなく、tasks/{task}.md もない（同じ指示の前の項目で 新規: tasks/{task}.md を書くと作れる）")
        p = subprocess.run(["yq", "-o=json", "--front-matter=extract", "[.description // \"\", (.projects // [])[0] // \"\"]", "-"],
                           input=text, capture_output=True, text=True)
        fields = json.loads(p.stdout) if p.returncode == 0 else None
        if not fields or not all(isinstance(v, str) and v for v in fields):
            raise Bad(f"追記: {path}: tasks/{task}.md のフロントマターに description か projects がない",
                      (p.stderr or p.stdout).strip().splitlines())
        title, project = json.dumps(fields[0], ensure_ascii=False), fields[1]
        return (f"---\ntype: Thread\ndescription: {title}\ntopic: {title}\ndate: {datetime.date.today()}\n"
                f"tasks:\n  - {task}\nprojects:\n  - {project}\n---\n\n")
    if m := re.fullmatch(r"journal/(\d{4}-\d{2}-\d{2})-standup\.md", path):
        jdir = os.path.join(COS, "journal")
        days = {p for p in state if state[p] is not None} | {f"journal/{n}" for n in (os.listdir(jdir) if os.path.isdir(jdir) else [])}
        days = sorted(p for p in days if re.fullmatch(r"journal/\d{4}-\d{2}-\d{2}\.md", p) and p <= f"journal/{m.group(1)}.md")
        if not days:
            raise Bad(f"追記: {path}: ファイルがなく、{m.group(1)} までの journal がない")
        return f"---\ntype: Standup\ndate: {m.group(1)}\nderived_from:\n  - {days[-1]}\n---\n\n"
    return None


STOPPED_NOTE = re.compile(r"^- \d{2}:\d{2} \[note\] .*(サブエージェント|Agent) ?を(途中で)?止め[たて、]")


def check_journal_lines(kind, path, text):
    """A delegation stopped part way ends with a [close] line, which insights counts as its end."""
    if not re.fullmatch(r"journal/\d{4}-\d{2}-\d{2}\.md", path):
        return
    for line in text.split("\n"):
        if STOPPED_NOTE.match(line):
            raise Bad(f"{kind}: {path}: 途中で止めた Agent やサブエージェントは [note] でなく [close] で書く: {line}")


def check_taken(full):
    """git add reads what it stages itself, so a 取り込み file, and every entry under a 取り込み folder, is
    neither a symbolic link nor a hard link, which could bring a file from outside the record into the commit."""
    for f in [full] + [os.path.join(d, n) for d, dirs, files in os.walk(full) for n in dirs + files]:
        st = os.lstat(f)
        rel = os.path.relpath(f, COS)
        if stat.S_ISLNK(st.st_mode):
            raise Bad(f"記録の書き先でない（シンボリックリンクを通る）: {rel}")
        if stat.S_ISREG(st.st_mode) and st.st_nlink > 1:
            raise Bad(f"記録の書き先でない（ハードリンクがある）: {rel}")


def plan(items):
    """Check every item against the vault and return {path: new content} for the files to write, and the 取り込み paths."""
    state = {}  # path -> content after the items so far (None: no file)
    taken = []
    for kind, raw, texts in items:
        path = record_path(raw)
        full = os.path.join(COS, path)
        if kind in ("追記", "新規"):
            check_journal_lines(kind, path, texts[0])
        if kind == "取り込み":
            if not os.path.lexists(full) or os.path.islink(full):
                raise Bad(f"取り込み: {path}: ファイルがない")
            check_taken(full)
            if not git("status", "--porcelain", "--", path).stdout.strip():
                raise Bad(f"取り込み: {path}: 未 commit の変更がない")
            taken.append(path)
            continue
        if path not in state:
            if os.path.isdir(full):
                raise Bad(f"{kind}: {path}: フォルダである")
            data = read_file(path)
            state[path] = None if data is None else data.decode("utf-8")
        cur = state[path]
        if kind == "追記":
            if cur is None and (m := re.fullmatch(r"journal/(\d{4}-\d{2}-\d{2})\.md", path)):
                # A day's journal starts with the first line written to it, whichever instruction that is.
                cur = f"---\ntype: Journal\ndate: {m.group(1)}\n---\n\n## {m.group(1)}\n\n"
            if cur is None:
                cur = new_note(path, texts[1], state)
            if cur is None:
                raise Bad(f"追記: {path}: ファイルがない")
            check_thread_task(kind, path, texts[1], cur)
            if cur and not cur.endswith("\n"):
                cur += "\n"
            state[path] = cur + texts[0] + "\n"
        elif kind == "新規":
            if cur is not None:
                raise Bad(f"新規: {path}: ファイルがもうある")
            if re.fullmatch(r"(threads/(?!memo\.md$)[^/]+|journal/\d{4}-\d{2}-\d{2}-standup)\.md", path) and not texts[0].startswith("---\n"):
                raise Bad(f"新規: {path}: フロントマターがない（standup と t- のタスクの threads は、まだないファイルに 追記: で書くと、record がフロントマターを付けて作る）")
            check_thread_task(kind, path, texts[1], texts[0])
            state[path] = texts[0] + "\n"
        elif kind == "行":
            if cur is None:
                raise Bad(f"行: {path}: ファイルがない")
            state[path] = update_row(path, cur, texts[0], texts[1])
        elif kind == "行を足す":
            if cur is None:
                raise Bad(f"行を足す: {path}: ファイルがない")
            state[path] = add_row(path, cur, texts[0], texts[1])
        elif kind == "置き換え":
            if cur is None:
                raise Bad(f"置き換え: {path}: ファイルがない")
            n = count(cur, texts[0]) if texts[0] else 0
            if n != 1:
                raise Bad(f"置き換え: {path}: 一致が {n} か所")
            state[path] = cur.replace(texts[0], texts[1], 1)
    return state, taken


def apply(subject, body, state, taken):
    state = {**state, **format_md({p: t for p, t in state.items() if p.endswith(".md")})}
    before = {path: read_file(path) for path in state}
    paths = list(state) + [p for p in taken if p not in state]
    try:
        for path, content in state.items():
            write_file(path, content.encode("utf-8"))
        git("add", "--", *paths)
        p = git("diff", "--cached", "--check", "--", *paths, check=False)
        if p.returncode != 0 or p.stdout.strip():
            found = p.stdout.strip().splitlines()
            raise Bad("git diff --cached --check: " + " / ".join(found), found)
        # Only the staged files and the notes that depend on them; a rename stages both paths.
        # -z keeps non-ASCII names as they are (core.quotePath would quote them); a rename has two paths.
        fields = git("diff", "--cached", "--name-status", "-M", "-z", "--", *paths).stdout.split("\0")
        only, i = [], 0
        while i < len(fields) and fields[i]:
            n = 2 if fields[i][0] in "RC" else 1
            only += [a for f in fields[i + 1:i + 1 + n] for a in ("--only", f)]
            i += 1 + n
        p = subprocess.run([os.path.join(BIN, "karo-check"), *only, COS], capture_output=True, text=True)
        if p.returncode != 0:
            found = [l for l in p.stdout.splitlines()
                     if "\tstale since " not in l and "\ttask in body not in tasks: " not in l]
            found = found or p.stderr.strip().splitlines()[-1:]
            raise Bad("karo-check: " + " / ".join(found), found)
        if git("diff", "--cached", "--quiet", "--", *paths, check=False).returncode == 0:
            # Nothing differs (a state.md rewrite from unchanged task files, a 行: to the value it has):
            # an OK without a commit, not an NG.
            return None
        git("commit", "-q", "-m", subject, "-m", body, "--", *paths)
    except BaseException:
        git("reset", "-q", "--", *paths, check=False)
        for path, data in before.items():
            try:
                if data is None:
                    remove_file(path)
                else:
                    write_file(path, data)
            except Exception:
                pass  # a path that now goes through a link is left alone
        raise
    # Committed: from here on nothing is undone.
    return git("rev-parse", "--short", "HEAD", check=False).stdout.strip() or "HEAD"


def restart_crit():
    """Restart the crit daemon reviewing the vault ("crit ." there), so its file list picks up added and
    removed files. Return a line to print, or None when no such daemon runs; raise Bad when it fails."""
    def status():
        p = subprocess.run(["crit", "status", "--json"], cwd=COS, env=GIT_ENV, capture_output=True, text=True, timeout=10)
        if p.returncode != 0:
            raise Bad(f"crit status が失敗: {(p.stderr or p.stdout).strip()}")
        s = json.loads(p.stdout)
        return s.get("daemon", {}).get("running") and any(x.get("args") == ["."] for x in s.get("sessions", []))
    if shutil.which("crit") is None:
        return None
    check_git_config()
    try:
        if not status():
            return None
        p = subprocess.run(["crit", "stop", "."], cwd=COS, env=GIT_ENV, capture_output=True, text=True, timeout=10)
        if p.returncode != 0:
            raise Bad(f"crit stop が失敗: {(p.stderr or p.stdout).strip()}")
        # The daemon lives only while this client does, so it gets its own session and outlives record.
        subprocess.Popen(["crit", ".", "--no-open"], cwd=COS, env=GIT_ENV, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)
        for _ in range(50):
            time.sleep(0.2)
            if status():
                return "crit: 起動し直した"
        raise Bad("crit . を起動したが 10 秒たっても動いていない")
    except (OSError, ValueError, subprocess.TimeoutExpired) as e:
        raise Bad(f"crit: {e}")


def note_step(name, line):
    """Keep a failed after-commit step in the problems file, or clear its entry when line is None."""
    now = datetime.datetime.now().strftime("%Y-%m-%d %H:%M")
    try:
        update_problems({name}, f"- {now} {name}: {line}" if line else None)
    except OSError as e:
        print(f"record: problems に書けなかった（commit は済んだ）: {one_line(e)[0]}")


def show_threads(paths):
    """Run thread-show on each thread file the commit wrote; return the lines to print."""
    if not THREAD_SHOW or not paths:
        return []
    out = []
    for path in paths:
        try:
            p = subprocess.run([THREAD_SHOW, os.path.join(COS, path)], stdin=subprocess.DEVNULL,
                               capture_output=True, text=True, timeout=60)
            ok, why = p.returncode == 0, (p.stderr or p.stdout).strip().replace("\n", " / ")
        except (OSError, subprocess.TimeoutExpired) as e:
            ok, why = False, str(e)
        if not ok:
            out.append(f"thread-show: {path} を開けなかった（commit は済んだ）: {why or '理由なし'}")
    # Only a commit that wrote threads clears the entry, and every failure of this one stays in it.
    note_step("thread-show", " / ".join(l[len("thread-show: "):] for l in out) or None)
    return out


def update_problems(drop, add=None):
    """Remove the entries drop names, then add one entry; an empty list empties the file. An NG entry is
    named by the name of its instruction's copy, which it carries; a step's entry (crit, thread-show) by
    its name."""
    try:
        old = open(PROBLEMS, encoding="utf-8").read().splitlines()
    except FileNotFoundError:
        old = []
    entries = [l for l in old if l.startswith("- ")]
    pat = re.compile(r"^- \d{4}-\d{2}-\d{2} \d{2}:\d{2} ")
    def named(l, s):
        if "（commit なし。" in l:
            return f"指示の写し: {s}）" in l
        return bool((m := pat.match(l)) and l[m.end():].startswith(s + ": "))
    keep = [l for l in entries if not any(named(l, s) for s in drop)]
    if add:
        keep.append(add)
    if keep == entries and os.path.exists(PROBLEMS):
        return
    os.makedirs(os.path.dirname(PROBLEMS), exist_ok=True)
    with open(PROBLEMS, "w", encoding="utf-8") as f:
        f.write(f"{PROBLEMS_HEADING}\n\n" + "\n".join(keep) + "\n" if keep else "")


def one_line(e):
    """The reason for an NG as one line, and the lines to print above it."""
    text = e.args[0] if isinstance(e, Bad) and e.args else f"{type(e).__name__}: {e}"
    parts = [l.strip() for l in str(text).splitlines() if l.strip()]
    lines = e.lines if isinstance(e, Bad) and e.lines else (parts if len(parts) > 1 else [])
    return " / ".join(parts) or type(e).__name__, lines


def open_lock():
    os.makedirs(STATE, exist_ok=True)
    lock = open(os.path.join(STATE, "lock"), "w")
    fcntl.flock(lock, fcntl.LOCK_EX)
    return lock


def run_instruction(raw, log=None):
    """Apply one instruction under the lock and print its result; return the exit code. log is the
    instruction's copy when the caller already made one (a queued instruction)."""
    try:
        lock = open_lock()
    except OSError as e:
        # Inside the sandbox the state directory is not writable; run record as its own command.
        print(f"NG (件名なし): {one_line(e)[0]}")
        if log:
            raise
        return 1
    with lock:
        now = datetime.datetime.now()
        date, clock = now.strftime("%Y-%m-%d"), now.strftime("%H:%M")
        if log is None:
            log = os.path.join(STATE, now.strftime("%Y-%m-%dT%H%M%S-") + f"{os.getpid()}-{time.time_ns() % 10**9}.txt")
            with open(log, "w", encoding="utf-8") as f:
                f.write(raw)
        text = raw.replace("\r\n", "\n").replace("{日付}", date).replace("{時刻}", clock)
        subject = "(件名なし)"
        m = re.search(r"^commit 件名:(.*)$", text, re.M)
        if m and m.group(1).strip():
            subject = m.group(1).strip()
        try:
            subject, body, resolves, items = parse(text)
            check_git_config()
            state, taken = plan(items)
            sha = apply(subject, body, state, taken)
        except Exception as e:
            reason, lines = one_line(e)
            update_problems(set(), f"- {date} {clock} {subject}: {reason}（commit なし。指示の写し: {os.path.basename(log)}）")
            with open(log, "a", encoding="utf-8") as f:
                f.write("\n" + "".join(f"# {l}\n" for l in lines) + f"# NG {reason}\n")
            for l in lines:
                print(l)
            print(f"NG {subject}: {reason}")
            return 1
        # The commit is made; a failure below is reported on its own line and the result stays OK.
        try:
            update_problems(set(resolves))
            with open(log, "a", encoding="utf-8") as f:
                f.write(f"\n# OK {sha or '-（変更なし）'}\n")
        except Exception as e:
            print(f"record: commit のあとの後始末に失敗（commit は済んだ）: {one_line(e)[0]}")
        if sha is None:
            print(f"OK - {subject}（変更なし）")
            return 0
        try:
            changed = git("diff-tree", "--no-commit-id", "--name-status", "-r", "-M", sha).stdout
            line = None
            if re.search(r"^[ADR]", changed, re.M):
                # Restarted, or seen not to run: either way no crit problem is left.
                line = restart_crit()
                note_step("crit", None)
        except Exception as e:
            line = f"crit: 起動し直せなかった（commit は済んだ）: {one_line(e)[0]}"
            note_step("crit", line[len("crit: "):])
        if line:
            print(line)
        threads = [p for p in state if p.startswith("threads/") and p.endswith(".md")]
        for l in show_threads(threads):
            print(l)
    print(f"OK {sha} {subject}")
    return 0


def detach(path):
    """Queue the instruction and start a worker in its own session; return at once."""
    raw = open(path, encoding="utf-8").read()
    # {日付} and {時刻} take the time the CoS queued the instruction, not the time a busy worker reaches it.
    now = datetime.datetime.now()
    raw = raw.replace("{日付}", now.strftime("%Y-%m-%d")).replace("{時刻}", now.strftime("%H:%M"))
    # The form needs no vault, so a malformed instruction is refused here, where the CoS sees it.
    parse(raw.replace("\r\n", "\n"))
    os.makedirs(QUEUE, exist_ok=True)
    name = f"{time.time_ns()}-{os.getpid()}.txt"
    tmp = os.path.join(QUEUE, "." + name)
    with open(tmp, "w", encoding="utf-8") as f:
        f.write(raw)
    os.rename(tmp, os.path.join(QUEUE, name))
    try:
        subprocess.Popen([sys.executable, os.path.realpath(__file__), "--drain"], stdin=subprocess.DEVNULL,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    except OSError:
        # Nothing will apply it, so it leaves the queue and the NG says to run it again.
        os.unlink(os.path.join(QUEUE, name))
        raise
    print(f"queued {name}")
    return 0


def queued():
    try:
        return sorted(n for n in os.listdir(QUEUE) if n.endswith(".txt") and not n.startswith("."))
    except FileNotFoundError:
        return []


def drain():
    """Apply the queue oldest first while holding the drain lock. A worker that cannot take the lock
    leaves the queue to the one holding it, which looks again after letting go, so nothing is stranded."""
    os.makedirs(STATE, exist_ok=True)
    while queued():
        with open(os.path.join(STATE, "drain.lock"), "w") as lock:
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                return 0
            while names := queued():
                # Moved off the queue to become the instruction's copy before it is applied: a crash then
                # leaves the copy without a result line rather than applying it twice.
                log = os.path.join(STATE, names[0])
                os.rename(os.path.join(QUEUE, names[0]), log)
                raw = open(log, encoding="utf-8").read()
                try:
                    run_instruction(raw, log)
                except Exception as e:
                    now = datetime.datetime.now().strftime("%Y-%m-%d %H:%M")
                    try:
                        update_problems(set(), f"- {now} record: 指示を適用できなかった: {one_line(e)[0]}（commit なし。指示の写し: {os.path.basename(log)}）")
                    except OSError:
                        pass
    return 0


def main():
    args = sys.argv[1:]
    if args == ["--restart-crit"]:
        try:
            lock = open_lock()
        except OSError as e:
            print(f"NG crit: {one_line(e)[0]}")
            return 1
        with lock:
            try:
                line = restart_crit()
            except (Bad, OSError) as e:
                reason, lines = one_line(e)
                for l in lines:
                    print(l)
                print(f"NG crit: {reason}")
                note_step("crit", reason)
                return 1
            note_step("crit", None)
        print(f"OK {line or 'crit: crit . は動いていない'}")
        return 0
    if args == ["--drain"]:
        return drain()
    if len(args) == 2 and args[0] == "--detach":
        try:
            return detach(args[1])
        except Exception as e:
            print(f"NG (件名なし): {one_line(e)[0]}")
            return 1
    if len(args) > 1 or (args and args[0].startswith("-")):
        print(__doc__.strip(), file=sys.stderr)
        return 2
    try:
        raw = open(args[0], encoding="utf-8").read() if args else sys.stdin.read()
    except OSError as e:
        print(f"NG (件名なし): {one_line(e)[0]}")
        return 1
    return run_instruction(raw)


if __name__ == "__main__":
    sys.exit(main())
