#!/bin/sh
# Check each given karo record note's frontmatter against rule/frontmatter-schema.yaml: its type, the type's
# required fields and path, projects from the project vocabulary, the form of date, and no [[...]] wiki link
# outside code. One yq and one
# jq call per note, so it suits the few files of a commit; a whole run of the record is karo-check's.
# usage: fmcheck <path>...   (run in KARO_HOME; paths from there)
# Prints "<path><TAB><problem>" per problem and exits 1 when any is found, or 2 when the schema cannot be
# read. A path outside the record folders, not .md, excluded by the schema, or removed is skipped.
# The expression is given, since yq takes a lone argument for the expression and a missing schema file
# would pass silently.
schema=$(yq -o=json . rule/frontmatter-schema.yaml) || exit 2
vocab=$(ls project/repo/*/*/*.md project/misc/*.md 2>/dev/null | sed -E 's#^project/(repo|misc)/##; s#\.md$##' | jq -Rn '[inputs]')
n=0
for p; do
  case $p in standup/*.md|source/*.md|investigation/*.md|project/*.md|doc/*.md) ;; *) continue ;; esac
  [ -f "$p" ] || continue
  fm=null
  if [ "$(head -n 1 "$p")" = --- ]; then
    fm=$(yq --front-matter=extract -o=json "$p" 2>/dev/null) || { printf '%s\tunparseable frontmatter\n' "$p"; n=$((n+1)); continue; }
  fi
  out=$(jq -rn --arg p "$p" --argjson s "$schema" --argjson v "$vocab" --argjson fm "$fm" '
    if any($s.exclude[]; . as $r | $p | test($r)) then empty
    elif $fm == null then "no frontmatter"
    elif ($s.types | has($fm.type // "") | not) then "unknown type: \($fm.type)"
    else $fm.type as $t
      | (select(($p | test($s.paths[$t] // ".")) | not) | "path does not match \($t)"),
        ($s.types[$t][] as $k | select(($fm[$k] // "") as $x | $x == "" or $x == []) | "missing \($k)"),
        (($fm.projects // [])[] | select(. != "all" and (. as $x | $v | index($x) | not)) | "unknown project: \(.)"),
        (select($fm | has("date")) | select($fm.date | tostring | test("^[0-9]{4}-[0-9]{2}-[0-9]{2}$") | not) | "date is not YYYY-MM-DD")
    end') || exit 2
  wiki=$(awk '/^```/ {f = !f; next} !f {gsub(/`[^`]*`/, ""); if (/\[\[[^]]*\]\]/) print "wiki link, write a path link"}' "$p" | sort -u)
  found=$(printf '%s\n%s\n' "$out" "$wiki" | while IFS= read -r l; do
    [ -n "$l" ] && printf '%s\t%s\n' "$p" "$l"
  done)
  [ -n "$found" ] && { printf '%s\n' "$found"; n=$((n+1)); }
done
[ "$n" -eq 0 ]
