#!/usr/bin/env bash
# Show that thread-index lists the threads of a small thread folder as TSV, newest last message first,
# with the topic, the tasks (empty for a thread of discussion only, tasks: []), and the counts of
# "- 決定:" and "- 未決:" lines; that --since, --limit, and --task narrow the list; that files of other
# types (the memo, the template) are left out; and that it lists 1,000 threads, and the real thread
# folder when there is one, in under a second each.
# usage: thread-index-test [<thread-index>]   (default: the one beside this script; its files go to a
#        temporary directory that is removed; the real folder is thread/ of KARO_HOME, default ~/karo,
#        read only)
set -uo pipefail
exec </dev/null
bin=$(cd "$(dirname "$0")" && pwd)
ti=${1:-$bin/thread-index}
real=${KARO_HOME:-$HOME/karo}/thread
tmp=$(mktemp -d "${TMPDIR:-/tmp}/thread-index-test.XXXXXX") || exit 2
trap 'rm -rf "$tmp"' EXIT
failed=0
fail() { printf 'FAIL\t%s\n' "$1"; failed=$((failed+1)); }
pass() { printf 'ok\t%s\n' "$1"; }
check() { if "${@:2}"; then pass "$1"; else fail "$1: exit $code: $out"; fi; }
ago() { date -v-"$1"d +%Y-%m-%d 2>/dev/null || date -d "$1 days ago" +%Y-%m-%d; }
today=$(ago 0) recent=$(ago 3) old=$(ago 30)

d=$tmp/thread
mkdir -p "$d"
printf -- '---\ntype: Thread\ndescription: 例の会話\ntopic: "例の話題"\ndate: %s\ntasks:\n  - t-test0001\n  - karo-a2v.1\nprojects:\n  - demo\n---\n\n### オーナー · %s 09:00\n\n本文\n\n***\n\n### karo · %s 10:00\n\n返事\n\n- 決定: 1 つめ\n- 決定: 2 つめ\n- 未決: 残る問い\n' \
  "$recent" "$recent" "$recent" > "$d/t-test0001-demo.md"
printf -- '---\ntype: Thread\ndescription: 議論だけの会話\ntopic: 議論だけ\ndate: %s\ntasks: []\nprojects:\n  - demo\n---\n\n### オーナー · %s 08:00\n\n本文\n\n- 未決: 方式\n' \
  "$today" "$today" > "$d/$today-talk.md"
printf -- '---\ntype: Thread\ndescription: 古い会話\ntopic: 古い話題\ndate: %s\ntasks:\n  - t-test0002\nprojects:\n  - demo\n---\n\n### オーナー · %s 11:00\n\n本文\n\n- 決定: 古い決定\n\n***\n\n### karo · %s 12:00\n\n続き\n' \
  "$old" "$old" "$old" > "$d/t-test0002-old.md"
printf -- '---\ntype: Memo\ndescription: メモ\ntopic: メモ\n---\n\n### オーナー · %s 07:00\n' "$today" > "$d/memo.md"
printf -- "---\ntype: Template\ndescription: 雛形\ntopic: '<話題>'\n---\n\n### オーナー · YYYY-MM-DD HH:MM\n" > "$d/template.md"

head='file	last	topic	tasks	decided	open'
row_talk="$today-talk.md	$today 08:00	議論だけ		0	1"
row_demo="t-test0001-demo.md	$recent 10:00	例の話題	t-test0001,karo-a2v.1	2	1"
row_old="t-test0002-old.md	$old 12:00	古い話題	t-test0002	1	0"
index() { out=$(KARO_HOME=$tmp "$ti" "$@" 2>&1); code=$?; }
# listed <row>...: thread-index succeeded and printed the header and exactly these rows.
listed() { [[ $code -eq 0 && $out == "$(printf '%s\n' "$head" "$@")" ]]; }
refused() { [[ $code -eq 2 && $out == usage:* ]]; }

index
check "lists the threads newest first, with topic, tasks, and the counts" listed "$row_talk" "$row_demo" "$row_old"
index --since 14d
check "--since 14d leaves out a thread last written 30 days ago" listed "$row_talk" "$row_demo"
index --since 14d --limit 1
check "--limit 1 keeps the newest" listed "$row_talk"
index --task karo-a2v.1
check "--task finds the thread whose tasks hold the ID" listed "$row_demo"
index --task karo-a2v
check "--task matches a whole ID, not a prefix" listed
for args in "--since 14" "--since xd" "--limit x" "--task" "--other 1"; do
  # shellcheck disable=SC2086  # the words are the arguments
  index $args
  check "refuses $args" refused
done

# speed: one pass over 1,000 threads, and over the real folder
big=$tmp/big/thread
mkdir -p "$big"
for i in $(seq 1000); do cp "$d/t-test0001-demo.md" "$big/t-$(printf '%08d' "$i")-x.md"; done
# took <dir>: run thread-index on the folder, set out to its row count and secs to the seconds it took.
took() {
  local TIMEFORMAT=%R
  secs=$( { time KARO_HOME=${1%/thread} "$ti" > "$tmp/out"; } 2>&1 ); code=$?
  out=$(($(wc -l < "$tmp/out") - 1))
}
# fast <rows>: thread-index succeeded, listed that many rows, and took under a second.
fast() { [[ $code -eq 0 && $out -eq $1 ]] && awk -v s="$secs" 'BEGIN { exit !(s < 1) }'; }
took "$big"
check "lists 1000 threads in under a second (${secs}s)" fast 1000
if [[ -d $real ]]; then
  want=$(rg -l '^type: Thread$' "$real" | wc -l | tr -d ' ')
  took "$real"
  check "lists the $want threads of $real in under a second (${secs}s)" fast "$want"
else
  printf 'skip\tno thread folder at %s\n' "$real"
fi

echo "thread-index-test: $failed failure(s)"
[ "$failed" -eq 0 ]
