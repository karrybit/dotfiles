#!/usr/bin/env bash
# shellcheck disable=SC2016,SC2034  # check evals its condition, which reads auto_part and manual_part
# Show that karo's PostToolUse hook on Bash, run from hooks.json with a hook input like Claude Code's
# and the output of a real `bd close --suggest-next --json`, names the tasks the close made ready: closing
# a blocker puts both tasks behind it into additionalContext, the one labelled auto-start with the
# request to delegate it through karo:delegate and the other with the request to tell the owner. A close
# that makes nothing ready, a Bash call other than bd close, a session outside KARO_HOME, and output that
# is not JSON each give nothing and exit 0.
# usage: newly-ready-test   (KARO_HOME and its Beads go to a temporary directory, which is removed; bd
#        runs only on that Beads, and the test stops before writing if `bd where` points elsewhere)
set -uo pipefail
exec </dev/null
root=$(cd "$(dirname "$0")/.." && pwd)
hooks=$root/hooks/hooks.json
tmp=$(mktemp -d "${TMPDIR:-/tmp}/newly-ready-test.XXXXXX") || exit 2
trap 'rm -rf "$tmp"' EXIT
failed=0
fail() { printf 'FAIL\t%s\n' "$1"; failed=$((failed+1)); }
pass() { printf 'ok\t%s\n' "$1"; }

unset BEADS_DIR BEADS_DB
export KARO_HOME=$tmp/karo CLAUDE_PLUGIN_ROOT=$root CLAUDE_PROJECT_DIR=$tmp/karo BD_NON_INTERACTIVE=1
mkdir -p "$KARO_HOME" && cd "$KARO_HOME" && git init -q && bd init -p t -q --skip-agents --skip-hooks >/dev/null 2>&1 || exit 2
where=$(bd where 2>/dev/null | head -n 1)
[[ $where == "$(pwd -P)/.beads" || $where == "$KARO_HOME/.beads" ]] || { echo "newly-ready-test: bd where gives $where, not the temporary Beads" >&2; exit 2; }
new() { bd create "$@" -t task --json | jq -r .id; }
blocker=$(new blocker) auto=$(new auto -l auto-start) manual=$(new manual) lone=$(new lone)
bd dep add "$auto" "$blocker" --json >/dev/null && bd dep add "$manual" "$blocker" --json >/dev/null || exit 2
lone_out=$(bd close "$lone" --reason test --force --suggest-next --json) || exit 2
blocker_out=$(bd close "$blocker" --reason test --force --suggest-next --json) || exit 2

# run <command> <stdout>: runs every PostToolUse hook in hooks.json whose matcher takes Bash, with a Bash
# hook input for the command and its stdout, and sets out (all stdout) and codes (exit codes).
run() {
  local cmd input
  input=$(jq -n --arg c "$1" --arg o "$2" '{hook_event_name: "PostToolUse", tool_name: "Bash", tool_input: {command: $c},
    tool_response: {stdout: $o, stderr: "", interrupted: false, isImage: false}}')
  out='' codes=''
  while IFS= read -r cmd; do
    out+=$(bash -c "$cmd" <<<"$input"); codes+="$? "
  done < <(jq -r '.hooks.PostToolUse[]? | select(.matcher as $m | "Bash" | test("^(" + $m + ")$")) | .hooks[].command' "$hooks")
}
context() { jq -r '.hookSpecificOutput | select(.hookEventName == "PostToolUse") | .additionalContext' <<<"$out" 2>/dev/null; }
check() { if eval "$2"; then pass "$1"; else fail "$1: codes=$codes out=$out"; fi; }
zero() { [[ $codes =~ ^(0 )+$ ]]; }
silent() { zero && [[ -z $out ]]; }

run "bd close $blocker --reason test --force --suggest-next --json" "$blocker_out"
ctx=$(context)
auto_part=${ctx%%$'\n\n'*} manual_part=${ctx#*$'\n\n'}
check "closing the blocker exits 0 and gives additionalContext" 'zero && [[ -n $ctx ]]'
check "the auto-start task comes with the request to delegate it" \
  '[[ $auto_part == *karo:delegate* && $auto_part == *"- $auto auto"* && $auto_part != *"$manual"* ]]'
check "the other task comes with the request to tell the owner" \
  '[[ $manual_part == *オーナーに伝える* && $manual_part == *"- $manual manual"* && $manual_part != *"$auto"* ]]'
check "the closed blocker is not named" '[[ -n $ctx && $ctx != *"$blocker"* ]]'

run "bd close $lone --reason test --force --suggest-next --json" "$lone_out"
check "a close that makes nothing ready gives nothing and exits 0" silent
run "cat closed.json" "$blocker_out"
check "a Bash call other than bd close gives nothing and exits 0" silent
run "bd close $blocker --suggest-next --json" "not JSON"
check "output that is not JSON gives nothing and exits 0" silent
CLAUDE_PROJECT_DIR=$tmp/elsewhere run "bd close $blocker --reason test --force --suggest-next --json" "$blocker_out"
check "a session outside KARO_HOME gives nothing and exits 0" silent

echo "newly-ready-test: $failed failure(s)" >&2
[ "$failed" -eq 0 ]
