#!/bin/sh
# Opens a URL or a file in terminal-browser beside the caller's Herdr pane and
# names the new pane <label>. By default terminal-browser adds the page as a
# tab to the terminal-browser pane right of the caller when there is one, and
# splits the caller's pane to the right otherwise. --no-merge always opens a
# new pane: below the last pane labelled "view - ..." in the workspace when
# there is one, else right of the caller. terminal-browser has no option for
# the pane to split; it splits the pane HERDR_PANE_ID and HERDR_TAB_ID name,
# so those are set to that pane.
# The new pane is the one herdr pane list shows after the open and not before;
# it is renamed only when its foreground process is terminal-browser.
# Prints "<pane id> <label>", or a line saying the page went to an existing
# pane, which keeps its name. Closing the pane ends its browser.
# Its callers, such as crit-open, check the target first, so this script
# takes any target and has no settings rule of its own.
# usage: tb-view <label> <url or absolute path> [--no-merge]
set -eu

usage() {
  echo "usage: tb-view <label> <url or absolute path> [--no-merge]" >&2
  exit 2
}
[ $# -eq 2 ] || { [ $# -eq 3 ] && [ "$3" = --no-merge ]; } || usage
label=$1 target=$2
ws=${HERDR_WORKSPACE_ID:-}
[ -n "$ws" ] || { echo "tb-view: not in a Herdr pane (HERDR_WORKSPACE_ID is unset)" >&2; exit 1; }

before=$(herdr pane list --workspace "$ws")
export DO_NOT_TRACK=1 TERMINAL_BROWSER_NO_TELEMETRY=1
if [ $# -eq 2 ]; then
  terminal-browser open "$target" --split right >&2
else
  base=$(printf '%s' "$before" | jq -r '[.result.panes[] | select(.label // "" | startswith("view - "))] | last // empty | "\(.pane_id) \(.tab_id)"')
  if [ -n "$base" ]; then
    HERDR_PANE_ID=${base% *} HERDR_TAB_ID=${base#* } terminal-browser open "$target" --split down --no-merge >&2
  else
    terminal-browser open "$target" --split right --no-merge >&2
  fi
fi
after=$(herdr pane list --workspace "$ws")
new=$(printf '%s' "$after" | jq -r --argjson before "$before" '
  [$before.result.panes[].pane_id] as $old | [.result.panes[].pane_id | select(IN($old[]) | not)] | join(" ")')

case $new in
  '') echo "tb-view: opened as a tab in an existing terminal-browser pane, which keeps its name" ;;
  *' '*) echo "tb-view: more than one new pane ($new); none renamed" >&2; exit 1 ;;
  *)
    fg=$(herdr pane process-info --pane "$new" | jq -r '.result.process_info.foreground_processes[0].name // empty')
    # The kernel keeps the first 15 characters of a process name.
    [ "$fg" = terminal-browse ] || { echo "tb-view: the new pane $new runs ${fg:-nothing} in the foreground, not terminal-browser; not renamed" >&2; exit 1; }
    herdr pane rename "$new" "$label" >/dev/null; echo "$new $label" ;;
esac
