#!/bin/sh
# PreToolUse hook on Bash: stops calls that bypass what the settings of KARO_HOME expect.
# A path to a script in the plugin's bin/ (…/bin/karo-<name>) anywhere in the command stops: the
# skills call those scripts by name, and permission rules and sandbox.excludedCommands match the
# command text as written and list the names only, so a path stays in the sandbox and asks. The other
# scripts (the helpers and the tests in scripts/) may be called by path.
# A git rebase that asks to leave the sandbox stops (git rebase --abort passes): a branch of KARO_HOME is
# rebased by the karo:land skill's karo-land <branch> --rebase, which is the one way that rebases
# with git's hooks off.
# A herdr call that touches the Herdr socket stops when it is joined to anything else (pipe, &&,
# ||, ;, redirection other than an fd duplicate such as 2>&1, $(...), backquote, newline), and a
# lone such call stops when it asks to leave the sandbox. A joined call stays in the sandbox, where
# the socket is out of reach and herdr fails with "Operation not permitted"; a lone one already runs
# outside it through sandbox.excludedCommands.
# Quoted strings, backslash escapes and heredoc bodies are dropped before looking for git rebase and
# herdr, so a search for the text, a jq filter or a script written through a heredoc is not mistaken
# for a call. This is not a shell parser: a shape it cannot read passes.
# usage: call-check < <PreToolUse hook input JSON>   (exit 2 with the reason on stderr to stop)
verdict=$(jq -r '
  (.tool_input.command // "") as $cmd
  | ($cmd
     | gsub("<<-?[ \t]*([\"'\''])?(?<t>[A-Za-z_][A-Za-z0-9_]*)[\"'\'']?(?<rest>[^\n]*)\n([\\s\\S]*?\n)?\\k<t>(?=\n|$)"; "<<H\(.rest)")
     | gsub("\\\\.|'\''[^'\'']*'\''|\"(\\\\.|[^\"\\\\])*\""; "Q")
     | gsub("[0-9]*[<>]&[0-9-]+"; " ")) as $bare
  | if ($cmd | test("/bin/karo-[A-Za-z0-9]")) then "path"
    elif .tool_input.dangerouslyDisableSandbox == true
      and ($bare | test("(^|[\\s;&|(])git(\\s+-[cC]\\s+\\S+)*\\s+rebase(?![\\w-])(?!\\s+--abort)")) then "rebase"
    elif ($bare | test("(^|[\\s;&|(`/])herdr\\s+(status|agent|workspace|worktree|tab|pane|api)(?![\\w-])") | not) then "pass"
    elif ($bare | test("[|;<>\n`]|&&|\\$\\(")) then "herdr-joined"
    elif .tool_input.dangerouslyDisableSandbox == true then "herdr-unsandboxed"
    else "pass" end')
case $verdict in
  path)
    cat >&2 <<EOF
このコマンドは karo の plugin の bin/ の script（…/bin/karo-<name>）をパスで指している。settings の規則と sandbox.excludedCommands は名前の形（karo-land など）だけを載せているので、パスの呼び出しは規則に当たらず、確認が出るか sandbox に残って Operation not permitted で止まる。パスを付けずに karo-land のように名前だけで、単独で呼び直す。
EOF
    exit 2 ;;
  rebase)
    cat >&2 <<EOF
このコマンドは git rebase を sandbox の外で走らせようとしている。KARO_HOME のリポジトリのブランチの rebase は、karo が karo-land <branch> --rebase を単独で実行して行う。Agent は sandbox の中で rebase し、unable to unlink old で落ちたら git rebase --abort で戻して作業を止め、karo に karo-land --rebase を頼むと報告する。
EOF
    exit 2 ;;
  herdr-joined) what="このコマンドは herdr に別のコマンドかリダイレクトをつないでいる" ;;
  herdr-unsandboxed) what="単独の herdr に dangerouslyDisableSandbox は要らない" ;;
  *) exit 0 ;;
esac
printf '%s\n' "${what}。herdr は単独の呼び出しで実行する（パイプ・&&・||・;・リダイレクト・\$(...) をつながない。2>&1 はよい）。単独の呼び出しなら sandbox.excludedCommands で sandbox の外で動く。Operation not permitted（EPERM）は、つないだせいで sandbox に残ったためで、herdr の socket が塞がれているのではない。dangerouslyDisableSandbox を付けずに単独で呼び直し、出力の加工は次の呼び出しで行う。" >&2
exit 2
