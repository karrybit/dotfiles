#!/usr/bin/env bash
# Show that tb-view opens the target with terminal-browser, telemetry off, in a right split of the
# caller's pane, names the one pane that herdr pane list shows only after the open when its
# foreground process is terminal-browser, and prints "<pane id> <label>"; that a page added as a
# tab to an existing pane renames nothing and says so; that --no-merge opens a new pane below the
# last "view - ..." pane, by setting HERDR_PANE_ID and HERDR_TAB_ID to it, or right of the caller
# when there is none; and that two new panes, a new pane running something else in the foreground,
# a failed open, no Herdr workspace, and wrong arguments rename nothing.
# It runs against herdr and terminal-browser stubs on PATH: herdr prints a pane list kept in a file,
# reports FG (default terminal-browse, the 15 characters of the name the kernel keeps) as a pane's foreground process, and logs those calls and renames,
# and terminal-browser logs what it is given and adds 0, 1, or 2 panes to the list.
# usage: tb-view-test [<tb-view>]   (default: the one beside this script; its files go to a
#        temporary directory that is removed)
set -uo pipefail
exec </dev/null
bin=$(cd "$(dirname "$0")" && pwd)
tv=${1:-$bin/tb-view}
tmp=$(mktemp -d "${TMPDIR:-/tmp}/tb-view-test.XXXXXX") || exit 2
trap 'rm -rf "$tmp"' EXIT
failed=0
fail() { printf 'FAIL\t%s\n' "$1"; failed=$((failed+1)); }
pass() { printf 'ok\t%s\n' "$1"; }

mkdir -p "$tmp/fake"
cat > "$tmp/fake/herdr" <<'EOF'
#!/bin/sh
case "$1 $2" in
  "pane list") echo "list $*" >> "$LOG"; cat "$PANES" ;;
  "pane rename") shift 2; echo "rename $*" >> "$LOG" ;;
  "pane process-info") shift 2; echo "info $*" >> "$LOG"
    jq -nc --arg fg "$FG" '{result: {process_info: {foreground_processes: [{name: $fg}]}}}' ;;
  *) echo "unexpected herdr $*" >> "$LOG"; exit 1 ;;
esac
EOF
cat > "$tmp/fake/terminal-browser" <<'EOF'
#!/bin/sh
echo "tb $* pane=${HERDR_PANE_ID:-} tab=${HERDR_TAB_ID:-} DO_NOT_TRACK=${DO_NOT_TRACK:-} TERMINAL_BROWSER_NO_TELEMETRY=${TERMINAL_BROWSER_NO_TELEMETRY:-}" >> "$LOG"
echo "opened browser 1"
add() { jq --arg id "$1" '.result.panes += [{pane_id: $id, tab_id: "w1:t1", label: null}]' "$PANES" > "$PANES.new" && mv "$PANES.new" "$PANES"; }
case $NEW in
  1) add w1:p9 ;;
  2) add w1:p9; add w1:p10 ;;
  fail) exit 3 ;;
esac
EOF
chmod +x "$tmp/fake/herdr" "$tmp/fake/terminal-browser"

export LOG=$tmp/log PANES=$tmp/panes.json
caller='{"pane_id": "w1:p1", "tab_id": "w1:t1", "label": "caller"}'
views='{"pane_id": "w1:p2", "tab_id": "w1:t1", "label": "view - crit"}, {"pane_id": "w1:p3", "tab_id": "w1:t2", "label": "view - browser"}, {"pane_id": "w1:p4", "tab_id": "w1:t1", "label": "notes"}'
# run <new panes: 0, 1, 2, or fail> <panes beside the caller's, as JSON objects> <tb-view args>...
run() {
  local new=$1 others=$2
  shift 2
  printf '{"result": {"panes": [%s%s]}}\n' "$caller" "${others:+, $others}" > "$PANES"
  : > "$LOG"
  out=$(env PATH="$tmp/fake:$PATH" HERDR_WORKSPACE_ID=w1 HERDR_PANE_ID=w1:p1 HERDR_TAB_ID=w1:t1 NEW="$new" FG="${FG:-terminal-browse}" "$tv" "$@" 2>/dev/null); code=$?
  log=$(paste -sd '|' "$LOG")
}
expect() { # <name> <exit> <stdout> <log>
  if [[ $code -eq $2 && $out == "$3" && $log == "$4" ]]; then pass "$1"; else fail "$1: exit $code: out [$out]: log [$log]"; fi
}
list='list pane list --workspace w1'
telemetry='DO_NOT_TRACK=1 TERMINAL_BROWSER_NO_TELEMETRY=1'

run 1 "" "view - crit" http://localhost:49809
expect "a new pane is named and printed" 0 "w1:p9 view - crit" \
  "$list|tb open http://localhost:49809 --split right pane=w1:p1 tab=w1:t1 $telemetry|$list|info --pane w1:p9|rename w1:p9 view - crit"
run 0 "$views" "view - browser" /m/a.png
expect "a tab in an existing pane renames nothing and says so" 0 \
  "tb-view: opened as a tab in an existing terminal-browser pane, which keeps its name" \
  "$list|tb open /m/a.png --split right pane=w1:p1 tab=w1:t1 $telemetry|$list"
run 1 "$views" "view - diagram" /m/a.png --no-merge
expect "--no-merge stacks the new pane below the last view pane" 0 "w1:p9 view - diagram" \
  "$list|tb open /m/a.png --split down --no-merge pane=w1:p3 tab=w1:t2 $telemetry|$list|info --pane w1:p9|rename w1:p9 view - diagram"
run 1 '{"pane_id": "w1:p4", "tab_id": "w1:t1", "label": "notes"}' "view - browser" /m/a.png --no-merge
expect "--no-merge with no view pane splits the caller's pane" 0 "w1:p9 view - browser" \
  "$list|tb open /m/a.png --split right --no-merge pane=w1:p1 tab=w1:t1 $telemetry|$list|info --pane w1:p9|rename w1:p9 view - browser"
run 2 "" "view - crit" http://localhost:49809
expect "two new panes rename nothing" 1 "" \
  "$list|tb open http://localhost:49809 --split right pane=w1:p1 tab=w1:t1 $telemetry|$list"
FG=zsh run 1 "" "view - crit" http://localhost:49809
expect "a new pane with another foreground process renames nothing" 1 "" \
  "$list|tb open http://localhost:49809 --split right pane=w1:p1 tab=w1:t1 $telemetry|$list|info --pane w1:p9"
run fail "" "view - crit" http://localhost:49809
expect "a failed open renames nothing and keeps its exit code" 3 "" \
  "$list|tb open http://localhost:49809 --split right pane=w1:p1 tab=w1:t1 $telemetry"

: > "$LOG"
out=$(env -u HERDR_WORKSPACE_ID PATH="$tmp/fake:$PATH" NEW=1 "$tv" "view - crit" http://localhost:49809 2>/dev/null); code=$?
log=$(paste -sd '|' "$LOG")
expect "no Herdr workspace runs nothing" 1 "" ""
for args in "view - crit" "view - crit|x|--merge" "view - crit|x|--no-merge|y"; do
  IFS='|' read -ra a <<< "$args"
  run 1 "" "${a[@]}"
  expect "\"tb-view ${args//|/ }\" is a usage error" 2 "" ""
done

echo "tb-view-test: $failed failure(s)" >&2
[ "$failed" -eq 0 ]
