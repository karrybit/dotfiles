#!/bin/sh
# Opens one file in terminal-browser, in a Herdr pane named "view - <name>"
# (default "view - browser") beside the caller's, through the karrybit crit
# skill's tb-view, and prints what tb-view prints: an .html or .svg under
# doc/ of KARO_HOME, an explanation's index.html in the store
# (<store>/<lowercase UUID>/index.html, the store being $KARO_DATA_HOME/html),
# or an image or video anywhere, by absolute path.
# --no-merge opens a new pane instead of a tab in an existing one.
# terminal-browser runs outside the sandbox, so pages that can run scripts
# come only from doc/ and the store, where the explain skill keeps its HTML.
# usage: view-open [--no-merge] <absolute path> [<name>]
# Environment: KARO_HOME (default ~/karo), KARO_DATA_HOME (default
# ${XDG_DATA_HOME:-~/.local/share}/karo).
set -eu

store=${KARO_DATA_HOME:-${XDG_DATA_HOME:-$HOME/.local/share}/karo}/html
usage() {
  echo "usage: view-open [--no-merge] <absolute path of an .html or .svg under ${KARO_HOME:-$HOME/karo}/docs, a $store/<UUID>/index.html, or a .png .jpg .jpeg .webp .gif .mp4 .webm> [<name of letters, digits, . _ -, starting with a letter or digit>]" >&2
  exit 2
}
merge=
if [ "${1:-}" = --no-merge ]; then merge=--no-merge; shift; fi
[ $# -eq 1 ] || [ $# -eq 2 ] || usage
case "${2-browser}" in
  '' | [._-]* | *[!abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789._-]*) usage ;;
esac
h='[0-9a-f][0-9a-f][0-9a-f][0-9a-f]'
case "$1" in
  *..*) usage ;;
  "${KARO_HOME:-$HOME/karo}"/doc/*.html | "${KARO_HOME:-$HOME/karo}"/doc/*.svg) ;;
  "$store"/$h$h-$h-$h-$h-$h$h$h/index.html) ;;
  /*.png | /*.jpg | /*.jpeg | /*.webp | /*.gif | /*.mp4 | /*.webm) ;;
  *) usage ;;
esac
[ -f "$1" ] || usage
exec "$HOME/.config/claude/skills/karrybit/skills/crit/scripts/tb-view" "view - ${2-browser}" "$1" ${merge:+"$merge"}
