#!/usr/bin/env bash
# Show that commit commits exactly the given record paths when they pass its checks, and otherwise
# commits nothing, unstages them, and leaves the files as written: in a small git vault, a good write
# lands with the body, rumdl's fix, and no other dirty file, and each bad write stops with NG.
# usage: commit-test [<karo dir>]   (default KARO_HOME or ~/karo, read only: the vault takes its .rumdl.toml;
#        the vault goes to a temporary directory and is removed)
set -uo pipefail
exec </dev/null
karo=${1:-${KARO_HOME:-$HOME/karo}}
bin=$(cd "$(dirname "$0")" && pwd)
tmp=$(mktemp -d "${TMPDIR:-/tmp}/commit-test.XXXXXX") || exit 2
trap 'rm -rf "$tmp"' EXIT
failed=0
fail() { printf 'FAIL\t%s\n' "$1"; failed=$((failed+1)); }
pass() { printf 'ok\t%s\n' "$1"; }

v=$tmp/karo
export KARO_HOME=$v
mkdir -p "$v"/{standup,source/meeting,project/repo/github.com/acme/demo/review,investigation}
cp "$karo/.rumdl.toml" "$v/" || exit 2
printf -- '---\ntype: Project\ndescription: 例のプロジェクト。\nprojects:\n  - github.com/acme/demo\n---\n\n## demo\n' > "$v/project/repo/github.com/acme/demo.md"
printf -- '---\ntype: Investigation\ndescription: 例の調べ物。\ndate: 2026-01-01\ntasks:\n  - t-test0001\nprojects:\n  - github.com/acme/demo\n---\n\n## 例\n\n例\n' > "$v/investigation/2026-01-01-demo.md"
printf -- '---\ntype: Review\ndate: 2026-01-01\ntasks:\n  - t-test0001\nprojects:\n  - github.com/acme/demo\n---\n\n## 結論\n\n承認\n' > "$v/project/repo/github.com/acme/demo/review/t-test0001-1.md"
git -C "$v" init -q && git -C "$v" config user.name test && git -C "$v" config user.email test@example.invalid
git -C "$v" add -A && git -C "$v" commit -q -m init || exit 2

head_() { git -C "$v" rev-parse HEAD; }
run() { out=$("$bin/commit" "$@" 2>&1); code=$?; }
# ng <name> <want in output>: the last run stopped with NG, HEAD did not move, and nothing is staged.
ng() {
  if [[ $code -eq 1 && $out == *"$2"* && ${out##*$'\n'} == "NG "* && $(head_) == "$before" && -z $(git -C "$v" diff --cached --name-only) ]]; then
    pass "$1"
  else
    fail "$1: exit $code: $out"
  fi
}

# A good write: only the given path is committed, with the subject and the body, and another dirty note
# stays dirty.
printf '\n追記\n' >> "$v/investigation/2026-01-01-demo.md"
printf 'dirty\n' >> "$v/project/repo/github.com/acme/demo.md"
before=$(head_)
run "t-test0001: 追記した" "理由の本文" investigation/2026-01-01-demo.md
if [[ $code -eq 0 && $out == "OK "*" t-test0001: 追記した" && $(git -C "$v" show --format= --name-only HEAD) == investigation/2026-01-01-demo.md \
  && $(git -C "$v" log -1 --format=%b) == 理由の本文 && $(git -C "$v" status --porcelain) == " M project/repo/github.com/acme/demo.md" ]]; then
  pass "a good write commits only its paths"
else
  fail "a good write: exit $code: $out"
fi
git -C "$v" checkout -q -- project/repo/github.com/acme/demo.md

# rumdl fixes trailing spaces before the commit.
printf '\n行末に空白   \n' >> "$v/investigation/2026-01-01-demo.md"
run "t-test0001: 空白" "本文" investigation/2026-01-01-demo.md
if [[ $code -eq 0 ]] && ! git -C "$v" show HEAD:investigation/2026-01-01-demo.md | rg -q ' $' && [[ -z $(git -C "$v" status --porcelain) ]]; then
  pass "rumdl fixes trailing spaces and commits"
else
  fail "trailing spaces: exit $code: $out"
fi

# A removed note is committed as removed.
printf -- '---\ntype: Investigation\ndescription: 例。\ndate: 2026-01-01\nprojects:\n  - all\nsources:\n  - https://example.invalid/a\n---\n\n## 例\n' > "$v/investigation/2026-01-01-gone.md"
run "t-test0001: 足す" "本文" investigation/2026-01-01-gone.md
rm "$v/investigation/2026-01-01-gone.md"
run "t-test0001: 消す" "本文" investigation/2026-01-01-gone.md
if [[ $code -eq 0 ]] && [[ $(git -C "$v" show --format= --name-status HEAD) == $'D\tinvestigation/2026-01-01-gone.md' ]]; then
  pass "a removed note is committed"
else
  fail "a removed note: exit $code: $out"
fi

# A standup in standup/ and a meeting's notes in source/meeting/ are committed.
printf -- '---\ntype: Standup\ndate: 2026-11-18\n---\n\n## 報告\n' > "$v/standup/2026-11-18.md"
run "t-test0001: standup" "本文" standup/2026-11-18.md
if [[ $code -eq 0 && $out == "OK "* ]]; then pass "a standup commits"; else fail "a standup: exit $code: $out"; fi
printf -- '---\ntype: Meeting Notes\ndescription: 例。\ndate: 2026-11-18\nprojects:\n  - all\nsources:\n  - https://example.invalid/a\n---\n\n## 例\n' > "$v/source/meeting/2026-11-18-weekly.md"
run "t-test0001: MTG" "本文" source/meeting/2026-11-18-weekly.md
if [[ $code -eq 0 && $out == "OK "* ]]; then pass "a meeting's notes commit"; else fail "a meeting's notes: exit $code: $out"; fi
# A decision record in decisions/ is committed, and one without frontmatter there stops.
mkdir -p "$v/decisions"
printf -- '---\ntype: Decision Record\ndescription: 例の決定。\ndate: 2026-11-19\nprojects:\n  - github.com/acme/demo\n---\n\n## 状態\n\nAccepted\n' > "$v/decisions/2026-11-19-demo.md"
run "t-test0001: 決定" "本文" decisions/2026-11-19-demo.md
if [[ $code -eq 0 && $out == "OK "* ]]; then pass "a decision record commits"; else fail "a decision record: exit $code: $out"; fi

before=$(head_)
run "t-test0001: 変わらない" "本文" investigation/2026-01-01-demo.md
if [[ $code -eq 0 && $out == "OK - t-test0001: 変わらない (no change)" && $(head_) == "$before" ]]; then pass "no change"; else fail "no change: exit $code: $out"; fi

out=$("$bin/commit" "t-test0001: 本文なし" "" investigation/2026-01-01-demo.md 2>&1); code=$?
if [[ $code -eq 2 && $out == usage:* ]]; then pass "no body prints the usage"; else fail "no body: exit $code: $out"; fi

# The bad writes.
printf '# a\n' > "$v/decisions/a.md"
run "t-test0001: 決定の形" "本文" decisions/a.md
ng "a decision record without frontmatter stops" $'decisions/a.md\tno frontmatter'
rm "$v/decisions/a.md"
printf '# a\n' > "$v/assignments.md"
run "t-test0001: 割り当て" "本文" assignments.md
ng "assignments.md is outside the record" "not a record path: assignments.md"
rm "$v/assignments.md"
printf '# a\n' > "$v/AGENTS.md"
run "t-test0001: 外へ" "本文" investigation/../AGENTS.md
ng "a path that climbs out of a record folder" "not a record path: investigation/../AGENTS.md"
rm "$v/AGENTS.md"
printf '# state\n' > "$v/state.md"
run "t-test0001: state" "本文" state.md
ng "state.md is outside the record" "not a record path: state.md"
rm "$v/state.md"
mkdir -p "$v/journal" && printf -- '---\ntype: Standup\ndate: 2026-11-18\n---\n\n## 報告\n' > "$v/journal/2026-11-18-standup.md"
run "t-test0001: journal" "本文" journal/2026-11-18-standup.md
ng "journal/ is outside the record" "not a record path: journal/2026-11-18-standup.md"
rm "$v/journal/2026-11-18-standup.md"
mkdir -p "$v/scrap" && printf '# a\n' > "$v/scrap/t-test0001-demo.md"
run "t-test0001: scrap" "本文" scrap/t-test0001-demo.md
ng "a folder not in record-folders is outside the record" "not a record path: scrap/t-test0001-demo.md"
rm "$v/scrap/t-test0001-demo.md"
printf -- '---\ntype: Standup\ndate: 2026-11-19\n---\n\n## 報告\n' > "$v/standup/2026-11-19-standup.md"
run "t-test0001: standup の名前" "本文" standup/2026-11-19-standup.md
ng "a standup named YYYY-MM-DD-standup.md" $'standup/2026-11-19-standup.md\tpath does not match Standup'
rm "$v/standup/2026-11-19-standup.md"

printf '## 例\n\n例\n' > "$v/investigation/2026-01-02-new.md"
run "t-test0002: 新しい調べ物" "本文" investigation/2026-01-02-new.md
ng "a new note without frontmatter" $'investigation/2026-01-02-new.md\tno frontmatter'
if [[ $(git -C "$v" status --porcelain -- investigation/2026-01-02-new.md) == "?? investigation/2026-01-02-new.md" ]]; then pass "the stopped new file stays untracked"; else fail "the stopped new file: $(git -C "$v" status --porcelain)"; fi
rm "$v/investigation/2026-01-02-new.md"

printf '\n欠けの前の追記\n' >> "$v/investigation/2026-01-01-demo.md"
printf -- '---\ntype: Investigation\ndescription: 例。\n---\n\n## 例\n' > "$v/investigation/2026-01-02-bad.md"
run "t-test0001: 欠け" "本文" investigation/2026-01-01-demo.md investigation/2026-01-02-bad.md
ng "karo-check's problem stops" $'investigation/2026-01-02-bad.md\tmissing date'
if git -C "$v" diff --quiet -- investigation/2026-01-01-demo.md; then fail "the stopped write is kept: the file was reset"; else pass "the stopped write is kept"; fi
git -C "$v" checkout -q -- investigation/2026-01-01-demo.md
rm "$v/investigation/2026-01-02-bad.md"

# A rumdl that cannot run stops the commit: with rumdl taken off PATH, a good write with an edit to a
# committed note stops, nothing is staged, and the files stay as written. The other commands of a folder
# that holds rumdl stay on PATH as links in $tmp/path, so only rumdl is missing.
norumdl=$tmp/path:
mkdir "$tmp/path" || exit 2
while IFS= read -r -d : d; do
  if [[ -x $d/rumdl ]]; then
    for x in "$d"/*; do [[ ${x##*/} == rumdl || -e $tmp/path/${x##*/} ]] || ln -s "$x" "$tmp/path/${x##*/}"; done
  else
    norumdl+=$d:
  fi
done < <(printf '%s:' "$PATH")
if (PATH=${norumdl%:}; ! command -v rumdl >/dev/null); then pass "rumdl is off the trimmed PATH"; else fail "rumdl is still on the trimmed PATH"; fi
printf '\nrumdl なしの追記\n' >> "$v/investigation/2026-01-01-demo.md"
printf -- '---\ntype: Investigation\ndescription: 例。\ndate: 2026-01-02\nprojects:\n  - all\n---\n\n## 例\n' > "$v/investigation/2026-01-02-fmt.md"
out=$(PATH=${norumdl%:} "$bin/commit" "t-test0001: rumdl なし" "本文" investigation/2026-01-01-demo.md investigation/2026-01-02-fmt.md 2>&1); code=$?
ng "a rumdl not on PATH stops" "rumdl: command not found"
if [[ $(git -C "$v" status --porcelain -- investigation) == $' M investigation/2026-01-01-demo.md\n?? investigation/2026-01-02-fmt.md' ]]; then
  pass "the write stopped for rumdl is kept as written"
else
  fail "the write stopped for rumdl: $(git -C "$v" status --porcelain)"
fi
git -C "$v" checkout -q -- investigation/2026-01-01-demo.md
rm "$v/investigation/2026-01-02-fmt.md"

# A file name git would quote (not ASCII) is checked like any other.
printf -- '---\ntype: Investigation\ndescription: 例。\n---\n\n## 例\n' > "$v/investigation/2026-01-02-調査.md"
run "t-test0001: 名前" "本文" investigation/2026-01-02-調査.md
ng "a bad note with a name that is not ASCII stops" $'investigation/2026-01-02-調査.md\tmissing date'
rm "$v/investigation/2026-01-02-調査.md"

# A name with a space commits; a path with a newline is refused before anything is staged.
printf -- '---\ntype: Investigation\ndescription: 例。\ndate: 2026-01-02\nprojects:\n  - all\n---\n\n## 例\n' > "$v/investigation/2026-01-02-a b.md"
run "t-test0001: 空白" "本文" "investigation/2026-01-02-a b.md"
if [[ $code -eq 0 && $out == "OK "* ]]; then pass "a name with a space commits"; else fail "a name with a space: exit $code: $out"; fi
before=$(head_)
run "t-test0001: 改行" "本文" $'investigation/2026-01-02-a\nb.md'
ng "a path with a newline is refused" "not a record path"

# A rename or a removal that leaves a link to the old path stops, and the files stay as they are; with
# the link fixed and listed too, the rename commits.
printf -- '---\ntype: Investigation\ndescription: 例。\ndate: 2026-01-02\nprojects:\n  - all\n---\n\n## 例\n' > "$v/investigation/2026-01-02-old.md"
printf -- '---\ntype: Investigation\ndescription: 例。\ndate: 2026-01-02\nprojects:\n  - all\n---\n\n## 例\n\n[前の調べ物](investigation/2026-01-02-old.md)\n' > "$v/investigation/2026-01-02-next.md"
run "t-test0001: 足す" "本文" investigation/2026-01-02-old.md investigation/2026-01-02-next.md
before=$(head_)
mv "$v/investigation/2026-01-02-old.md" "$v/investigation/2026-01-02-new-name.md"
run "t-test0001: 名前を変える" "本文" investigation/2026-01-02-old.md investigation/2026-01-02-new-name.md
ng "a rename that leaves a link stops" $'investigation/2026-01-02-next.md\tlink target missing: investigation/2026-01-02-old.md'
if [[ -f $v/investigation/2026-01-02-new-name.md && ! -e $v/investigation/2026-01-02-old.md ]]; then pass "the stopped rename is kept"; else fail "the stopped rename: $(git -C "$v" status --porcelain)"; fi
rm "$v/investigation/2026-01-02-new-name.md"
run "t-test0001: 消す" "本文" investigation/2026-01-02-old.md
ng "a removal that leaves a link stops" $'investigation/2026-01-02-next.md\tlink target missing: investigation/2026-01-02-old.md'
git -C "$v" checkout -q -- investigation/2026-01-02-old.md
mv "$v/investigation/2026-01-02-old.md" "$v/investigation/2026-01-02-new-name.md"
sed -i.bak 's#investigation/2026-01-02-old.md#investigation/2026-01-02-new-name.md#' "$v/investigation/2026-01-02-next.md" && rm "$v/investigation/2026-01-02-next.md.bak"
# The check reads what the commit holds: the link fixed in the working tree but not listed stops it.
run "t-test0001: 名前を変える" "本文" investigation/2026-01-02-old.md investigation/2026-01-02-new-name.md
ng "a link fixed but not listed stops" $'investigation/2026-01-02-next.md\tlink target missing: investigation/2026-01-02-old.md'
run "t-test0001: 名前を変える" "本文" investigation/2026-01-02-old.md investigation/2026-01-02-new-name.md investigation/2026-01-02-next.md
if [[ $code -eq 0 && $out == "OK "* && -z $(git -C "$v" status --porcelain -- investigation) ]]; then pass "a rename with its link fixed commits"; else fail "a rename with its link fixed: exit $code: $out: $(git -C "$v" status --porcelain)"; fi
before=$(head_)

# The record folders are one list, record-folders beside the scripts: with a folder added to a copy of it,
# commit takes a path there and karo-check checks the note.
alt=$tmp/bin
cp -R "$bin" "$alt" && printf 'standup source investigation project doc decisions scrap\n' > "$alt/record-folders"
mkdir -p "$v/scrap" && printf '## a\n' > "$v/scrap/t-test0001-demo.md"
out=$("$alt/commit" "t-test0001: scrap" "本文" scrap/t-test0001-demo.md 2>&1); code=$?
ng "a folder added to record-folders is a record folder" $'scrap/t-test0001-demo.md\tno frontmatter'
rm "$v/scrap/t-test0001-demo.md"

# rumdl leaves reviews alone, so git diff --check catches a blank line at the end of one.
printf '\n' >> "$v/project/repo/github.com/acme/demo/review/t-test0001-1.md"
run "t-test0001: 末尾の空行" "本文" project/repo/github.com/acme/demo/review/t-test0001-1.md
ng "git diff --check stops a blank line at the end" "new blank line at EOF"

echo "commit-test: $failed failure(s)"
[[ $failed -eq 0 ]]
