#!/usr/bin/env bash
# shellcheck disable=SC2016  # the checks are single-quoted for eval, which expands them
# Show that right-pane brings the CoS right column back, against a herdr on
# PATH that keeps one workspace's panes in a JSON file and logs every command that changes them: from
# the CoS pane alone it makes files above two thread panes and starts fb and two different threads; a
# second run changes nothing; panes whose restore failed are closed and made again; restored shells
# get fb and the thread their label names; thread panes after the first two are closed; a pane running another program or an unlabelled pane is
# left alone; the threads open once the screen takes the size a client attaching gives it; and it
# does nothing outside herdr or outside the workspace labelled cos. The panes: map in
# rules/karo.yaml changes the workspace, the files pane's command and the number of thread panes,
# and COS_WORKSPACE_LABEL wins over its workspace. The real thread-show beside it opens the threads.
# settings-test checks that the settings run it.
# usage: right-pane-test [<right-pane>]   (default: the one beside this script; its files go to a
#        temporary directory that is removed)
set -uo pipefail
exec </dev/null
bin=$(cd "$(dirname "$0")" && pwd)
rc=${1:-$bin/right-pane}
tmp=$(mktemp -d "${TMPDIR:-/tmp}/right-pane-test.XXXXXX") || exit 2
tmp=$(cd "$tmp" && pwd -P)
trap 'rm -rf "$tmp"' EXIT
failed=0
fail() { printf 'FAIL\t%s\n' "$1"; failed=$((failed+1)); }
pass() { printf 'ok\t%s\n' "$1"; }

mkdir -p "$tmp/fake" "$tmp/cos/threads"
cat > "$tmp/fake/herdr" <<'EOF'
#!/bin/sh
st=$FAKE_STATE
save() { jq "$@" "$st" > "$st.new" && mv "$st.new" "$st"; }
log() { printf '%s\n' "$*" >> "$FAKE_LOG"; }
has() { jq -e --arg id "$1" 'any(.panes[]; .pane_id == $id)' "$st" >/dev/null; }
case "$1 $2" in
  "workspace get") jq -c '{result: {workspace: {workspace_id: "w1", label: .label}}}' "$st" ;;
  "pane list") jq -c '{result: {panes: [.panes[] | del(.fg)]}}' "$st" ;;
  "pane get") jq -ce --arg id "$3" '{result: {pane: (.panes[] | select(.pane_id == $id) | del(.fg))}}' "$st" ;;
  "pane layout")
    # .area is a scripted run of screen widths, one per call (the last one repeats); .seen keeps
    # the last one answered. Without .area herdr cannot give the layout.
    jq -e '.area != null' "$st" >/dev/null || exit 1
    save '.seen = .area[0] | if (.area | length) > 1 then .area |= .[1:] else . end'
    jq -c '{result: {layout: {area: {width: .seen, height: 40, x: 0, y: 0}}}}' "$st" ;;
  "pane process-info")
    jq -ce --arg id "$4" '.panes[] | select(.pane_id == $id and .fg != null)
      | {result: {process_info: {foreground_processes: [{name: .fg}]}}}' "$st" ||
      { echo '{"error":{"code":"pane_not_found"}}' >&2; exit 1; } ;;
  "pane close")
    has "$3" || exit 1
    log close "$3"
    save --arg id "$3" '.panes |= map(select(.pane_id != $id))' ;;
  "pane split")
    # split --pane <id> --direction <d> --ratio <r> --cwd <path> --no-focus
    has "$4" || exit 1
    n=$(jq '.next' "$st")
    log split "$4" "$6" "$8" "${10}"
    save --arg id "w1:p$n" --arg cwd "${10}" '.panes += [{pane_id: $id, cwd: $cwd, fg: "zsh"}] | .next += 1'
    printf '{"result":{"pane":{"pane_id":"w1:p%s"}}}\n' "$n" ;;
  "pane rename")
    log rename "$3" "$4"
    save --arg id "$3" --arg l "$4" '(.panes[] | select(.pane_id == $id)).label = $l' ;;
  "pane run")
    log run "$3" "$4"
    case "$4" in *glow*) log width "$3" "$(jq -r '.seen // "unknown"' "$st")" ;; esac
    case "$4" in fb\ *) fg=fzf ;; *glow*) fg=less ;; *) fg=other ;; esac
    save --arg id "$3" --arg fg "$fg" '(.panes[] | select(.pane_id == $id)).fg = $fg' ;;
  "pane send-keys")
    log send-keys "$3" "$4"
    save --arg id "$3" '(.panes[] | select(.pane_id == $id and (.fg == "less" or .fg == "glow"))).fg = "zsh"' ;;
  "agent focus") log focus "$3" ;;
  *) log unexpected "$*"; exit 1 ;;
esac
EOF
chmod +x "$tmp/fake/herdr"

threads=$tmp/cos/threads
thread() { printf -- '---\ntype: Thread\ndescription: 例の会話\ntopic: %s\n---\n\n### オーナー · 2026-01-01 09:00\n' "$2" > "$threads/$1.md"; touch -t "$3" "$threads/$1.md"; }
thread t-ex0001-old "古い話題" 202601010900
thread t-ex0002-mid "中の話題" 202601020900
thread t-ex0003-new "新しい話題" 202601030900
printf -- '---\ntype: Template\ndescription: 雛形\ntopic: テンプレート\n---\n' > "$threads/template.md"
printf -- '---\ntype: Memo\ndescription: メモ帳\ntopic: メモ\n---\n' > "$threads/memo.md"
touch -t 202601040900 "$threads/template.md" "$threads/memo.md"

export FAKE_STATE=$tmp/state.json FAKE_LOG=$tmp/log
env=(PATH="$tmp/fake:$PATH" HERDR_WORKSPACE_ID=w1 HERDR_PANE_ID=w1:p1 COS_DIR="$tmp/cos"
  COS_THREADS_DIR="$threads" COS_THREAD_STATE="$tmp/thread-last-pane" COS_THREAD_VIEW_DIR="$tmp/view")
# setup <jq expression for .panes after the CoS pane>: a workspace labelled cos.
setup() {
  jq -n "{label: \"cos\", next: 10, panes: ([{pane_id: \"w1:p1\", cwd: \"$tmp/cos\", fg: \"claude\"}] + $1)}" > "$FAKE_STATE"
  : > "$FAKE_LOG"
  rm -f "$tmp/thread-last-pane" "$tmp/cos/rules/karo.yaml"
}
go() { out=$(env "${env[@]}" "$@" "$rc" 2>&1); code=$?; }
logged() { rg -qxF -- "$1" "$FAKE_LOG"; }
count() { rg -c -- "$1" "$FAKE_LOG" || echo 0; }
pane() { jq -r --arg id "$1" ".panes[] | select(.pane_id == \$id) | $2" "$FAKE_STATE"; }
# column: the labels and foregrounds of the panes other than the CoS pane, in order.
column() { jq -c '[.panes[1:][] | [.label, .fg]]' "$FAKE_STATE"; }
check() { if "${@:2}"; then pass "$1"; else fail "$1: exit $code: $out: $(column): $(paste -sd '|' "$FAKE_LOG")"; fi; }

# From the CoS pane alone, the column is made in the default shape, with the two newest threads.
setup '[]'
go
want='[["files","fzf"],["thread - 新しい話題","less"],["thread - 中の話題","less"]]'
check "the column is made from the CoS pane alone" \
  test "$code:$(column)" = "0:$want"
check "the splits follow the default shape in ~/cos" eval '
  [[ $(rg "^split" "$FAKE_LOG" | paste -sd "|" -) == "split w1:p1 right 0.5 $tmp/cos|split w1:p10 down 0.5 $tmp/cos|split w1:p11 right 0.5 $tmp/cos" ]]'
check "fb is started on ~/cos and focus returns to cos" eval 'logged "run w1:p10 fb '"'$tmp/cos'"'" && [[ $(tail -n 1 "$FAKE_LOG") == "focus cos" ]]'

# A second run changes nothing.
: > "$FAKE_LOG"
go
check "a second run sends nothing and makes nothing" \
  eval '[[ $code -eq 0 && $(column) == "$want" ]] && ! rg -q "^(split|close|run|send-keys|rename)" "$FAKE_LOG"'

# After a restart: files' directory is gone, the thread panes are shells that keep their topics. A
# pane with fg null is one whose process herdr cannot read.
setup '[{pane_id: "w1:p8", label: "files", fg: "zsh", restore_error: "Saved directory is unavailable."},
  {pane_id: "w1:p3", label: "thread - 古い話題", fg: "zsh"}, {pane_id: "w1:p4", label: "thread", fg: "zsh"}]'
go
check "a files pane whose restore failed is closed and the column rebuilt" eval '
  logged "close w1:p8" && logged "close w1:p3" && logged "close w1:p4" &&
  [[ $(column) == "[[\"files\",\"fzf\"],[\"thread - 新しい話題\",\"less\"],[\"thread - 中の話題\",\"less\"]]" ]]'

setup '[{pane_id: "w1:p8", label: "files", fg: "zsh"},
  {pane_id: "w1:p3", label: "thread - 古い話題", fg: "zsh"}, {pane_id: "w1:p4", label: "thread"}]'
go
check "a thread pane whose process cannot be read is made again beside the other" eval '
  logged "close w1:p4" && logged "split w1:p3 right 0.5 $tmp/cos" && [[ $(count "^(split|close)") -eq 2 ]] &&
  [[ $(column) == "[[\"files\",\"fzf\"],[\"thread - 古い話題\",\"less\"],[\"thread - 新しい話題\",\"less\"]]" ]]'

# Restored shells: fb in files, the topic in its own pane, the newest other thread in the rest.
setup '[{pane_id: "w1:p8", label: "files", fg: "zsh"},
  {pane_id: "w1:p3", label: "thread", fg: "zsh"}, {pane_id: "w1:p4", label: "thread - 古い話題", fg: "-zsh"}]'
go
check "restored shells get fb and the thread their label names" eval '
  [[ $code -eq 0 && $(column) == "[[\"files\",\"fzf\"],[\"thread - 新しい話題\",\"less\"],[\"thread - 古い話題\",\"less\"]]" ]] &&
  ! rg -q "^(split|close)" "$FAKE_LOG"'

# A thread pane already showing a topic keeps it; the shell beside it takes another one.
setup '[{pane_id: "w1:p8", label: "files - tasks.md", fg: "less"},
  {pane_id: "w1:p3", label: "thread - 新しい話題", fg: "less"}, {pane_id: "w1:p4", label: "thread - 新しい話題", fg: "zsh"}]'
go
check "a pager is left alone and the shell beside it opens a topic not on screen" eval '
  [[ $(column) == "[[\"files - tasks.md\",\"less\"],[\"thread - 新しい話題\",\"less\"],[\"thread - 中の話題\",\"less\"]]" ]] &&
  ! rg -q "^(split|close|send-keys)" "$FAKE_LOG" && ! rg -q "^run w1:p(8|3) " "$FAKE_LOG"'

# Panes running another program get no keys; a broken pane without the labels is not touched.
setup '[{pane_id: "w1:p8", label: "files", fg: "vim"},
  {pane_id: "w1:p3", label: "thread", fg: "node"}, {pane_id: "w1:p4", label: "thread", fg: "zsh"},
  {pane_id: "w1:p5", label: "build", restore_error: "Saved directory is unavailable."}]'
go
check "panes running another program get no keys and other panes are untouched" eval '
  [[ $code -eq 0 ]] && ! rg -q "^(run|send-keys|rename) w1:p(8|3|5)( |$)" "$FAKE_LOG" && ! rg -q "^(split|close)" "$FAKE_LOG" &&
  logged "run w1:p4 PAGER='"'less -R +G'"' glow -p -w \$(( \$(tput cols) - 4 )) -- '"'$tmp/view/t-ex0003-new.md'"'"'

# Only two thread panes belong in the column; one after them is closed unless it runs another program.
setup '[{pane_id: "w1:p2", label: "files", fg: "fzf"}, {pane_id: "w1:p3", label: "thread - 古い話題", fg: "glow"},
  {pane_id: "w1:p5", label: "thread - 中の話題", fg: "glow"}, {pane_id: "w1:p4", label: "thread - 新しい話題", fg: "glow"}]'
go
check "a third thread pane is closed, leaving files and two threads" eval '
  [[ $code -eq 0 && $(column) == "[[\"files\",\"fzf\"],[\"thread - 古い話題\",\"glow\"],[\"thread - 中の話題\",\"glow\"]]" ]] &&
  [[ $(rg "^(split|close|run|send-keys)" "$FAKE_LOG" | paste -sd "|" -) == "close w1:p4" ]]'

setup '[{pane_id: "w1:p2", label: "files", fg: "fzf"}, {pane_id: "w1:p3", label: "thread - 古い話題", fg: "glow"},
  {pane_id: "w1:p5", label: "thread - 中の話題", fg: "glow"}, {pane_id: "w1:p4", label: "thread", fg: "claude"}]'
go
check "a third thread pane running another program is left open" eval '
  [[ $code -eq 0 ]] && ! rg -q "^(split|close|run|send-keys)" "$FAKE_LOG"'

setup '[{pane_id: "w1:p3", label: "thread", fg: "node"}]'
go
check "with files gone, a thread pane running another program keeps the column as it is" eval '
  [[ $code -eq 0 ]] && ! rg -q "^(split|close|run|send-keys)" "$FAKE_LOG"'

# Until a client attaches, herdr lays panes out on a default-size screen, and glow wraps a thread at
# the width it opens with; the threads open once the screen has its new size, or after the wait.
screen() { jq --argjson a "$1" '.area = $a' "$FAKE_STATE" > "$FAKE_STATE.new" && mv "$FAKE_STATE.new" "$FAKE_STATE"; }
widths() { rg "^width" "$FAKE_LOG" | paste -sd "|" -; }
setup '[]'
screen '[80, 80, 80, 394]'
go COS_SCREEN_WAIT=20
check "the threads open at the size the screen takes when a client attaches" eval '
  [[ $code -eq 0 && $(column) == "$want" && $(widths) == "width w1:p11 394|width w1:p12 394" ]]'

setup '[]'
screen '[80]'
go COS_SCREEN_WAIT=3
check "with no client attaching, the threads open after the wait" eval '
  [[ $code -eq 0 && $(column) == "$want" && $(widths) == "width w1:p11 80|width w1:p12 80" ]]'

# Outside herdr, or in another workspace, nothing is asked of herdr.
setup '[]'
go HERDR_WORKSPACE_ID= HERDR_PANE_ID=
check "outside herdr it does nothing and exits 0" eval '[[ $code -eq 0 && ! -s $FAKE_LOG ]]'
jq '.label = "t-ex0901"' "$FAKE_STATE" > "$FAKE_STATE.new" && mv "$FAKE_STATE.new" "$FAKE_STATE"
go
check "in a workspace not labelled cos it does nothing" eval '[[ $code -eq 0 && ! -s $FAKE_LOG ]]'

# The panes: map in rules/karo.yaml sets the column.
karo() { mkdir -p "$tmp/cos/rules" && printf '%s\n' "$@" > "$tmp/cos/rules/karo.yaml"; }
label() { jq --arg l "$1" '.label = $l' "$FAKE_STATE" > "$FAKE_STATE.new" && mv "$FAKE_STATE.new" "$FAKE_STATE"; }

setup '[]'
karo 'panes:' '  thread_panes: 3'
go
check "thread_panes: 3 makes a row of three thread panes with the three newest threads" eval '
  [[ $code -eq 0 && $(column) == "[[\"files\",\"fzf\"],[\"thread - 新しい話題\",\"less\"],[\"thread - 中の話題\",\"less\"],[\"thread - 古い話題\",\"less\"]]" ]] &&
  [[ $(rg "^split" "$FAKE_LOG" | paste -sd "|" -) == "split w1:p1 right 0.5 $tmp/cos|split w1:p10 down 0.5 $tmp/cos|split w1:p11 right 0.5 $tmp/cos|split w1:p12 right 0.5 $tmp/cos" ]]'

setup '[{pane_id: "w1:p2", label: "files", fg: "fzf"}, {pane_id: "w1:p3", label: "thread - 古い話題", fg: "glow"},
  {pane_id: "w1:p5", label: "thread - 中の話題", fg: "glow"}]'
karo 'panes:' '  thread_panes: 1'
go
check "thread_panes: 1 closes the second thread pane" eval '
  [[ $code -eq 0 && $(column) == "[[\"files\",\"fzf\"],[\"thread - 古い話題\",\"glow\"]]" ]] &&
  [[ $(rg "^(split|close|run|send-keys)" "$FAKE_LOG" | paste -sd "|" -) == "close w1:p5" ]]'

setup '[]'
karo 'panes:' '  files_command: yazi .' '  thread_panes: 0'
go
check "the files pane runs files_command, and thread_panes: 0 makes no thread pane" eval '
  [[ $code -eq 0 && $(column) == "[[\"files\",\"other\"]]" ]] && logged "run w1:p10 yazi ."'

setup '[]'
karo 'panes:' '  thread_panes: two'
go
check "a thread_panes that is not a number changes nothing" eval '
  [[ $code -eq 0 && $out == *"not a number: two"* && ! -s $FAKE_LOG ]]'

setup '[]'
label desk
karo 'panes:' '  workspace: desk'
go
check "workspace names the workspace it acts in" eval '[[ $code -eq 0 && $(column) == "$want" ]]'

setup '[]'
karo 'panes:' '  workspace: desk'
go
check "with workspace: desk it does nothing in the workspace labelled cos" eval '[[ $code -eq 0 && ! -s $FAKE_LOG ]]'
go COS_WORKSPACE_LABEL=cos
check "COS_WORKSPACE_LABEL wins over workspace" eval '[[ $code -eq 0 && $(column) == "$want" ]]'

if [[ $failed -gt 0 ]]; then echo "$failed failed"; exit 1; fi
echo "all passed"
