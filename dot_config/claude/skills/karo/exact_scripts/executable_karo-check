#!/usr/bin/env bash
# Check the frontmatter of the karo records: each .md in a record folder holds the keys date,
# description, tasks and projects, with date in YYYY-MM-DD and description not empty; each item of tasks
# has the form of a task ID and each item of projects names a project note or is 'all' (both may be the
# empty list []). A note without a frontmatter, or with one yq cannot read, has none of the four keys.
# It is the one implementation of the record checks, run at three depths:
#   after an edit   post-edit runs --only <the edited file> and stops on that file's problems alone
#   at a commit     commit runs --only <the staged paths>, removed ones included, on what the commit holds
#   whole           karo:setup, karo:checkout, and karo:land run it without --only
# An --only run vouches for the given paths and the files whose checks read them, not for the rest of the
# record; its count line says "in the --only scope" so it is not read as a whole run's.
# A task ID is a prefix of a letter and letters or digits, then one or more hyphenated parts of letters or
# digits, a child with ".<n>" added (karo-a2v.1, t-a1b2c3d4, ABC-12). Tasks live in the task database,
# which karo-check does not read, so only the form is checked.
# usage: karo-check [--only <path>]... [<karo dir>]
# Default: KARO_HOME, or ~/karo when unset; only its record folders, listed in record-folders beside this
# script, get the frontmatter checks, and the originals imozuru keeps (investigation/<topic>/sources/ and
# investigation/<topic>/log.md) are left out.
# --only limits the check to the given paths from the karo dir (changed, added, or removed files; for a
# rename, both paths) and, for a removed project file, the notes listing it as a project. A file brought
# in is checked in full.
# Prints "<path><TAB><problem>" per problem and exits 1 when any is found, or exits 2 when the karo dir
# cannot be entered or yq, fd, or rg cannot run ("karo-check: cannot run <tool>").
set -uo pipefail
# Where aqua installs yq, rg, and fd, each call goes through aqua's proxy, which adds a start-up cost, and a
# whole run makes hundreds of calls. Call the binaries that aqua which names instead, through functions: a
# binary's file name may differ from the command's (yq_darwin_arm64), so adding its folder to PATH would
# not do.
if command -v aqua >/dev/null; then
  yq_bin=$(aqua which yq 2>/dev/null) && [[ -x $yq_bin ]] && yq() { "$yq_bin" "$@"; }
  rg_bin=$(aqua which rg 2>/dev/null) && [[ -x $rg_bin ]] && rg() { "$rg_bin" "$@"; }
  fd_bin=$(aqua which fd 2>/dev/null) && [[ -x $fd_bin ]] && fd() { "$fd_bin" "$@"; }
fi
for tool in yq fd rg; do
  "$tool" --version >/dev/null 2>&1 || { echo "karo-check: cannot run $tool" >&2; exit 2; }
done
only=()
while [[ ${1:-} == --only ]]; do only+=("${2#./}"); shift 2; done
vault=${1:-${KARO_HOME:-$HOME/karo}}
bin=$(cd "$(dirname "$0")" && pwd)
# The record folders, the one list commit takes its record paths from too
read -r -a folders < "$bin/record-folders"
cd "$vault" || exit 2
excl='^investigation/[^/]+/(log\.md$|sources/)'
problems=0
report() { printf '%s\t%s\n' "$1" "$2"; problems=$((problems+1)); }

# Frontmatter values are split on these two control characters, which yq replaces in every value it
# prints; values never reach arithmetic, word splitting, or globbing.
FS=$'\x1f' LS=$'\x1e'
export FS LS
existing=()
for d in "${folders[@]}"; do [[ -d $d ]] && existing+=("$d"); done
# The project vocabulary: the path names of the project notes, <vcs>/<org>/<repo> for
# project/repo/<vcs>/<org>/<repo>.md and <theme> for project/misc/<theme>.md. fd skips a missing
# folder and says so on stderr, which is dropped.
vocab=" $({ fd --exact-depth 3 -t f -e md . project/repo
            fd -d 1 -t f -e md . project/misc
          } 2>/dev/null | sed -E 's#^project/(repo|misc)/##; s#\.md$##' | sort -u | tr '\n' ' ')"

# With --only, $scope holds the files to check, one per line between newlines.
scoped=0; scope=$'\n'
add_scope() { local f; while IFS= read -r f; do scope+="${f#./}"$'\n'; done; }
in_scope() { (( ! scoped )) || [[ $scope == *$'\n'"${1#./}"$'\n'* ]]; }
if (( ${#only[@]} )); then
  scoped=1
  listed=()
  for p in "${only[@]}"; do
    scope+="$p"$'\n'
    [[ -e $p ]] && continue
    n=${p#project/*/}; n=${n%.md}
    [[ $p =~ ^project/(repo/[^/]+/[^/]+/[^/]+|misc/[^/]+)\.md$ ]] && listed+=(-e "  - $n")
  done
  # for a removed project file, notes listing it as a project; add_scope reads a process substitution,
  # not a pipe, so that it runs in this shell and keeps $scope
  (( ${#listed[@]} )) && add_scope < <(rg -l -F -x "${listed[@]}" ${existing[@]+"${existing[@]}"} 2>/dev/null)
fi

# Per note, one yq call prints the frontmatter problems, then one "@info" line with the projects
# ($LS between items; control characters in values become spaces). yq emits a string literal even after
# a failing select, so each check is an if/else-null.
expr='
  . as $d
  | ([
      (["date", "description", "tasks", "projects"][] as $k | (if ($d | has($k)) | not then "missing " + $k else null end)),
      (if ($d | has("date")) and (($d.date // "" | tostring | test("^\d{4}-\d{2}-\d{2}$")) | not) then "date is not YYYY-MM-DD" else null end),
      (if ($d | has("description")) and (($d.description // "" | tostring) == "") then "empty description" else null end),
      (($d.tasks // [])[] | (if (tostring | test("^[A-Za-z][A-Za-z0-9]*(-[A-Za-z0-9]+)+(\.[0-9]+)*$")) | not then "bad task id: " + tostring else null end))
    ] | map(select(. != null)) | .[] | sub("[[:cntrl:]]"; " ")),
    ("@info" + strenv(FS) + ((.projects // []) | map(tostring | sub("[[:cntrl:]]"; " ")) | join(strenv(LS))))'
missing_all() { local k; for k in date description tasks projects; do report "$1" "missing $k"; done; }
while IFS= read -r f; do
  first=; IFS= read -r first < "$f"
  [[ $first == --- ]] || { missing_all "$f"; continue; }
  out=$(yq --front-matter=extract "$expr" "$f" 2>/dev/null) || { missing_all "$f"; continue; }
  # Process substitution, not a here-string: a here-string needs a temporary file, and when the
  # sandbox refuses it the loop is skipped silently and the problems go uncounted.
  info=
  while IFS= read -r p; do
    [[ -z $p ]] && continue
    if [[ $p == "@info$FS"* ]]; then info=${p#"@info$FS"}; else report "$f" "$p"; fi
  done < <(printf '%s\n' "$out")
  # each item of projects comes from the project vocabulary or is 'all'
  IFS=$LS read -r -a ps < <(printf '%s\n' "$info")
  for p in ${ps[@]+"${ps[@]}"}; do
    [[ $p == all || $vocab == *" $p "* ]] || report "$f" "unknown project: $p"
  done
done < <(fd -t f -e md . ${existing[@]+"${existing[@]}"} | rg -v "$excl" | sort | while IFS= read -r f; do in_scope "$f" && printf '%s\n' "$f"; done)

in=; (( scoped )) && in=" in the --only scope"
echo "karo-check: $problems problem(s)$in" >&2
[[ $problems -eq 0 ]]
