#!/usr/bin/env bash
# Show that lib/karo-env is the one place that sets the defaults of karo's folders: sourced by /bin/sh and
# by bash, it gives the defaults under HOME, follows XDG_*, keeps KARO_* and HERDR_AGENT_STATE_HOME that
# are set, and karo_config prints a config.yaml value or, with the file or the key missing, the given
# value (in the caller's environment, since yq may need HOME to run); and no script outside lib/ nor
# hooks.json spells a default out itself, except land, agent-ctl, agent-report and karo-setup, which do
# not read lib/karo-env.
# usage: karo-env-test   (writes only a temporary directory, which it removes)
set -uo pipefail
exec </dev/null
plugin=$(cd "$(dirname "$0")/.." && pwd)
lib=$plugin/lib/karo-env
tmp=$(mktemp -d "${TMPDIR:-/tmp}/karo-env-test.XXXXXX") || exit 2
trap 'rm -rf "$tmp"' EXIT
failed=0
fail() { printf 'FAIL\t%s\n' "$1"; failed=$((failed+1)); }
pass() { printf 'ok\t%s\n' "$1"; }

# values <shell> [<name>=<value>...]: the five folders, one per line, after the shell sources lib/karo-env
# in an environment of only HOME=/h, PATH and the given variables.
values() {
  local sh=$1; shift
  env -i HOME=/h PATH="$PATH" "$@" "$sh" -c '. "$1" && printf "%s\n" "$KARO_HOME" "$KARO_STATE_HOME" \
    "$KARO_DATA_HOME" "$KARO_CONFIG_HOME" "$HERDR_AGENT_STATE_HOME"' sh "$lib"
}
# check <name> <want> <got>
check() { if [[ $3 == "$2" ]]; then pass "$1"; else fail "$1: got $(printf '%s' "$3" | tr '\n' ' ')"; fi; }

mkdir -p "$tmp/config" "$tmp/empty"
printf 'uncounted:\n  - "^a"\n' > "$tmp/config/config.yaml"
for sh in /bin/sh bash; do
  check "$sh: the defaults are under HOME" $'/h/karo\n/h/.local/state/karo\n/h/.local/share/karo\n/h/.config/karo\n/h/.local/state/herdr-agent' \
    "$(values "$sh")"
  check "$sh: empty values take the defaults" $'/h/karo\n/h/.local/state/karo\n/h/.local/share/karo\n/h/.config/karo\n/h/.local/state/herdr-agent' \
    "$(values "$sh" KARO_HOME= KARO_STATE_HOME= KARO_DATA_HOME= KARO_CONFIG_HOME= HERDR_AGENT_STATE_HOME= XDG_STATE_HOME=)"
  check "$sh: the defaults follow XDG_*" $'/h/karo\n/s/karo\n/d/karo\n/c/karo\n/s/herdr-agent' \
    "$(values "$sh" XDG_STATE_HOME=/s XDG_DATA_HOME=/d XDG_CONFIG_HOME=/c)"
  check "$sh: values that are set are kept" $'/k\n/ks\n/kd\n/kc\n/ha' \
    "$(values "$sh" KARO_HOME=/k KARO_STATE_HOME=/ks KARO_DATA_HOME=/kd KARO_CONFIG_HOME=/kc HERDR_AGENT_STATE_HOME=/ha XDG_STATE_HOME=/s XDG_DATA_HOME=/d XDG_CONFIG_HOME=/c)"
  config() { env KARO_CONFIG_HOME="$1" "$sh" -c '. "$1" && karo_config "$2" "$3"' sh "$lib" "$2" '[]'; }
  check "$sh: karo_config prints the value as JSON" '["^a"]' "$(config "$tmp/config" .uncounted)"
  check "$sh: karo_config gives the value for a missing key" '[]' "$(config "$tmp/config" .other)"
  check "$sh: karo_config gives the value for a missing file" '[]' "$(config "$tmp/empty" .uncounted)"
done

left=$(cd "$plugin" && rg -n '\$HOME/(karo|\.local/state)' scripts skills/*/scripts hooks/hooks.json \
  -g '!skills/land/scripts/land' -g '!skills/herdr-agent/scripts/agent-ctl' \
  -g '!skills/herdr-agent/scripts/agent-report' -g '!scripts/karo-setup')
check "no script outside lib/ nor hooks.json spells out a default under HOME" "" "$left"

echo "karo-env-test: $failed failure(s)"
[[ $failed -eq 0 ]]
