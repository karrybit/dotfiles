#!/bin/sh
# Lists the threads (files of type Thread under the threads directory) as TSV, newest last message
# first: the file name, the latest date and time that ends a message heading ("### <speaker> ·
# YYYY-MM-DD HH:MM"), the frontmatter's topic, its tasks (comma-separated, empty for a thread of
# discussion only), and the counts of "- 決定:" and "- 未決:" lines. The first line names the
# columns. One awk pass reads every file, so the list costs about as much as one rg over the folder.
# Read only.
#   --since <n>d   only threads whose last message is on or after the day n days ago
#   --limit <n>    only the first n threads
#   --task <ID>    only threads whose tasks hold the ID
# Environment: COS_THREADS_DIR (default ~/cos/threads).
set -eu

usage() {
  echo "usage: thread-index [--since <n>d] [--limit <n>] [--task <ID>]" >&2
  exit 2
}
since='' limit='' task=''
while [ $# -gt 0 ]; do
  [ $# -ge 2 ] || usage
  case "$1=$2" in
    --since=*[!0-9]*d | --since=d) usage ;;
    --since=*d) since=${2%d} ;;
    --limit=*[!0-9]* | --limit=) usage ;;
    --limit=*) limit=$2 ;;
    --task=?*) task=$2 ;;
    *) usage ;;
  esac
  shift 2
done
from=
if [ -n "$since" ]; then
  from=$(date -v-"$since"d +%Y-%m-%d 2>/dev/null || date -d "$since days ago" +%Y-%m-%d)
fi

cd "${COS_THREADS_DIR:-$HOME/cos/threads}"
printf 'file\tlast\ttopic\ttasks\tdecided\topen\n'
set -- *.md
[ -e "$1" ] || exit 0
awk -v from="$from" -v task="$task" '
  function unquote(s) {
    if (s ~ /^".*"$/ || s ~ /^\047.*\047$/) s = substr(s, 2, length(s) - 2)
    return s
  }
  function flush() {
    if (file == "" || type != "Thread" || (from != "" && last < from)) return
    if (task != "" && index("," tasks ",", "," task ",") == 0) return
    print file "\t" last "\t" topic "\t" tasks "\t" decided "\t" open
  }
  FNR == 1 {
    flush()
    file = FILENAME; type = topic = tasks = last = ""; decided = open = 0
    fm = ($0 == "---"); intasks = 0
    next
  }
  fm && $0 == "---" { fm = 0; next }
  fm {
    if (intasks && /^ *- /) { v = $0; sub(/^ *- */, "", v); tasks = tasks (tasks == "" ? "" : ",") unquote(v); next }
    intasks = 0
    if (/^type: /) type = unquote(substr($0, 7))
    else if (/^topic: /) topic = unquote(substr($0, 8))
    else if (/^tasks:/) {
      v = substr($0, 7); gsub(/[][ ]/, "", v)
      if (v == "") intasks = 1; else tasks = v
    }
    next
  }
  /^### .*[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9] [0-9][0-9]:[0-9][0-9]$/ {
    t = substr($0, length($0) - 15)
    if (t > last) last = t
    next
  }
  /^- 決定:/ { decided++ }
  /^- 未決:/ { open++ }
  END { flush() }
' "$@" | sort -t "$(printf '\t')" -k2,2r -k1,1 | {
  if [ -n "$limit" ]; then head -n "$limit"; else cat; fi
}
