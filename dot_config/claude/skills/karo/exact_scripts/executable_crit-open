#!/bin/sh
# Shows the crit review at http://localhost:<port> in terminal-browser. When a
# terminal-browser tab already shows that URL, it reloads that tab and prints
# "crit-open: reloaded <url>"; each crit review has its own port, so the URL
# tells the reviews apart. Otherwise, when a tab shows a crit review on another
# port where crit no longer answers, as after a review is reopened on a new
# port, it points that tab at the URL and prints
# "crit-open: opened <url> in the tab that showed <old url>". Otherwise it
# opens the URL in a Herdr pane named "view - crit" beside the caller's,
# through tb-view beside this script, and prints what tb-view prints.
# --no-merge always opens a new pane instead of reusing a tab or adding one to
# an existing pane. terminal-browser does not start
# inside the sandbox, and a "*" in a permission rule or a sandbox exclusion
# matches any run of words, so a rule on terminal-browser itself would also let
# it run page scripts, proxy through ssh, or upgrade itself outside the
# sandbox; this script takes only a port number and is the allowed form.
# usage: crit-open [--no-merge] <port>
set -eu

usage() {
  echo "usage: crit-open [--no-merge] <port>" >&2
  exit 2
}
merge=
if [ "${1:-}" = --no-merge ]; then merge=--no-merge; shift; fi
[ $# -eq 1 ] || usage
case "$1" in
  '' | *[!0123456789]*) usage ;;
esac
url=http://localhost:$1
export DO_NOT_TRACK=1 TERMINAL_BROWSER_NO_TELEMETRY=1
if [ -z "$merge" ]; then
  tabs=$(terminal-browser ls --all --json)
  tab=$(printf '%s' "$tabs" | jq -r --arg url "$url" '
    [.browsers[] | .key as $key | .tabs[] | select(.url == $url or (.url | startswith($url + "/")))
     | "\($key) \(.id)"] | first // empty')
  if [ -n "$tab" ]; then
    terminal-browser action --browser "${tab% *}" --tab "${tab#* }" -- reload >&2
    echo "crit-open: reloaded $url"
    exit 0
  fi
  # A crit tab is a page on http://localhost:<port> whose title is the one
  # crit sets: "Crit" or "Crit — <what it reviews>", after "● " when a round
  # finished while the tab was hidden. Prints "<browser> <tab> <origin>".
  crit_tabs=$(printf '%s' "$tabs" | jq -r '
    .browsers[] | .key as $key | .tabs[]
    | select((.url | test("^http://localhost:[0-9]+(/|$)")) and ((.title // "") | test("^(● )?Crit( — |$)")))
    | "\($key) \(.id) \(.url | capture("^(?<o>http://localhost:[0-9]+)").o)"')
  while read -r key id old; do
    [ -n "$key" ] || continue
    # A crit that still answers on the old port is another review's tab.
    curl -s -o /dev/null --max-time 2 "$old/" && continue
    terminal-browser action --browser "$key" --tab "$id" -- open "$url" >&2
    echo "crit-open: opened $url in the tab that showed $old"
    exit 0
  done <<EOF
$crit_tabs
EOF
fi
exec "$(dirname "$0")/tb-view" "view - crit" "$url" ${merge:+"$merge"}
