#!/usr/bin/env bash
# Show that view-open hands the tb-view beside it "view - <name>" (default
# "view - browser") and the path, with --no-merge when it comes first, for an existing .html or .svg
# under doc/ of KARO_HOME, an existing <store>/<lowercase UUID>/index.html in the store under
# KARO_DATA_HOME or, when it is unset or empty, under karo/ of XDG_DATA_HOME or, when that is unset or
# empty too, of HOME's .local/share, and an
# existing image or video anywhere, and refuses everything else: no argument or three, a relative
# path, a path with "..", an .html or .svg outside doc/ and the store's UUID folders, an extension
# off the list, a missing file, a folder, and a name with characters other than letters, digits,
# ".", "_", and "-", or starting with one of those three. A symlink, or a path through a symlinked
# folder, opens only when its real path passes too, against the real doc/ and store, so a link in
# doc/ or the store to an .html outside them, or an image name linked to an .html, is refused, and
# KARO_HOME may itself be a symlink. It runs with HOME, KARO_HOME,
# KARO_DATA_HOME, and XDG_DATA_HOME in a temporary directory that holds a copy of view-open beside
# a tb-view stub logging what it is given (tb-view-test covers tb-view). settings-test checks that the settings
# ask before each view-open and run it outside the sandbox.
# usage: view-open-test   (tests the view-open beside this script; its files go to a temporary
#        directory that is removed)
set -uo pipefail
exec </dev/null
bin=$(cd "$(dirname "$0")" && pwd)
tmp=$(mktemp -d "${TMPDIR:-/tmp}/view-open-test.XXXXXX") || exit 2
trap 'rm -rf "$tmp"' EXIT
# /bin/bash on macOS cannot make a here document while the current folder is one it may not write, even
# with TMPDIR writable, so the test runs from its temporary folder.
cd "$tmp" || exit 2
failed=0
fail() { printf 'FAIL\t%s\n' "$1"; failed=$((failed+1)); }
pass() { printf 'ok\t%s\n' "$1"; }

mkdir "$tmp/bin" && cp "$bin/view-open" "$tmp/bin/" && cp -R "$bin/../lib" "$tmp/" || exit 2
vo=$tmp/bin/view-open stub=$tmp/bin/tb-view
id=0f6c7d9e-3b1a-4c52-9e34-5a8d1b7c2e40
mkdir -p "$tmp/karo/doc/abc/1" "$tmp/media" "$tmp/folder.png" "$tmp/data/html/$id/sub" \
  "$tmp/data/html/.tmp.abc123" "$tmp/data/html/0F6C7D9E-3B1A-4C52-9E34-5A8D1B7C2E40" "$tmp/data/html/abc" \
  "$tmp/.local/share/karo/html/$id" "$tmp/xdg/karo/html/$id"
cat > "$stub" <<'EOF'
#!/bin/sh
(IFS='|'; printf '%s\n' "$*") >> "$FAKE_LOG"
EOF
chmod +x "$stub"
for f in karo/doc/abc/1/index.html karo/doc/diagram.svg karo/page.html media/page.html media/d.svg \
  media/a.png media/a.jpg media/a.jpeg media/a.webp media/a.gif media/a.mp4 media/a.webm media/a.pdf media/a.PNG \
  "data/html/$id/index.html" "data/html/$id/other.html" "data/html/$id/sub/index.html" \
  data/html/.tmp.abc123/index.html data/html/0F6C7D9E-3B1A-4C52-9E34-5A8D1B7C2E40/index.html \
  data/html/abc/index.html data/html/index.html ".local/share/karo/html/$id/index.html" \
  "xdg/karo/html/$id/index.html"; do
  : > "$tmp/$f"
done
id2=1a2b3c4d-5e6f-4a7b-8c9d-0e1f2a3b4c5d id3=2b3c4d5e-6f7a-4b8c-9d0e-1f2a3b4c5d6e
mkdir "$tmp/data/html/$id2" "$tmp/data/html/$id3"
ln -s ../../media/page.html "$tmp/karo/doc/out.html"
ln -s ../../media "$tmp/karo/doc/outdir"
ln -s abc/1/index.html "$tmp/karo/doc/in.html"
ln -s ../../../media/page.html "$tmp/data/html/$id3/index.html"
ln -s "../$id/index.html" "$tmp/data/html/$id2/index.html"
ln -s page.html "$tmp/media/page.png"
ln -s karo "$tmp/karo-link"

unset XDG_DATA_HOME
export FAKE_LOG=$tmp/log KARO_HOME=$tmp/karo KARO_DATA_HOME=$tmp/data
run() {
  : > "$FAKE_LOG"
  out=$(env HOME="$tmp" "$vo" "$@" 2>&1); code=$?
}
# opens <tb-view args joined by |> <view-open args>...
opens() {
  local want=$1
  shift
  run "$@"
  if [[ $code -eq 0 && $(cat "$FAKE_LOG") == "$want" ]]; then
    pass "opens ${*#"$tmp"/}"
  else
    fail "opens ${*#"$tmp"/}: exit $code: $out: $(paste -sd '/' "$FAKE_LOG")"
  fi
}
refused() {
  run "$@"
  if [[ $code -eq 2 && ! -s $FAKE_LOG ]]; then pass "refuses ${*#"$tmp"/}"
  else fail "refuses ${*#"$tmp"/}: exit $code: $out: $(paste -sd '/' "$FAKE_LOG")"; fi
}

for f in karo/doc/abc/1/index.html karo/doc/diagram.svg media/a.png media/a.jpg media/a.jpeg media/a.webp \
  media/a.gif media/a.mp4 media/a.webm; do
  opens "view - browser|$tmp/$f" "$tmp/$f"
done
opens "view - ${id:0:8}|$tmp/data/html/$id/index.html" "$tmp/data/html/$id/index.html" "${id:0:8}"
# With KARO_DATA_HOME empty or unset, the store is under karo/ of XDG_DATA_HOME, or of HOME's
# .local/share when XDG_DATA_HOME is empty or unset too.
KARO_DATA_HOME=
opens "view - browser|$tmp/.local/share/karo/html/$id/index.html" "$tmp/.local/share/karo/html/$id/index.html"
refused "$tmp/data/html/$id/index.html"
unset KARO_DATA_HOME
opens "view - browser|$tmp/.local/share/karo/html/$id/index.html" "$tmp/.local/share/karo/html/$id/index.html"
refused "$tmp/data/html/$id/index.html"
export XDG_DATA_HOME=
opens "view - browser|$tmp/.local/share/karo/html/$id/index.html" "$tmp/.local/share/karo/html/$id/index.html"
XDG_DATA_HOME=$tmp/xdg
opens "view - browser|$tmp/xdg/karo/html/$id/index.html" "$tmp/xdg/karo/html/$id/index.html"
refused "$tmp/.local/share/karo/html/$id/index.html"
# KARO_DATA_HOME, when set, wins over XDG_DATA_HOME.
export KARO_DATA_HOME=$tmp/data
refused "$tmp/xdg/karo/html/$id/index.html"
unset XDG_DATA_HOME
opens "view - diagram-1.v_2|$tmp/media/a.png" "$tmp/media/a.png" diagram-1.v_2
opens "view - browser|$tmp/media/a.png|--no-merge" --no-merge "$tmp/media/a.png"
opens "view - shot|$tmp/media/a.png|--no-merge" --no-merge "$tmp/media/a.png" shot
# A symlink passes when its real path passes too, and KARO_HOME may itself be a symlink.
opens "view - browser|$tmp/karo/doc/in.html" "$tmp/karo/doc/in.html"
opens "view - browser|$tmp/data/html/$id2/index.html" "$tmp/data/html/$id2/index.html"
KARO_HOME=$tmp/karo-link opens "view - browser|$tmp/karo-link/doc/diagram.svg" "$tmp/karo-link/doc/diagram.svg"

refused
refused --no-merge
refused "$tmp/media/a.png" shot extra
refused "$tmp/media/a.png" --no-merge
refused "$tmp/media/a.png" ""
refused "$tmp/media/a.png" "two words"
refused "$tmp/media/a.png" "名前"
refused "$tmp/media/a.png" "a/b"
refused "$tmp/media/a.png" "-x"
refused media/a.png
refused "$tmp/karo/doc/../page.html"
refused "$tmp/karo/doc/abc/../../page.html"
refused "$tmp/karo/page.html"
refused "$tmp/media/page.html"
refused "$tmp/media/d.svg"
refused "$tmp/.local/share/karo/html/$id/index.html"
refused "$tmp/data/html/$id/other.html"
refused "$tmp/data/html/$id/sub/index.html"
refused "$tmp/data/html/.tmp.abc123/index.html"
refused "$tmp/data/html/0F6C7D9E-3B1A-4C52-9E34-5A8D1B7C2E40/index.html"
refused "$tmp/data/html/abc/index.html"
refused "$tmp/data/html/index.html"
refused "$tmp/data/html/$id/../$id/index.html"
refused "$tmp/media/a.pdf"
refused "$tmp/media/a.PNG"
refused "$tmp/media/missing.png"
refused "$tmp/folder.png"
refused "file://$tmp/media/a.png"
refused "$tmp/karo/doc/out.html"
refused "$tmp/karo/doc/outdir/page.html"
refused "$tmp/data/html/$id3/index.html"
refused "$tmp/media/page.png"

echo "view-open-test: $failed failure(s)" >&2
[ "$failed" -eq 0 ]
