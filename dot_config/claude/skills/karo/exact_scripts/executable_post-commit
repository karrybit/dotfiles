#!/bin/sh
# PostToolUse hook for Bash, registered with "if": "Bash(<this folder>/commit *)". Hooks run outside the
# sandbox, so herdr and crit work here: runs thread-show on each thread file the last commit of the cos dir
# added or changed, and record --restart-crit when the commit added, removed, or renamed a file (crit lists only the
# files it started with). Both scripts sit beside this one. A failed step goes to Claude on stderr with
# exit 2; the commit stays.
# Environment: COS_DIR (default ~/cos).
cos=${COS_DIR:-$HOME/cos}
bin=$(dirname "$0")
# The sandbox can write the cos dir's .git, except its config and hooks, and this hook runs outside it, so
# git runs as record runs it: its git and common folders named, so a commondir or gitdir file in .git is
# refused rather than followed, and no hooks, fsmonitor, or automatic maintenance. The only repository
# config git then reads is .git/config.
g=$cos/.git
for f in commondir gitdir; do [ -e "$g/$f" ] || [ -L "$g/$f" ] && { echo "post-commit: $g/$f points to another repository" >&2; exit 2; }; done
[ -d "$g" ] && [ ! -L "$g" ] || { echo "post-commit: $g is not a folder" >&2; exit 2; }
changed=$(GIT_DIR=$g GIT_COMMON_DIR=$g GIT_WORK_TREE=$cos GIT_CONFIG_COUNT=4 \
  GIT_CONFIG_KEY_0=core.hooksPath GIT_CONFIG_VALUE_0=/dev/null GIT_CONFIG_KEY_1=core.fsmonitor GIT_CONFIG_VALUE_1=false \
  GIT_CONFIG_KEY_2=gc.auto GIT_CONFIG_VALUE_2=0 GIT_CONFIG_KEY_3=maintenance.auto GIT_CONFIG_VALUE_3=false \
  git diff-tree --no-commit-id --name-status -r --no-renames HEAD) || exit 0
rc=0
for t in $(printf '%s\n' "$changed" | awk -F '\t' '$1 != "D" && $2 ~ /^threads\/.*\.md$/ {print $2}'); do
  out=$("$bin/thread-show" "$cos/$t" 2>&1) || { echo "thread-show failed: $t: $out" >&2; rc=2; }
done
if printf '%s\n' "$changed" | grep -q '^[ADR]'; then "$bin/record" --restart-crit >&2 || rc=2; fi
exit $rc
