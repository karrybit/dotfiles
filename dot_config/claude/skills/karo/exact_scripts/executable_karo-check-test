#!/usr/bin/env bash
# Show that karo-check can tell a valid vault from a broken one: a small valid vault must pass, each
# broken note in a copy of it must be reported, and a copy of the real vault with one note broken must fail.
# The cases break what the CoS checks and the CoS schema decide, and how okf-lint's results are counted with
# them; okf-lint's own checks are tested by okf-lint-test beside okf-lint.
# usage: karo-check-test [<cos dir>]   (default ~/cos, read only: the small vault takes its
#        rules/frontmatter-schema.yaml, and the real vault is its copy; the copies go to a temporary
#        directory and are removed)
set -uo pipefail
vault=${1:-$HOME/cos}
bin=$(cd "$(dirname "$0")" && pwd)
tmp=$(mktemp -d "${TMPDIR:-/tmp}/karo-check-test.XXXXXX") || exit 2
trap 'rm -rf "$tmp"' EXIT
failed=0
fail() { printf 'FAIL\t%s\n' "$1"; failed=$((failed+1)); }
pass() { printf 'ok\t%s\n' "$1"; }

ok=$tmp/ok
mkdir -p "$ok"/{journal,projects/repos/github.com/acme/demo/reviews,threads,investigations,docs/a1b2c3d4/abc1234,rules}
cp "$vault/rules/frontmatter-schema.yaml" "$ok/rules/" || exit 2
printf -- '---\ntype: Journal\ndate: 2026-01-01\n---\n\n- 09:00 [decision] t-test0001: 例（thread 2026-01-01 09:00）\n' > "$ok/journal/2026-01-01.md"
printf -- '---\ntype: Project\ndescription: 例のプロジェクト。\nprojects:\n  - github.com/acme/demo\n---\n\n## demo\n' > "$ok/projects/repos/github.com/acme/demo.md"
# A project's reviews and Design Docs sit in the folder named after it.
printf -- '---\ntype: Review\ndate: 2026-01-01\ntasks:\n  - t-test0001\nprojects:\n  - github.com/acme/demo\n---\n\n## 結論\n\n承認\n' > "$ok/projects/repos/github.com/acme/demo/reviews/t-test0001-1.md"
printf -- '---\ntype: Design Doc\ndescription: 例の設計。\ndate: 2026-01-01\nprojects:\n  - github.com/acme/demo\nsources:\n  - https://example.invalid/design\n---\n\n## 例\n' > "$ok/projects/repos/github.com/acme/demo/2026-01-01-design-doc-example.md"
printf -- '---\ntype: Thread\ndescription: 例の会話\ntopic: 例\ndate: 2026-01-01\ntasks:\n  - t-test0001\nprojects:\n  - github.com/acme/demo\n---\n\n### オーナー · 2026-01-01 09:00\n\nt-test0001 の [demo](projects/repos/github.com/acme/demo.md)\n' > "$ok/threads/t-test0001-demo.md"
printf -- '---\ntype: Investigation\ndescription: 例の調べ物。\ndate: 2026-01-01\ntasks:\n  - t-test0001\nprojects:\n  - all\nderived_from:\n  - journal/2026-01-01.md#09:00\n  - threads/t-test0001-demo.md#2026-01-01 09:00\n---\n\n## 例\n' > "$ok/investigations/2026-01-01-example.md"
# A day's standup and a meeting's notes sit beside the day's journal.
printf -- '---\ntype: Standup\ndate: 2026-01-01\nderived_from:\n  - journal/2026-01-01.md\n---\n\n## Checkin（2026-01-01）\n\n- 例\n' > "$ok/journal/2026-01-01-standup.md"
printf -- '---\ntype: Meeting Notes\ndescription: 例の MTG。\ndate: 2026-01-01\nprojects:\n  - github.com/acme/demo\nsources:\n  - { id: notes, resource: https://example.invalid/notes, title: 例の議事録 }\n---\n\n## 例の MTG\n\n- 決定: 例\n' > "$ok/journal/2026-01-01-demo.md"
# An HTML explanation's index.html carries no frontmatter and is not checked.
printf -- '---\ntype: Explain\ndescription: 例の解説。\ntasks:\n  - t-test0001\nprojects:\n  - github.com/acme/demo\nresource: https://example.invalid/demo\nderived_from:\n  - threads/t-test0001-demo.md#2026-01-01 09:00\n---\n\n## 例\n' > "$ok/docs/a1b2c3d4/abc1234/index.md"
printf '<!doctype html>\n<title>例</title>\n' > "$ok/docs/a1b2c3d4/abc1234/index.html"

if out=$("$bin/karo-check" "$ok" 2>&1); then pass "valid vault passes"; else fail "valid vault fails: $out"; fi

# A day's journal line in any form passes.
copy=$tmp/case; rm -rf "$copy"; cp -R "$ok" "$copy"
printf -- '- 例の行\n' >> "$copy/journal/2026-01-01.md"
if out=$("$bin/karo-check" "$copy" 2>&1); then pass "a journal line in any form passes"; else fail "a journal line in any form: $out"; fi

# <name>|<expected problem>|<shell command run inside the copy>
cases=(
  'unknown project|unknown project: nope|sed -i.bak "s#  - github.com/acme/demo#  - nope#" threads/t-test0001-demo.md'
  'wiki link|wiki link, write a path link: \[\[demo\]\]|sed -i.bak "s#\[demo\](projects/repos/github.com/acme/demo.md)#[[demo]]#" threads/t-test0001-demo.md'
  'no frontmatter where no type lives|investigations/2026-01-01-demo/notes.md	no frontmatter|mkdir -p investigations/2026-01-01-demo && printf "## no frontmatter\\n" > investigations/2026-01-01-demo/notes.md'
  # The required fields and paths in the CoS schema, which okf-lint checks
  'misplaced standup|path does not match Standup|mv journal/2026-01-01-standup.md journal/2026-01-01-checkin.md'
  'thread name without a task ID or date|path does not match Thread|mv threads/t-test0001-demo.md threads/demo.md'
  'thread without topic|missing topic|sed -i.bak "/^topic:/d" threads/t-test0001-demo.md'
  'explanation without resource|missing resource|sed -i.bak "/^resource:/d" docs/a1b2c3d4/abc1234/index.md'
  'explanation outside a version folder|path does not match Explain|mv docs/a1b2c3d4/abc1234/index.md docs/a1b2c3d4/index.md'
  'explanation id not 8 lowercase letters and digits|path does not match Explain|mv docs/a1b2c3d4 docs/h000001'
)
for c in "${cases[@]}"; do
  name=${c%%|*}; rest=${c#*|}; want=${rest%%|*}; cmd=${rest#*|}
  copy=$tmp/case; rm -rf "$copy"; cp -R "$ok" "$copy"
  (cd "$copy" && eval "$cmd" && rm -f ./*.bak ./*/*.bak) || { fail "$name: could not break the copy"; continue; }
  out=$("$bin/karo-check" "$copy" 2>&1); code=$?
  if [[ $code -eq 1 ]] && printf '%s\n' "$out" | rg -q -- "$want"; then pass "$name"; else fail "$name: exit $code, want /$want/: $out"; fi
done

# okf-lint's problems are counted with the CoS checks' problems, once each, under karo-check's count line.
copy=$tmp/case; rm -rf "$copy"; cp -R "$ok" "$copy"
printf '## no frontmatter\n' > "$copy/journal/2026-01-02.md"
sed -i.bak 's#  - github.com/acme/demo#  - nope#' "$copy/threads/t-test0001-demo.md" && rm "$copy/threads/t-test0001-demo.md.bak"
out=$("$bin/karo-check" "$copy" 2>&1); code=$?
if [[ $code -eq 1 ]] && [[ $(printf '%s\n' "$out" | rg -c -- '	no frontmatter') == 1 ]] && printf '%s\n' "$out" | rg -qF $'threads/t-test0001-demo.md\tunknown project: nope' \
  && printf '%s\n' "$out" | rg -qxF 'karo-check: 2 problem(s)' && ! printf '%s\n' "$out" | rg -q '^okf-lint: '; then
  pass "okf-lint and CoS problems counted together"
else
  fail "okf-lint and CoS problems counted together: exit $code: $out"
fi

# Without okf-lint or a schema, or when okf-lint finds an argument or schema error, karo-check stops without a count.
out=$(HOME=$tmp/nohome "$bin/karo-check" "$ok" 2>&1); code=$?
if [[ $code -eq 2 && $out == "karo-check: okf-lint not found at "* && $out != *$'\n'* ]]; then pass "missing okf-lint stops"; else fail "missing okf-lint: exit $code: $out"; fi
copy=$tmp/case; rm -rf "$copy"; cp -R "$ok" "$copy"; rm "$copy/rules/frontmatter-schema.yaml"
out=$("$bin/karo-check" "$copy" 2>&1); code=$?
if [[ $code -eq 2 && $out == "karo-check: no schema at "* && $out != *$'\n'* ]]; then pass "missing schema stops"; else fail "missing schema: exit $code: $out"; fi
printf 'exclude: []\n' > "$copy/rules/frontmatter-schema.yaml"
out=$("$bin/karo-check" "$copy" 2>&1); code=$?
if [[ $code -eq 2 && $out == *"has no types map"* && $out != *"karo-check: "* ]]; then pass "okf-lint schema error stops"; else fail "okf-lint schema error: exit $code: $out"; fi

# Frontmatter values are data: a value holding "|", a newline, a glob, or shell syntax is reported as the
# problems it is and nothing more, and no command in it runs.
# hostile <name> <expected problem count> <expected problem (fixed string)> <line in investigations/2026-01-01-example.md> <replacement> [<--only path>]
hostile() {
  local name=$1 n=$2 want=$3 old=$4 new=$5 c out code args=()
  copy=$tmp/case; rm -rf "$copy"; cp -R "$ok" "$copy"
  c=$(<"$copy/investigations/2026-01-01-example.md")
  [[ $c == *"$old"* ]] || { fail "$name: could not break the copy"; return; }
  printf '%s%s%s\n' "${c%%"$old"*}" "$new" "${c#*"$old"}" > "$copy/investigations/2026-01-01-example.md"
  [[ -n ${6:-} ]] && args=(--only "$6")
  out=$("$bin/karo-check" ${args[@]+"${args[@]}"} "$copy" 2>&1); code=$?
  if [[ -e $copy/pwned ]]; then fail "$name: a command in a value ran"
  elif [[ $code -eq 1 ]] && printf '%s\n' "$out" | rg -qF -- "$want" && printf '%s\n' "$out" | rg -qxF "karo-check: $n problem(s)"; then pass "$name"
  else fail "$name: exit $code, want $n problem(s) with '$want': $out"; fi
}
hostile 'status with a newline and a forged @info' 2 'unknown project: nope' '  - all' $'  - nope\nstatus: "x\\n@info|Bogus"'
hostile 'project that is a glob' 1 'unknown project: *' '  - all' '  - "*"'
hostile 'project with a command substitution' 1 'unknown project: $(touch pwned)' '  - all' '  - "$(touch pwned)"'
hostile 'project with "|"' 1 'unknown project: all|x' '  - all' '  - "all|x"'
hostile 'only: project with "|"' 1 'unknown project: all|x' '  - all' '  - "all|x"' investigations/2026-01-01-example.md

# --only: a problem in a given file or in a file that depends on it is found; one elsewhere is not.
# <name>|<expected problem, or "pass">|<--only paths, space-separated>|<shell command run inside the copy>
scoped=(
  'only: problem in a given file|unknown type: Bogus|projects/repos/github.com/acme/demo.md|sed -i.bak "s/^type: Project/type: Bogus/" projects/repos/github.com/acme/demo.md'
  'only: problem in another file is left out|pass|journal/2026-01-01.md|sed -i.bak "s#  - github.com/acme/demo#  - nope#" threads/t-test0001-demo.md'
  'only: okf-lint problem in another file is left out|pass|journal/2026-01-01.md|sed -i.bak "s/^type: Project/type: Bogus/" projects/repos/github.com/acme/demo.md'
  'only: renamed project still listed|threads/t-test0001-demo.md	unknown project: github.com/acme/demo|projects/repos/github.com/acme/demo.md projects/repos/github.com/acme/demo2.md|sed -i.bak "s#\[demo\](projects/repos/github.com/acme/demo.md)#demo#" threads/t-test0001-demo.md && mv projects/repos/github.com/acme/demo.md projects/repos/github.com/acme/demo2.md'
  'only: a journal line in any form passes|pass|journal/2026-01-01.md|sed -i.bak "s/t-test0001: /t-test0001・t-test0002:/" journal/2026-01-01.md'
  'only: wiki link in a given file|wiki link, write a path link: \[\[demo\]\]|threads/t-test0001-demo.md|sed -i.bak "s#\[demo\](projects/repos/github.com/acme/demo.md)#[[demo]]#" threads/t-test0001-demo.md'
)
for c in "${scoped[@]}"; do
  name=${c%%|*}; rest=${c#*|}; want=${rest%%|*}; rest=${rest#*|}; paths=${rest%%|*}; cmd=${rest#*|}
  copy=$tmp/case; rm -rf "$copy"; cp -R "$ok" "$copy"
  (cd "$copy" && eval "$cmd" && rm -f ./*.bak ./*/*.bak) || { fail "$name: could not break the copy"; continue; }
  args=(); for p in $paths; do args+=(--only "$p"); done
  out=$("$bin/karo-check" "${args[@]}" "$copy" 2>&1); code=$?
  if [[ $want == pass ]]; then
    if [[ $code -eq 0 ]]; then pass "$name"; else fail "$name: exit $code: $out"; fi
  elif [[ $code -eq 1 ]] && printf '%s\n' "$out" | rg -q -- "$want"; then pass "$name"; else fail "$name: exit $code, want /$want/: $out"; fi
done

# A given path that is a symbolic link is not read through: the wiki link check does not print a line
# of the file it points to.
cp -R "$ok" "$tmp/linked"
printf '[[secret]]\n' > "$tmp/outside.md"
ln -s "$tmp/outside.md" "$tmp/linked/docs/link.md"
out=$("$bin/karo-check" --only docs/link.md "$tmp/linked" 2>&1)
if printf '%s\n' "$out" | rg -qF '[[secret]]'; then fail "only: a symbolic link is read through: $out"; else pass "only: a symbolic link is not read through"; fi

# A task ID is a prefix of a letter and letters or digits, then one or more hyphenated parts of letters or
# digits, a child with ".<n>" added, whatever the prefix; an ID out of the form fails.
with_task() { # <task ID>: a copy whose thread lists the ID after t-test0001
  copy=$tmp/case; rm -rf "$copy"; cp -R "$ok" "$copy"
  c=$(<"$copy/threads/t-test0001-demo.md")
  printf '%s\n' "${c/  - t-test0001/  - t-test0001$'\n'  - $1}" > "$copy/threads/t-test0001-demo.md"
}
for id in cos-a2v cos-5q5.1 cos-5q5.1.12 t-test0002 bd-a2v my-proj-a2v ABCD-123; do
  with_task "$id"
  out=$("$bin/karo-check" "$copy" 2>&1); code=$?
  if [[ $code -eq 0 ]] && rg -qx -- "  - $id" "$copy/threads/t-test0001-demo.md"; then pass "task ID $id passes"; else fail "task ID $id: exit $code: $out"; fi
done
for id in t000999 cos- -a2v 1-a2v cos-a2v. cos-a2v.x cos_a2v; do
  with_task "$id"
  out=$("$bin/karo-check" "$copy" 2>&1); code=$?
  if [[ $code -eq 1 ]] && printf '%s\n' "$out" | rg -qxF -- "threads/t-test0001-demo.md	bad task id: $id"; then pass "$id is not a task ID"; else fail "bad ID $id: exit $code: $out"; fi
done

# In a git work tree, the task database, .beads, is ignored and nothing under it is tracked; a run with
# --only leaves git alone.
copy=$tmp/case; rm -rf "$copy"; cp -R "$ok" "$copy"
if ! (git -C "$copy" init -q && mkdir "$copy/.beads" && printf 'x\n' > "$copy/.beads/db"); then fail "could not make the git copy"; fi
out=$("$bin/karo-check" "$copy" 2>&1); code=$?
if [[ $code -eq 1 ]] && printf '%s\n' "$out" | rg -qxF $'.beads\ttask database not ignored by git'; then pass ".beads not ignored fails"; else fail ".beads not ignored: exit $code: $out"; fi
out=$("$bin/karo-check" --only projects/repos/github.com/acme/demo.md "$copy" 2>&1); code=$?
if [[ $code -eq 0 ]]; then pass "only: .beads is left alone"; else fail "only: .beads: exit $code: $out"; fi
printf '.beads/\n' >> "$copy/.git/info/exclude"
out=$("$bin/karo-check" "$copy" 2>&1); code=$?
if [[ $code -eq 0 ]]; then pass ".beads ignored passes"; else fail ".beads ignored: exit $code: $out"; fi
git -C "$copy" add -f .beads/db
out=$("$bin/karo-check" "$copy" 2>&1); code=$?
if [[ $code -eq 1 ]] && printf '%s\n' "$out" | rg -qxF $'.beads\ttask database tracked by git'; then pass ".beads tracked fails"; else fail ".beads tracked: exit $code: $out"; fi

# A copy of the real vault with one note's type broken must fail on that note and on nothing else.
# cp keeps the file names byte for byte; tar on macOS rewrites them to NFD, which breaks the link paths.
real=$tmp/real
count() { "$bin/karo-check" "$1" 2>&1 | rg -c -v '^karo-check: |	stale since '; }
if cp -R "$vault/." "$real" && rm -rf "$real/.git"; then
  before=$(count "$real")
  target=$(cd "$real" && fd -t f -e md . projects | sort | head -n 1)
  sed -i.bak 's/^type: Project$/type: Bogus/' "$real/$target" && rm -f "$real/$target.bak"
  out=$("$bin/karo-check" "$real" 2>&1); code=$?
  after=$(count "$real")
  if [[ $code -eq 1 && $after -eq $((before+1)) ]] && printf '%s\n' "$out" | rg -qF -- "$target	unknown type: Bogus"; then
    pass "broken copy of the real vault"
  else
    fail "broken copy of the real vault: exit $code, problems $before -> $after"
  fi
else
  fail "could not copy $vault"
fi

echo "karo-check-test: $failed failure(s)" >&2
[[ $failed -eq 0 ]]
