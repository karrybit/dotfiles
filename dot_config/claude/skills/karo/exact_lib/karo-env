# The one place that sets the defaults of karo's folders, sourced by the plugin's scripts and hook
# commands (`. "${0%/*}/../lib/karo-env"` from scripts/, `. "${0%/*}/../../../lib/karo-env"` from
# skills/<name>/scripts/, `. "${CLAUDE_PLUGIN_ROOT}/lib/karo-env"` from a hook command). A value set and
# not empty in the environment is kept. POSIX sh, so /bin/sh and bash scripts both read it.
: "${KARO_HOME:=$HOME/karo}"
: "${KARO_STATE_HOME:=${XDG_STATE_HOME:-$HOME/.local/state}/karo}"
: "${KARO_DATA_HOME:=${XDG_DATA_HOME:-$HOME/.local/share}/karo}"
: "${KARO_CONFIG_HOME:=${XDG_CONFIG_HOME:-$HOME/.config}/karo}"
: "${HERDR_AGENT_STATE_HOME:=${XDG_STATE_HOME:-$HOME/.local/state}/herdr-agent}"

# karo_config <yq expression> <JSON value>: prints the expression's value in $KARO_CONFIG_HOME/config.yaml
# as one line of JSON, or the given value when the file is missing or the expression gives null or false.
karo_config() {
  if [ -f "$KARO_CONFIG_HOME/config.yaml" ]; then
    yq -o=json -I=0 "($1) // $2" "$KARO_CONFIG_HOME/config.yaml"
  else
    printf '%s\n' "$2"
  fi
}
