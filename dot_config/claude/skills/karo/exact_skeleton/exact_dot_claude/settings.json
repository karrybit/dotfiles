{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "autoMemoryEnabled": false,
  "enabledPlugins": {
    "karo@skills-dir": true
  },
  "env": {
    "HERDR_AGENT_NAME_PATTERN": "^[a-z][a-z0-9]*(-[a-z0-9]+)+(\\.[0-9]+)*(-rv)?$",
    "HERDR_AGENT_BRANCH_PATTERN": "^(feat|fix|docs|refactor|perf|test|build|ci|chore|revert)/agent/[a-z0-9]+(-[a-z0-9]+)*$",
    "BD_DISABLE_METRICS": "1",
    "DO_NOT_TRACK": "1",
    "BEADS_ACTOR": "karo",
    "BD_NO_PUSH": "1"
  },
  "permissions": {
    "allow": [
      "Bash(herdr --skill)",
      "Bash(herdr status*)",
      "Bash(herdr integration status*)",
      "Bash(herdr session list*)",
      "Bash(herdr --version)",
      "Bash(herdr --help)",
      "Bash(herdr api snapshot*)",
      "Bash(~/.config/claude/skills/karo/scripts/commit *)",
      "Bash(~/.config/claude/skills/karo/scripts/karo-check)",
      "Bash(~/.config/claude/skills/karo/scripts/karo-check *)",
      "Bash(gh repo view *)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(bd ready*)",
      "Bash(bd list*)",
      "Bash(bd show *)",
      "Bash(bd search*)",
      "Bash(bd query*)",
      "Bash(bd blocked*)",
      "Bash(bd stale*)",
      "Bash(bd status*)",
      "Bash(bd where*)",
      "Bash(bd statuses*)",
      "Bash(bd types*)",
      "Bash(bd comments *)",
      "Bash(bd dep tree *)",
      "Bash(bd dep cycles*)",
      "Bash(bd human list*)",
      "Bash(bd human stats*)",
      "Bash(bd count*)",
      "Bash(bd backup status*)",
      "Bash(bd doctor --check*)",
      "Bash(bd version*)",
      "Bash(bd find-duplicates)",
      "Bash(bd prime*)",
      "Bash(bd history*)",
      "Bash(bd dep list*)",
      "Bash(bd create *)",
      "Bash(bd update *)",
      "Bash(bd close *)",
      "Bash(bd comment *)",
      "Bash(bd dep add *)",
      "Bash(bd dep remove *)",
      "Bash(bd label add *)",
      "Bash(bd label remove *)",
      "Bash(bd defer *)",
      "Bash(bd undefer *)",
      "Bash(bd unclaim *)",
      "Bash(bd reopen *)",
      "Bash(bd human respond *)",
      "Bash(bd human dismiss *)",
      "Bash(bd supersede *)",
      "Bash(bd backup sync*)",
      "Bash(cass search *)",
      "Bash(cass view *)",
      "Bash(cass status*)",
      "Bash(cass health*)",
      "Bash(cass robot-docs*)",
      "Bash(cass index --json)",
      "Bash(cass forget --older-than 90d --apply)",
      "Bash(bv --robot-*)",
      "Edit(~/.local/state/karo/state.md)",
      "Edit(/standup/**)",
      "Edit(/source/**)",
      "Edit(/investigation/**)",
      "Edit(/project/**)",
      "Edit(/doc/**)",
      "Edit(/decisions/**)",
      "Edit(~/.local/share/karo/html/**)",
      "Bash(~/.config/claude/skills/karo/scripts/karo-setup --check)"
    ],
    "ask": [
      "Edit(/AGENTS.md)",
      "Edit(/.claude/**)",
      "Edit(/rule/**)",
      "Edit(~/.config/claude/skills/**)",
      "Bash(dangerouslyDisableSandbox:true)",
      "Bash(herdr pane run *)",
      "Bash(herdr pane send-text *)",
      "Bash(herdr pane send-keys *)",
      "Bash(herdr agent send-keys *)",
      "Bash(herdr workspace close *)",
      "Bash(herdr tab close *)",
      "Bash(herdr pane close *)",
      "Bash(~/.config/claude/skills/karo/scripts/view-open *)",
      "Bash(herdr worktree remove *)",
      "Bash(herdr server *)",
      "Bash(herdr session stop*)",
      "Bash(herdr session delete*)",
      "Bash(herdr session attach*)",
      "Bash(herdr integration install*)",
      "Bash(herdr integration uninstall*)",
      "Bash(herdr update*)",
      "Bash(crit push*)",
      "Bash(crit pull*)",
      "Bash(crit pr *)",
      "Bash(crit mr *)",
      "Bash(crit --pr*)",
      "Bash(crit --mr*)",
      "Bash(crit live*)",
      "Bash(crit install*)",
      "Bash(crit *--allow-unauthenticated-network*)",
      "Bash(bd init*)",
      "Bash(bd config set*)",
      "Bash(bd backup restore*)",
      "Bash(bd backup init*)",
      "Bash(bd import *)",
      "Bash(bd export *)",
      "Bash(bd migrate*)",
      "Bash(bd hooks *)",
      "Bash(bd setup *)",
      "Bash(bd upgrade*)"
    ],
    "deny": [
      "Bash(crit share*)",
      "Bash(crit unpublish*)",
      "Bash(crit fetch*)",
      "Bash(crit auth*)",
      "Bash(git *--output*)",
      "Bash(git *--ext-diff*)",
      "Bash(git *--textconv*)",
      "Bash(bd admin *)",
      "Bash(bd purge*)",
      "Bash(bd prune*)",
      "Bash(bd compact*)",
      "Bash(bd flatten*)",
      "Bash(bd gc*)",
      "Bash(bd delete *)",
      "Bash(bd sql*)",
      "Bash(bd dolt *)",
      "Bash(bd federation *)",
      "Bash(bd github *)",
      "Bash(bd gitlab *)",
      "Bash(bd jira *)",
      "Bash(bd linear *)",
      "Bash(bd notion *)",
      "Bash(bd ado *)",
      "Bash(bd mail *)",
      "Bash(bd serve*)",
      "Bash(bd sync*)",
      "Bash(bd reclaim*)",
      "Bash(bd heartbeat*)",
      "Bash(bd remember*)",
      "Bash(bd forget*)",
      "Bash(bd metrics on*)",
      "Bash(bd find-duplicates *--method ai*)",
      "Bash(bd mol *)",
      "Bash(bd swarm *)",
      "Bash(bd gate *)",
      "Bash(bd formula *)",
      "Bash(bd cook *)",
      "Bash(bd merge-slot *)",
      "Bash(cass sources *)",
      "Bash(cass models *)",
      "Bash(cass schedule *)",
      "Bash(cass upgrade*)",
      "Bash(cass mirror *)",
      "Bash(bv --update*)",
      "Bash(bv --export-pages*)",
      "Edit(~/.herdr/worktrees/**)",
      "Edit(/.beads/**)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": false,
    "network": {
      "allowLocalBinding": true
    },
    "excludedCommands": [
      "herdr --skill",
      "herdr status*",
      "herdr session list*",
      "herdr api snapshot*"
    ],
    "filesystem": {
      "allowWrite": [
        "~/.crit",
        "~/.local/share/karo",
        "~/.local/share/cass"
      ],
      "denyWrite": [
        "~/.herdr/worktrees",
        "./AGENTS.md",
        "./.claude",
        "./rule",
        "~/.config/claude/skills"
      ]
    }
  }
}
