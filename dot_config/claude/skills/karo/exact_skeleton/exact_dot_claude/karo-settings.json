{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(herdr agent list*)",
      "Bash(herdr agent get *)",
      "Bash(herdr agent read *)",
      "Bash(herdr agent wait *)",
      "Bash(herdr agent explain *)",
      "Bash(herdr workspace list*)",
      "Bash(herdr workspace get *)",
      "Bash(herdr tab list*)",
      "Bash(herdr pane list*)",
      "Bash(herdr pane get *)",
      "Bash(herdr pane read *)",
      "Bash(herdr pane wait-output *)",
      "Bash(herdr pane layout*)",
      "Bash(herdr pane process-info *)",
      "Bash(herdr worktree list*)",
      "Bash(karo-land *)",
      "Bash(karo-crit-open *)",
      "Bash(karo-agent-ctl *)",
      "Bash(karo-agent-report *)",
      "Bash(karo-safe-key *)"
    ]
  },
  "sandbox": {
    "excludedCommands": [
      "bd *",
      "bv *",
      "karo-insights *",
      "herdr agent *",
      "herdr workspace *",
      "herdr worktree *",
      "herdr tab *",
      "herdr pane *",
      "karo-land *",
      "karo-crit-open *",
      "karo-view-open *",
      "karo-open-tasks",
      "karo-open-tasks *",
      "karo-agent-ctl *",
      "karo-agent-report *",
      "karo-safe-key *"
    ]
  }
}
