#!/bin/sh
# Usage: check-note NOTE
# Checks a meeting note against rule/note-rules.md and prints one line per
# problem, then `check-note: N problem(s)`. Exits 1 when there is a problem
# and 2 on a usage error.
if [ "$#" -ne 1 ]; then
  echo "usage: check-note NOTE" >&2
  exit 2
fi
if [ ! -f "$1" ]; then
  echo "$1: no such note"
  echo "check-note: 1 problem(s)"
  exit 1
fi
awk -v note="$1" '
  NR == 1 { if ($0 != "---") { print note ": line 1 is not ---"; n++ } ; fm = 1; next }
  fm && $0 == "---" { fm = 0; after = 1; next }
  fm && /^type: Meeting Notes$/ { type = 1 }
  fm && /^date: [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]$/ { date = 1 }
  fm && /^description: ./ { desc = 1 }
  fm && /^sources:/ { src = 1 }
  after && /^$/ { next }
  after { if ($0 !~ /^## /) { print note ": the body does not start with a ## heading"; n++ } ; after = 0 }
  /^## 決定/ { decided = 1 }
  /^## 宿題/ { todo = 1 }
  END {
    if (fm) { print note ": the frontmatter has no closing ---"; n++ }
    if (!type) { print note ": no type: Meeting Notes"; n++ }
    if (!date) { print note ": no date: YYYY-MM-DD"; n++ }
    if (!desc) { print note ": no description"; n++ }
    if (!src) { print note ": no sources"; n++ }
    if (!decided) { print note ": no ## 決定 heading"; n++ }
    if (!todo) { print note ": no ## 宿題 heading"; n++ }
    printf "check-note: %d problem(s)\n", n
    exit (n > 0)
  }
' "$1"
