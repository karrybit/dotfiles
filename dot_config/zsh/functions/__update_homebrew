if [[ "${OSTYPE}" != darwin* ]]; then
    return 0
fi

if ! command -v brew >/dev/null 2>&1; then
    printf "\033[33mbrew not found; skipping Homebrew update\033[0m\n" >&2
    return 0
fi

__lib_require_commands chezmoi git jq __lib_chezmoi_profile || return 1

# zsh ignores errexit, even inside a subshell, while a caller tests the status
# (`__update_homebrew || _failed=1` in __uppkg), so each step exits explicitly.
(
    local _profile
    local _brewfile
    local _token

    _profile=$(__lib_chezmoi_profile) || exit
    _brewfile="${XDG_CONFIG_HOME:-$HOME/.config}/homebrew/Brewfile.${_profile}"

    # Homebrew passes HOMEBREW_GITHUB_API_TOKEN to git source downloads as
    # GH_TOKEN, which lets formulae from private GitHub taps fetch their source.
    # Without gh or a login the value stays empty and Homebrew ignores it.
    _token=$(gh auth token 2>/dev/null) || _token=

    HOMEBREW_GITHUB_API_TOKEN="${_token}" brew upgrade || exit
    HOMEBREW_GITHUB_API_TOKEN="${_token}" brew autoremove || exit
    HOMEBREW_GITHUB_API_TOKEN="${_token}" brew cleanup || exit

    # --no-go --no-uv --no-cargo: go, uv, and cargo install their own tools; keep them out of the Brewfile
    HOMEBREW_GITHUB_API_TOKEN="${_token}" brew bundle dump -f --no-go --no-uv --no-cargo --file "${_brewfile}" || exit

    __lib_chezmoi_commit_file \
        "${_brewfile}" \
        "dot_config/homebrew/Brewfile.${_profile}" \
        "chore: update Brewfile"
)
