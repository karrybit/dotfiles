__lib_require_commands fzf bat glow || return 1
zmodload zsh/parameter
local root state
root=${${1:-.}:A}
[[ -d "$root" ]] || { __lib_echo_failure "not a directory: ${1}\n"; return 1; }
# fzf runs one process for the whole session and swaps the listing with
# reload, so the folder being shown lives in a file its child shells share.
state=$(mktemp) || return 1
print -r -- "$root" >| "$state"
{
    FB_ROOT=$root FB_STATE=$state FB_LS=${functions_source[__fb_ls]} \
    FB_LIST='d=$(<"$FB_STATE"); [[ $d != "$FB_ROOT" ]] && print ../
        cd -- "$d" && autoload -Uz -- "$FB_LS" && __fb_ls' \
    FB_GO='print -r -- "$n" >| "$FB_STATE"
        print -r -- "clear-query+reload-sync(eval \"\$FB_LIST\")+first+change-prompt:${n:t}/ > "' \
    FB_ENTER='d=$(<"$FB_STATE")
        if [[ -z $s ]]; then print abort
        elif [[ $s == ../ ]]; then n=${d:h}; eval "$FB_GO"
        elif [[ -d $d/${s%/} ]]; then n=$d/${s%/}; eval "$FB_GO"
        else print "execute(eval \"\$FB_OPEN\")"; fi' \
    FB_LEFT='d=$(<"$FB_STATE"); [[ $d == "$FB_ROOT" ]] || { n=${d:h}; eval "$FB_GO"; }' \
    FB_OPEN='t=$(<"$FB_STATE")/$FZF_CURRENT_ITEM
        # Restore only after a successful read, so a failed lookup never
        # clears a label the pane already had.
        if [[ -n $HERDR_PANE_ID ]] && (( $+commands[herdr] && $+commands[jq] )) &&
            l=$(herdr pane get "$HERDR_PANE_ID" 2>/dev/null |
                jq -er ".result.pane | select(.pane_id) | .label // \"\"" 2>/dev/null); then
            herdr pane rename "$HERDR_PANE_ID" "${l:+$l - }${t#${FB_ROOT%/}/}" >/dev/null 2>&1
        else unset l; fi
        case $t in
            *.md|*.markdown) glow -p -w $(( FZF_COLUMNS - 4 )) "$t" ;;
            *) bat --paging=always "$t" ;;
        esac
        if (( $+l )); then
            if [[ -n $l ]]; then herdr pane rename "$HERDR_PANE_ID" "$l"
            else herdr pane rename "$HERDR_PANE_ID" --clear; fi >/dev/null 2>&1
        fi' \
    fzf --with-shell='zsh -fc' --cycle --layout=reverse --prompt="${root:t}/ > " \
        --bind='start:reload(eval "$FB_LIST")' \
        --bind='enter,right:transform(s={}; eval "$FB_ENTER")' \
        --bind='left:transform(eval "$FB_LEFT")' \
        --preview-window='down,60%' \
        --preview='cd -- "$(<"$FB_STATE")" || exit
            if [ -d {} ]; then autoload -Uz -- "$FB_LS" && __fb_ls {}; else case {} in
            *.md|*.markdown) glow -s dark -w "$FZF_PREVIEW_COLUMNS" {} ;;
            *) bat --color=always --style=numbers --terminal-width="$FZF_PREVIEW_COLUMNS" {} ;;
            esac; fi'
} always {
    rm -f -- "$state"
}
return 0
