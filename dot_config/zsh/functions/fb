__lib_require_commands fzf bat glow || return 1
local root dir s target
root=${${1:-.}:A}
[[ -d "$root" ]] || { __lib_echo_failure "not a directory: ${1}\n"; return 1; }
dir=$root
while true; do
    s=$(cd -- "$dir" && {
        [[ "$dir" != "$root" ]] && print '../'
        command ls -p
    } | fzf --cycle --layout=reverse --prompt="${dir:t}/ > " \
        --bind=right:accept \
        --bind="left:$([[ "$dir" != "$root" ]] && print 'become(echo ../)' || print ignore)" \
        --preview-window='down,60%' \
        --preview='if [ -d {} ]; then ls -p {}; else case {} in
            *.md|*.markdown) glow -s dark -w "$FZF_PREVIEW_COLUMNS" {} ;;
            *) bat --color=always --style=numbers --terminal-width="$FZF_PREVIEW_COLUMNS" {} ;;
            esac; fi')
    [[ -z "$s" ]] && return 0
    if [[ "$s" == '../' ]]; then
        dir=${dir:h}
        continue
    fi
    target="${dir}/${s%/}"
    if [[ -d "$target" ]]; then
        dir=$target
    else
        case "$target" in
            *.md|*.markdown) glow -p -w $(( COLUMNS - 4 )) "$target" ;;
            *) bat --paging=always "$target" ;;
        esac
    fi
done
