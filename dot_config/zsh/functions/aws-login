__lib_require_commands aws fzf || return 1
local profile
profile=$(aws configure list-profiles | fzf -x --cycle --layout=reverse)
if (( $? )) || [[ -z "$profile" ]]; then
    __lib_echo_failure "canceled\n"
    return 1
fi
aws sso login --profile "$profile" || return 1
# Later aws commands in this shell use the profile just logged in to.
export AWS_PROFILE="$profile"
