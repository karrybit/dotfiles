if ! command -v aqua >/dev/null 2>&1; then
    printf "\033[33maqua not found; skipping aqua clean\033[0m\n" >&2
    return 0
fi

local _root="${AQUA_ROOT_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/aquaproj-aqua}"

# vacuum only removes packages with a recorded last-used time; --init records
# the ones that predate that bookkeeping. Expiry is AQUA_VACUUM_DAYS (default 60).
aqua vacuum --init
aqua vacuum

# Shims and registry versions are kept when the global config or any aqua.yaml
# under the ghq root still uses them. When the project configs cannot be
# listed, nothing below is removed.
local -a _globals
local -a _projects
local _projects_known=1
local _config

_globals=("${(@s.:.)AQUA_GLOBAL_CONFIG}")
_globals=("${(@)_globals:#}")

if command -v ghq >/dev/null 2>&1; then
    if command -v fd >/dev/null 2>&1; then
        _projects=("${(@f)$(fd -H -t f -g '*aqua.y*ml' -d 6 --exclude node_modules "$(ghq root)")}")
        _projects=("${(@)_projects:#}")
    else
        _projects_known=0
    fi
fi

# aqua install never removes the shim of a package dropped from a config.
if (( _projects_known && ${#_globals} > 0 )); then
    local _shim
    local _command
    local _used

    for _shim in "${_root}"/bin/*(N@); do
        [[ "$(readlink "${_shim}")" == "../aqua-proxy" ]] || continue
        _command=${_shim:t}
        [[ "${_command}" == aqua ]] && continue
        (cd "${_root}" && aqua which "${_command}") >/dev/null 2>&1 && continue

        _used=0
        for _config in "${_projects[@]}"; do
            if (cd "${_root}" && aqua -c "${_config}" which "${_command}") >/dev/null 2>&1; then
                _used=1
                break
            fi
        done

        if (( ! _used )); then
            printf "removing unused shim: %s\n" "${_command}"
            rm -f -- "${_shim}"
        fi
    done
fi

# Registry versions nothing pins any more are re-downloaded on demand.
local _registry_dir="${_root}/registries/github_content/github.com/aquaproj/aqua-registry"
if (( _projects_known )) && [[ -d "${_registry_dir}" ]] && command -v yq >/dev/null 2>&1; then
    local -a _keep
    local _dir

    for _config in "${_globals[@]}"; do
        [[ -f "${_config}" ]] && _keep+=("${(@f)$(yq -r '.registries[] | select(.type == "standard") | .ref' "${_config}")}")
    done
    if (( ${#_projects} > 0 )); then
        _keep+=("${(@f)$(yq -r '.registries[]? | select(.type == "standard") | .ref' "${_projects[@]}" 2>/dev/null)}")
    fi
    _keep=("${(@)_keep:#}")

    if (( ${#_keep} > 0 )); then
        for _dir in "${_registry_dir}"/*(N/); do
            (( ${_keep[(Ie)${_dir:t}]} )) || rm -rf -- "${_dir}"
        done
    fi
fi

rm -rf -- "${_root:?}/registry-cache"
