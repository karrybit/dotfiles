export AQUA_GLOBAL_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/aquaproj-aqua/{{ .profile }}/aqua.yaml"
{{- if stat (joinPath .chezmoi.sourceDir (printf "dot_config/aquaproj-aqua/literal_%s/aqua-policy.yaml" .profile)) }}
export AQUA_POLICY_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/aquaproj-aqua/{{ .profile }}/aqua-policy.yaml"
{{- else }}
# aqua fails on a policy path that does not exist, so drop one inherited from
# the parent environment.
unset AQUA_POLICY_CONFIG
{{- end }}
